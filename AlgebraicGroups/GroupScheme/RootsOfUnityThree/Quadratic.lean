module

public import Mathlib.Algebra.Polynomial.SpecificDegree
public import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
public import Mathlib.RingTheory.Polynomial.Cyclotomic.Roots
public import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed

/-!
# The quadratic factor of the third roots of unity

The factor `X² + X + 1` in Milne's *Algebraic Groups*, Example 1.6, is separable
whenever 3 is a unit. Over a field without a primitive cube root it is irreducible.
A chosen primitive cube root in any extension identifies its quotient with the
subalgebra generated by that root. The comparison uses `minpoly.equivAdjoin`;
its evaluation laws retain the chosen embedding, including in the separable closure.
-/

@[expose] public section

noncomputable section

open Polynomial

universe u v

namespace AlgebraicGeometry.RootsOfUnityThree

private theorem quadratic_monic {R : Type*} [CommRing R] :
    (X ^ 2 + X + 1 : R[X]).Monic := by
  simpa only [cyclotomic_three] using cyclotomic.monic 3 R

private theorem quadratic_natDegree {R : Type*} [CommRing R] [Nontrivial R] :
    (X ^ 2 + X + 1 : R[X]).natDegree = 2 := by
  rw [← cyclotomic_three, natDegree_cyclotomic]
  decide

/-- The quadratic factor of `X³ - 1` is separable over any commutative ring
in which 3 is a unit; in particular this includes characteristic two. -/
theorem quadratic_separable {R : Type*} [CommRing R] (h3 : IsUnit (3 : R)) :
    (X ^ 2 + X + 1 : R[X]).Separable := by
  have hs : (X ^ 3 - 1 : R[X]).Separable := by
    simpa using separable_X_pow_sub_C_unit (n := 3) (1 : Rˣ) h3
  exact hs.of_dvd (by
    simpa only [cyclotomic_three] using cyclotomic.dvd_X_pow_sub_one 3 R)

/-- Without a primitive cube root, the quadratic factor of `X³ - 1` is
irreducible over a field of characteristic different from three. -/
theorem quadratic_irreducible {k : Type u} [Field k] (h3 : (3 : k) ≠ 0)
    (hnosplit : ¬ ∃ a : k, IsPrimitiveRoot a 3) :
    Irreducible (X ^ 2 + X + 1 : k[X]) := by
  classical
  let _ : NeZero (3 : k) := ⟨h3⟩
  refine ((quadratic_monic (R := k)).irreducible_iff_roots_eq_zero_of_degree_le_three
    (by rw [quadratic_natDegree])
    (by rw [quadratic_natDegree]; decide)).2 ?_
  refine Multiset.eq_zero_iff_forall_notMem.mpr fun a ha ↦ ?_
  have haroot : (cyclotomic 3 k).IsRoot a := by
    rw [cyclotomic_three]
    exact (mem_roots (quadratic_monic (R := k)).ne_zero).mp ha
  exact hnosplit ⟨a, isRoot_cyclotomic_iff.mp haroot⟩

section PrimitiveRoot

variable {R : Type u} {L : Type v} [CommRing R] [CommRing L] [IsDomain L]
  [Algebra R L] {ζ : L}

/-- A primitive cube root annihilates the quadratic factor over the base ring. -/
theorem quadratic_aeval_eq_zero (hζ : IsPrimitiveRoot ζ 3) :
    aeval ζ (X ^ 2 + X + 1 : R[X]) = 0 := by
  simp only [map_add, map_pow, aeval_X, map_one]
  simpa [Finset.sum_range_succ, add_comm, add_left_comm, add_assoc] using
    hζ.geom_sum_eq_zero (by decide : 1 < 3)

/-- Evaluation of the quadratic quotient at a chosen primitive cube root. -/
def quadraticEval (ζ : L) (hζ : IsPrimitiveRoot ζ 3) :
    AdjoinRoot (X ^ 2 + X + 1 : R[X]) →ₐ[R] L :=
  AdjoinRoot.liftAlgHom _ (Algebra.ofId R L) ζ (quadratic_aeval_eq_zero hζ)

@[simp]
theorem quadraticEval_mk (hζ : IsPrimitiveRoot ζ 3) (p : R[X]) :
    quadraticEval ζ hζ (AdjoinRoot.mk (X ^ 2 + X + 1 : R[X]) p) = aeval ζ p :=
  rfl

@[simp]
theorem quadraticEval_root (hζ : IsPrimitiveRoot ζ 3) :
    quadraticEval (R := R) ζ hζ (AdjoinRoot.root (X ^ 2 + X + 1 : R[X])) = ζ := by
  exact AdjoinRoot.liftAlgHom_root _ _ _ _

@[simp]
theorem quadraticEval_algebraMap (hζ : IsPrimitiveRoot ζ 3) (a : R) :
    quadraticEval ζ hζ (AdjoinRoot.of (X ^ 2 + X + 1 : R[X]) a) =
      algebraMap R L a :=
  (quadraticEval ζ hζ).commutes a

end PrimitiveRoot

section ChosenRoot

variable {k : Type u} {L : Type v} [Field k] [CommRing L] [IsDomain L] [Algebra k L]
  (hnosplit : ¬ ∃ a : k, IsPrimitiveRoot a 3) {ζ : L}

include hnosplit in
/-- In the nonsplit case the minimal polynomial of a chosen primitive cube root
is the quadratic factor. Nonvanishing of 3 is derived from primitivity. -/
theorem quadratic_minpoly (hζ : IsPrimitiveRoot ζ 3) :
    minpoly k ζ = (X ^ 2 + X + 1 : k[X]) := by
  let _ : NeZero (3 : L) := hζ.neZero'
  have h3 : (3 : k) ≠ 0 := by
    intro h
    apply NeZero.ne (3 : L)
    simpa only [map_ofNat, map_zero] using congrArg (algebraMap k L) h
  let _ : NeZero (3 : k) := ⟨h3⟩
  simpa only [cyclotomic_three] using
    (hζ.minpoly_eq_cyclotomic_of_irreducible (K := k) (by
      simpa only [cyclotomic_three] using quadratic_irreducible h3 hnosplit)).symm

/-- The quadratic quotient is the subalgebra generated by the chosen
primitive cube root. The base and extension may inhabit independent universes. -/
noncomputable def quadraticAlgEquivAdjoin (ζ : L) (hζ : IsPrimitiveRoot ζ 3) :
    AdjoinRoot (X ^ 2 + X + 1 : k[X]) ≃ₐ[k] Algebra.adjoin k ({ζ} : Set L) :=
  (AdjoinRoot.algEquivOfEq k _ _ (quadratic_minpoly hnosplit hζ).symm).trans
    (minpoly.equivAdjoin
      ((hζ.isIntegral (by decide : 0 < 3)).tower_top : IsIntegral k ζ))

/-- The quotient root maps to the specified element of the generated subalgebra. -/
@[simp]
theorem quadraticAlgEquivAdjoin_root (hζ : IsPrimitiveRoot ζ 3) :
    quadraticAlgEquivAdjoin hnosplit ζ hζ (AdjoinRoot.root (X ^ 2 + X + 1 : k[X])) =
      ⟨ζ, Algebra.self_mem_adjoin_singleton k ζ⟩ := by
  simp only [quadraticAlgEquivAdjoin, AlgEquiv.trans_apply,
    AdjoinRoot.algEquivOfEq_root, minpoly.coe_equivAdjoin,
    AdjoinRoot.Minpoly.coe_toAdjoin, AdjoinRoot.liftAlgHom_root]

/-- Every polynomial quotient class maps to evaluation at the bundled chosen root. -/
@[simp]
theorem quadraticAlgEquivAdjoin_mk (hζ : IsPrimitiveRoot ζ 3) (p : k[X]) :
    quadraticAlgEquivAdjoin hnosplit ζ hζ
        (AdjoinRoot.mk (X ^ 2 + X + 1 : k[X]) p) =
      aeval (⟨ζ, Algebra.self_mem_adjoin_singleton k ζ⟩ : Algebra.adjoin k {ζ}) p := by
  rw [← AdjoinRoot.aeval_eq p, ← aeval_algHom_apply, quadraticAlgEquivAdjoin_root]

/-- After inclusion in the extension, a quotient class is ordinary algebraic evaluation. -/
theorem quadraticAlgEquivAdjoin_mk_coe (hζ : IsPrimitiveRoot ζ 3) (p : k[X]) :
    (quadraticAlgEquivAdjoin hnosplit ζ hζ
      (AdjoinRoot.mk (X ^ 2 + X + 1 : k[X]) p) : L) = aeval ζ p := by
  rw [quadraticAlgEquivAdjoin_mk, coe_aeval_mk_apply]

/-- Scalars retain their canonical base-algebra interpretation. -/
@[simp]
theorem quadraticAlgEquivAdjoin_algebraMap (hζ : IsPrimitiveRoot ζ 3) (a : k) :
    quadraticAlgEquivAdjoin hnosplit ζ hζ
        (AdjoinRoot.of (X ^ 2 + X + 1 : k[X]) a) =
      algebraMap k (Algebra.adjoin k ({ζ} : Set L)) a :=
  (quadraticAlgEquivAdjoin hnosplit ζ hζ).commutes a

/-- Inclusion after the chosen-subalgebra equivalence is the evaluation algebra hom. -/
theorem quadraticAlgEquivAdjoin_inclusion_comp (hζ : IsPrimitiveRoot ζ 3) :
    (Algebra.adjoin k ({ζ} : Set L)).val.comp
        (quadraticAlgEquivAdjoin hnosplit ζ hζ).toAlgHom = quadraticEval ζ hζ := by
  apply AdjoinRoot.algHom_ext
  change (quadraticAlgEquivAdjoin hnosplit ζ hζ
      (AdjoinRoot.root (X ^ 2 + X + 1 : k[X])) : L) =
    quadraticEval ζ hζ (AdjoinRoot.root (X ^ 2 + X + 1 : k[X]))
  rw [quadraticAlgEquivAdjoin_root, quadraticEval_root]

/-- The inverse comparison recovers the quotient root from the selected generator. -/
@[simp]
theorem quadraticAlgEquivAdjoin_symm_root (hζ : IsPrimitiveRoot ζ 3) :
    (quadraticAlgEquivAdjoin hnosplit ζ hζ).symm
        ⟨ζ, Algebra.self_mem_adjoin_singleton k ζ⟩ =
      AdjoinRoot.root (X ^ 2 + X + 1 : k[X]) := by
  apply (quadraticAlgEquivAdjoin hnosplit ζ hζ).injective
  rw [AlgEquiv.apply_symm_apply, quadraticAlgEquivAdjoin_root]

end ChosenRoot

section SeparableClosure

variable {k : Type u} [Field k]

/-- The separable closure contains a primitive cube root when 3 is nonzero in the base. -/
theorem exists_separableClosure_primitiveRoot (h3 : (3 : k) ≠ 0) :
    ∃ ζ : SeparableClosure k, IsPrimitiveRoot ζ 3 := by
  let _ : NeZero (3 : SeparableClosure k) := ⟨fun h ↦
    h3 ((algebraMap k (SeparableClosure k)).injective
      (by simpa only [map_ofNat, map_zero] using h))⟩
  exact HasEnoughRootsOfUnity.exists_primitiveRoot (SeparableClosure k) 3

/-- A fixed primitive cube root in the separable closure, retaining its chosen embedding. -/
noncomputable def separableClosureRoot (h3 : (3 : k) ≠ 0) : SeparableClosure k :=
  Classical.choose (exists_separableClosure_primitiveRoot h3)

theorem separableClosureRoot_isPrimitiveRoot (h3 : (3 : k) ≠ 0) :
    IsPrimitiveRoot (separableClosureRoot h3) 3 :=
  Classical.choose_spec (exists_separableClosure_primitiveRoot h3)

/-- The canonical chosen separable-closure root has the nonsplit quadratic as minimal polynomial. -/
theorem separableClosureRoot_minpoly (h3 : (3 : k) ≠ 0)
    (hnosplit : ¬ ∃ a : k, IsPrimitiveRoot a 3) :
    minpoly k (separableClosureRoot h3) = (X ^ 2 + X + 1 : k[X]) :=
  quadratic_minpoly hnosplit (separableClosureRoot_isPrimitiveRoot h3)

/-- The quadratic quotient identified with the chosen-root subalgebra of the
separable closure, with no perfectness assumption on the base field. -/
noncomputable def quadraticAlgEquivSeparableClosureAdjoin (h3 : (3 : k) ≠ 0)
    (hnosplit : ¬ ∃ a : k, IsPrimitiveRoot a 3) :
    AdjoinRoot (X ^ 2 + X + 1 : k[X]) ≃ₐ[k]
      Algebra.adjoin k ({separableClosureRoot h3} : Set (SeparableClosure k)) :=
  quadraticAlgEquivAdjoin hnosplit _ (separableClosureRoot_isPrimitiveRoot h3)

@[simp]
theorem quadraticAlgEquivSeparableClosureAdjoin_root (h3 : (3 : k) ≠ 0)
    (hnosplit : ¬ ∃ a : k, IsPrimitiveRoot a 3) :
    quadraticAlgEquivSeparableClosureAdjoin h3 hnosplit
        (AdjoinRoot.root (X ^ 2 + X + 1 : k[X])) =
      ⟨separableClosureRoot h3, Algebra.self_mem_adjoin_singleton k _⟩ :=
  quadraticAlgEquivAdjoin_root hnosplit (separableClosureRoot_isPrimitiveRoot h3)

/-- Polynomial classes retain their selected separable-closure evaluations. -/
@[simp]
theorem quadraticAlgEquivSeparableClosureAdjoin_mk (h3 : (3 : k) ≠ 0)
    (hnosplit : ¬ ∃ a : k, IsPrimitiveRoot a 3) (p : k[X]) :
    quadraticAlgEquivSeparableClosureAdjoin h3 hnosplit
        (AdjoinRoot.mk (X ^ 2 + X + 1 : k[X]) p) =
      aeval (⟨separableClosureRoot h3, Algebra.self_mem_adjoin_singleton k _⟩ :
        Algebra.adjoin k ({separableClosureRoot h3} : Set (SeparableClosure k))) p :=
  quadraticAlgEquivAdjoin_mk hnosplit (separableClosureRoot_isPrimitiveRoot h3) p

@[simp]
theorem quadraticAlgEquivSeparableClosureAdjoin_algebraMap (h3 : (3 : k) ≠ 0)
    (hnosplit : ¬ ∃ a : k, IsPrimitiveRoot a 3) (a : k) :
    quadraticAlgEquivSeparableClosureAdjoin h3 hnosplit
        (AdjoinRoot.of (X ^ 2 + X + 1 : k[X]) a) =
      algebraMap k
        (Algebra.adjoin k ({separableClosureRoot h3} : Set (SeparableClosure k))) a :=
  quadraticAlgEquivAdjoin_algebraMap hnosplit (separableClosureRoot_isPrimitiveRoot h3) a

/-- The separable-closure comparison remembers the inclusion into that closure. -/
theorem quadraticAlgEquivSeparableClosureAdjoin_inclusion_comp (h3 : (3 : k) ≠ 0)
    (hnosplit : ¬ ∃ a : k, IsPrimitiveRoot a 3) :
    (Algebra.adjoin k ({separableClosureRoot h3} : Set (SeparableClosure k))).val.comp
        (quadraticAlgEquivSeparableClosureAdjoin h3 hnosplit).toAlgHom =
      quadraticEval (separableClosureRoot h3) (separableClosureRoot_isPrimitiveRoot h3) :=
  quadraticAlgEquivAdjoin_inclusion_comp hnosplit (separableClosureRoot_isPrimitiveRoot h3)

end SeparableClosure

end AlgebraicGeometry.RootsOfUnityThree
