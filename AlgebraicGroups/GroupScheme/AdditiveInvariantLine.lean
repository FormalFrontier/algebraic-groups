module

public import AlgebraicGroups.Algebra.Coalgebra.Evaluation
public import AlgebraicGroups.GroupScheme.AdditiveComodule
public import Mathlib.Algebra.CharP.Two
public import Mathlib.Algebra.TrivSqZeroExt.Basic
public import Mathlib.FieldTheory.Finite.Basic

/-!
# A line preserved by ground-field points but not by all algebra-valued points

In the additive group's polynomial regular comodule over `ZMod 2`, the nonzero
proper line spanned by `X ^ 2 + X` is fixed by every ground-field point. In
`TrivSqZeroExt (ZMod 2) (ZMod 2)`, translation by the nonzero square-zero element
`epsilon` adds the constant `epsilon`. The scalar-extended constant-coefficient
map vanishes on the range of the tensor inclusion of the line, but detects this
translated vector. Thus invariance under ground-field points does not imply
invariance under all algebra-valued points.

The coacting coalgebra throughout is `additiveGroupCoordinateRing (ZMod 2)`.
Only the regular-comodule carrier is transported to polynomials. Scalar-extension
subspaces below are ranges of the tensor extensions of their subtype inclusions;
no polynomial presentation of a tensor product is used.

## References

* J. S. Milne, *Algebraic Groups* (2017), Chapter 4(c), for the all-algebra-points
  meaning of invariant subspace. The finite-field counterexample here explains
  why ground-field points alone do not give that condition.
* Mathlib's `TrivSqZeroExt`, `Polynomial.lcoeff`, `LinearMap.liftBaseChange`, and
  `Submodule.baseChange_span` formalizations.
* This library's `FrobeniusTwistedLine.nilpotentWitness_ne_zero`, for the related
  technique of detecting a nonzero infinitesimal by `TrivSqZeroExt.snd`.
-/

@[expose] public noncomputable section

open scoped TensorProduct

universe a

namespace AlgebraicGeometry.AdditiveGroupInvariantLine

local notation "K" => ZMod 2
local notation "V" => Polynomial K
local notation "C" => additiveGroupCoordinateRing K
local notation "R" => TrivSqZeroExt K K

/-- The polynomial fixed by translations by elements of the two-element field. -/
def generator : V := Polynomial.X ^ 2 + Polynomial.X

/-- The generator has zero constant coefficient. -/
@[simp] theorem generator_coeff_zero : generator.coeff 0 = 0 := by
  simp [generator]

/-- The quadratic coefficient of the generator is one. -/
@[simp] theorem generator_coeff_two : generator.coeff 2 = 1 := by
  simp [generator, Polynomial.coeff_X]

/-- The fixed polynomial is nonzero, as its quadratic coefficient is one. -/
theorem generator_ne_zero : generator ≠ 0 := by
  intro h
  have hc := congrArg (fun p : V ↦ p.coeff 2) h
  rw [generator_coeff_two, Polynomial.coeff_zero] at hc
  exact (one_ne_zero : (1 : K) ≠ 0) hc

/-- The ground-field line generated by `X ^ 2 + X`. -/
def line : Submodule K V := Submodule.span K {generator}

/-- Membership in the line is being a scalar multiple of the generator. -/
theorem mem_line_iff (p : V) : p ∈ line ↔ ∃ a : K, a • generator = p :=
  Submodule.mem_span_singleton

/-- The displayed generator lies in the line it spans. -/
theorem generator_mem_line : generator ∈ line :=
  Submodule.mem_span_singleton_self generator

/-- Every element of the line has zero constant coefficient. -/
theorem line_le_ker_lcoeff : line ≤ LinearMap.ker (Polynomial.lcoeff K 0) := by
  rw [line, Submodule.span_singleton_le_iff_mem]
  change (Polynomial.lcoeff K 0) generator = 0
  simpa only [Polynomial.lcoeff_apply] using generator_coeff_zero

/-- The invariant line is genuinely nonzero. -/
theorem line_ne_bot : line ≠ ⊥ := by
  intro h
  apply generator_ne_zero
  simpa only [h, Submodule.mem_bot] using generator_mem_line

/-- The constant polynomial does not belong to the line. -/
theorem one_not_mem_line : (1 : V) ∉ line := by
  intro h
  have hc : (1 : V).coeff 0 = 0 := line_le_ker_lcoeff h
  rw [Polynomial.coeff_one_zero] at hc
  exact (one_ne_zero : (1 : K) ≠ 0) hc

/-- The invariant line is a proper subspace of the polynomial carrier. -/
theorem line_ne_top : line ≠ ⊤ := by
  intro h
  apply one_not_mem_line
  rw [h]
  trivial

/-- The generator's coaction, with the symmetric-algebra coalgebra unchanged. -/
theorem coaction_generator :
    (additiveGroupPolynomialComodule K).coaction generator =
      generator ⊗ₜ[K] (1 : C) +
        (1 : V) ⊗ₜ[K] (additiveGroupCoordinate K ^ 2 + additiveGroupCoordinate K) := by
  have htwo : (2 : K) = 0 := by simpa using ZMod.natCast_self 2
  have hsq :
      (additiveGroupPolynomialComodule K).coaction (Polynomial.X ^ 2) =
        (Polynomial.X ^ 2 : V) ⊗ₜ[K] (1 : C) +
          (1 : V) ⊗ₜ[K] (additiveGroupCoordinate K ^ 2) := by
    simpa [Finset.sum_range_succ, htwo, add_comm] using
      additiveGroupPolynomialComodule_coaction_X_pow K 2
  change (additiveGroupPolynomialComodule K).coaction
      (Polynomial.X ^ 2 + Polynomial.X) =
    (Polynomial.X ^ 2 + Polynomial.X : V) ⊗ₜ[K] (1 : C) +
      (1 : V) ⊗ₜ[K] (additiveGroupCoordinate K ^ 2 + additiveGroupCoordinate K)
  rw [map_add, hsq, additiveGroupPolynomialComodule_coaction_X,
    TensorProduct.add_tmul, TensorProduct.tmul_add]
  ac_rfl

/-- Evaluation of the generator at an arbitrary algebra-valued additive-group point. -/
theorem evaluate_generator {A : Type a} [CommSemiring A] [Algebra K A]
    (g : C →ₐ[K] A) :
    (additiveGroupPolynomialComodule K).evaluate g.toLinearMap (1 ⊗ₜ[K] generator) =
      (1 : A) ⊗ₜ[K] generator +
        (g (additiveGroupCoordinate K) ^ 2 + g (additiveGroupCoordinate K)) ⊗ₜ[K]
          (1 : V) := by
  rw [Coalgebra.RightComodule.evaluate_one_tmul, coaction_generator]
  simp only [map_add, TensorProduct.comm_tmul, TensorProduct.map_tmul,
    AlgHom.toLinearMap_apply, LinearMap.id_apply, map_one, map_pow]

/-- The tensor-inclusion range is the scalar span of the one-tensor generator. -/
theorem range_baseChange_subtype (A : Type a) [CommSemiring A] [Algebra K A] :
    LinearMap.range (line.subtype.baseChange A) =
      Submodule.span A {(1 : A) ⊗ₜ[K] generator} := by
  change line.baseChange A = _
  simp only [line, Submodule.baseChange_span, Set.image_singleton, TensorProduct.mk_apply]

/-- The one-tensor generator belongs to the tensor-inclusion range. -/
theorem one_tmul_generator_mem_range (A : Type a) [CommSemiring A] [Algebra K A] :
    (1 : A) ⊗ₜ[K] generator ∈ LinearMap.range (line.subtype.baseChange A) :=
  ⟨(1 : A) ⊗ₜ[K] (⟨generator, generator_mem_line⟩ : line), rfl⟩

/-- Every ground-field point fixes the one-tensor generator. -/
theorem groundFieldPoint_evaluate_generator (g : C →ₐ[K] K) :
    (additiveGroupPolynomialComodule K).evaluate g.toLinearMap (1 ⊗ₜ[K] generator) =
      (1 : K) ⊗ₜ[K] generator := by
  have ha : g (additiveGroupCoordinate K) ^ 2 + g (additiveGroupCoordinate K) = 0 := by
    rw [ZMod.pow_card]
    exact CharTwo.add_self_eq_zero _
  rw [evaluate_generator, ha, TensorProduct.zero_tmul, add_zero]

/-- Every ground-field point fixes every element of the tensor-inclusion range. -/
theorem groundFieldPoint_evaluate_eq_self (g : C →ₐ[K] K)
    {z : K ⊗[K] V} (hz : z ∈ LinearMap.range (line.subtype.baseChange K)) :
    (additiveGroupPolynomialComodule K).evaluate g.toLinearMap z = z := by
  rw [range_baseChange_subtype] at hz
  obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hz
  rw [map_smul, groundFieldPoint_evaluate_generator]

/-- All ground-field points preserve the entire original tensor-inclusion range. -/
theorem groundFieldPoints_preserve_range (g : C →ₐ[K] K)
    {z : K ⊗[K] V} (hz : z ∈ LinearMap.range (line.subtype.baseChange K)) :
    (additiveGroupPolynomialComodule K).evaluate g.toLinearMap z ∈
      LinearMap.range (line.subtype.baseChange K) := by
  rw [groundFieldPoint_evaluate_eq_self g hz]
  exact hz

/-- The infinitesimal element of the trivial square-zero extension. -/
def epsilon : R := TrivSqZeroExt.inr (1 : K)

/-- The infinitesimal is nonzero, detected by the second projection. -/
theorem epsilon_ne_zero : epsilon ≠ 0 := by
  intro h
  exact one_ne_zero (congrArg TrivSqZeroExt.snd h)

/-- The infinitesimal has square zero. -/
@[simp] theorem epsilon_sq : epsilon ^ 2 = 0 := by
  simp only [epsilon, pow_two, TrivSqZeroExt.inr_mul_inr]

/-- The additive-group point whose polynomial coordinate is `epsilon`. -/
def epsilonPoint : C →ₐ[K] R :=
  (Polynomial.aeval epsilon).comp (additiveGroupCoordinateAlgEquiv K).toAlgHom

/-- The infinitesimal point reads back its prescribed coordinate. -/
@[simp] theorem epsilonPoint_coordinate : epsilonPoint (additiveGroupCoordinate K) = epsilon := by
  simp [epsilonPoint]

/-- Translation by the infinitesimal adds its constant polynomial to the generator. -/
theorem epsilonPoint_evaluate_generator :
    (additiveGroupPolynomialComodule K).evaluate epsilonPoint.toLinearMap
        (1 ⊗ₜ[K] generator) =
      (1 : R) ⊗ₜ[K] generator + epsilon ⊗ₜ[K] (1 : V) := by
  rw [evaluate_generator, epsilonPoint_coordinate, epsilon_sq, zero_add]

/-- The scalar-extended constant coefficient, constructed directly as a linear lift. -/
def constantCoefficient : R ⊗[K] V →ₗ[R] R :=
  LinearMap.liftBaseChange R
    ((Algebra.linearMap K R).comp (Polynomial.lcoeff K 0))

/-- On pure tensors the detector multiplies the scalar by the constant coefficient. -/
@[simp] theorem constantCoefficient_tmul (r : R) (p : V) :
    constantCoefficient (r ⊗ₜ[K] p) = r * algebraMap K R (p.coeff 0) := by
  simp only [constantCoefficient, LinearMap.liftBaseChange_tmul, LinearMap.comp_apply,
    Algebra.linearMap_apply, Polynomial.lcoeff_apply, smul_eq_mul]

/-- The detector annihilates the tensor extension of the line's subtype inclusion. -/
theorem constantCoefficient_comp_baseChange_subtype :
    constantCoefficient.comp (line.subtype.baseChange R) = 0 := by
  apply TensorProduct.AlgebraTensorModule.ext
  intro r w
  change constantCoefficient (r ⊗ₜ[K] (w : V)) = 0
  have hw : (w : V).coeff 0 = 0 := line_le_ker_lcoeff w.property
  rw [constantCoefficient_tmul, hw, map_zero, mul_zero]

/-- Consequently the detector vanishes on every element of the original range. -/
theorem constantCoefficient_eq_zero_of_mem_range {z : R ⊗[K] V}
    (hz : z ∈ LinearMap.range (line.subtype.baseChange R)) :
    constantCoefficient z = 0 := by
  obtain ⟨w, rfl⟩ := hz
  simpa only [LinearMap.comp_apply, LinearMap.zero_apply] using
    LinearMap.congr_fun constantCoefficient_comp_baseChange_subtype w

/-- The translated generator has nonzero constant detector value. -/
theorem constantCoefficient_epsilonPoint_evaluate_generator :
    constantCoefficient ((additiveGroupPolynomialComodule K).evaluate
      epsilonPoint.toLinearMap (1 ⊗ₜ[K] generator)) = epsilon := by
  rw [epsilonPoint_evaluate_generator, map_add]
  simp

/-- The infinitesimal point takes the generator outside the same tensor-inclusion range. -/
theorem epsilonPoint_evaluate_generator_not_mem_range :
    (additiveGroupPolynomialComodule K).evaluate epsilonPoint.toLinearMap
        (1 ⊗ₜ[K] generator) ∉ LinearMap.range (line.subtype.baseChange R) := by
  intro h
  have hz := constantCoefficient_eq_zero_of_mem_range h
  rw [constantCoefficient_epsilonPoint_evaluate_generator] at hz
  exact epsilon_ne_zero hz

/-- Every ground-field point preserves the original range, whereas the epsilon point
fails to preserve it after extension to the square-zero algebra. -/
theorem groundFieldPoints_preserve_but_epsilonPoint_does_not :
    (∀ (g : C →ₐ[K] K) (z : K ⊗[K] V),
      z ∈ LinearMap.range (line.subtype.baseChange K) →
        (additiveGroupPolynomialComodule K).evaluate g.toLinearMap z ∈
          LinearMap.range (line.subtype.baseChange K)) ∧
    ∃ z ∈ LinearMap.range (line.subtype.baseChange R),
      (additiveGroupPolynomialComodule K).evaluate epsilonPoint.toLinearMap z ∉
        LinearMap.range (line.subtype.baseChange R) := by
  refine ⟨fun g z hz ↦ groundFieldPoints_preserve_range g hz,
    1 ⊗ₜ[K] generator, one_tmul_generator_mem_range R, ?_⟩
  exact epsilonPoint_evaluate_generator_not_mem_range

/-- The original polynomial regular coaction does not stabilize this line. -/
theorem not_isStable : ¬ (additiveGroupPolynomialComodule K).IsStable line := by
  intro h
  apply epsilonPoint_evaluate_generator_not_mem_range
  exact h.evaluation_mem_baseChange epsilonPoint (1 ⊗ₜ[K] generator)
    (one_tmul_generator_mem_range R)

end AlgebraicGeometry.AdditiveGroupInvariantLine
