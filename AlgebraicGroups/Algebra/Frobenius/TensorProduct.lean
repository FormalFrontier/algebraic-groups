module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.Algebra.CharP.Defs
public import Mathlib.Algebra.Ring.Defs
public import Mathlib.RingTheory.Bialgebra.Basic
public import Mathlib.RingTheory.TensorProduct.Maps
import Mathlib.Algebra.CharP.Basic
import Mathlib.Algebra.CharP.Lemmas

/-!
# Powers in tensor products of power-generated subalgebras

A characteristic power of a tensor lies in the image of the tensor product of the
power-generated subalgebras in its two factors. The exponential-characteristic statement
works for commutative semirings. Its prime-characteristic specialization only assumes
characteristic on the coefficient semiring, allowing either algebra and the tensor target
to be zero. Neither perfectness nor flatness is needed for this image statement.

Applied to comultiplication, it proves that the power-generated subalgebra of a
commutative bialgebra has comultiplication in the image of its two-sided tensor inclusion.
No injectivity of that tensor inclusion is asserted here.

## Main results

* `Algebra.TensorProduct.pow_mem_range_map_adjoin_pow_of_expChar`
* `Algebra.TensorProduct.pow_mem_range_map_adjoin_pow_of_charP`
* `Bialgebra.comul_mem_range_map_adjoin_pow`
-/

@[expose] public section

universe uR uA uB

open scoped TensorProduct

namespace Algebra.TensorProduct

/-- A characteristic-power of any tensor lies in the image of the tensor product of the
subalgebras generated by the corresponding powers in the two factors. -/
theorem pow_mem_range_map_adjoin_pow_of_expChar
    {R : Type uR} {A : Type uA} {B : Type uB}
    [CommSemiring R] [CommSemiring A] [CommSemiring B]
    [Algebra R A] [Algebra R B]
    (p n : ℕ) [ExpChar (A ⊗[R] B) p] (z : A ⊗[R] B) :
    z ^ (p ^ n) ∈
      (Algebra.TensorProduct.map
        (Algebra.adjoin R (Set.range (fun a : A => a ^ (p ^ n)))).val
        (Algebra.adjoin R (Set.range (fun b : B => b ^ (p ^ n)))).val).range := by
  let C_A : Subalgebra R A := Algebra.adjoin R (Set.range (fun a : A => a ^ (p ^ n)))
  let C_B : Subalgebra R B := Algebra.adjoin R (Set.range (fun b : B => b ^ (p ^ n)))
  let f : C_A ⊗[R] C_B →ₐ[R] A ⊗[R] B := Algebra.TensorProduct.map C_A.val C_B.val
  change z ^ (p ^ n) ∈ f.range
  refine _root_.TensorProduct.inductionOn
    (motive := fun t : A ⊗[R] B => t ^ (p ^ n) ∈ f.range) z ?_ ?_
  · intro a b
    let aq : C_A := ⟨a ^ (p ^ n), Algebra.subset_adjoin ⟨a, rfl⟩⟩
    let bq : C_B := ⟨b ^ (p ^ n), Algebra.subset_adjoin ⟨b, rfl⟩⟩
    apply (AlgHom.mem_range f).2
    refine ⟨aq ⊗ₜ[R] bq, ?_⟩
    change (a ^ (p ^ n)) ⊗ₜ[R] (b ^ (p ^ n)) = (a ⊗ₜ[R] b) ^ (p ^ n)
    exact (Algebra.TensorProduct.tmul_pow a b (p ^ n)).symm
  · intro x y hx hy
    rw [add_pow_expChar_pow x y p n]
    exact f.range.add_mem hx hy

/-- Over a commutative base of prime characteristic, powers lie in the two-sided image
even when either algebra, or their tensor product, is zero. No flatness is needed. -/
theorem pow_mem_range_map_adjoin_pow_of_charP
    {R : Type uR} {A : Type uA} {B : Type uB}
    [CommSemiring R] [CommSemiring A] [CommSemiring B] [Algebra R A] [Algebra R B]
    (p n : ℕ) [Fact p.Prime] [CharP R p] (z : A ⊗[R] B) :
    z ^ (p ^ n) ∈
      (Algebra.TensorProduct.map
        (Algebra.adjoin R (Set.range (fun a : A => a ^ (p ^ n)))).val
        (Algebra.adjoin R (Set.range (fun b : B => b ^ (p ^ n)))).val).range := by
  rcases subsingleton_or_nontrivial (A ⊗[R] B) with h | h
  · have : Subsingleton (A ⊗[R] B) := h
    apply (AlgHom.mem_range _).2
    exact ⟨0, Subsingleton.elim _ _⟩
  · have : Nontrivial (A ⊗[R] B) := h
    have : CharP (A ⊗[R] B) p := by
      apply (CharP.charP_iff_prime_eq_zero
        (R := A ⊗[R] B) (Fact.out : p.Prime)).mpr
      simpa only [map_natCast, map_zero] using
        congrArg (algebraMap R (A ⊗[R] B)) (CharP.cast_eq_zero R p)
    exact pow_mem_range_map_adjoin_pow_of_expChar (R := R) p n z

end Algebra.TensorProduct

/-- Comultiplication of the power-generated subalgebra lies in the linear-map range
of the tensor product of its original inclusions. The comultiplication and scalar
structures are the ones inherited from the bialgebra; no injectivity of the tensor
inclusion, nontriviality, flatness, or perfectness is required. -/
theorem Bialgebra.comul_mem_range_map_adjoin_pow
    (R : Type uR) (A : Type uA) [CommSemiring R] [CommSemiring A] [Bialgebra R A]
    (p n : ℕ) [Fact p.Prime] [CharP R p] :
    let S : Subalgebra R A := Algebra.adjoin R (Set.range (fun a : A => a ^ (p ^ n)))
    ∀ s : S, CoalgebraStruct.comul (s : A) ∈
      LinearMap.range (_root_.TensorProduct.map S.val.toLinearMap S.val.toLinearMap) := by
  let S : Subalgebra R A := Algebra.adjoin R (Set.range (fun a : A => a ^ (p ^ n)))
  change ∀ s : S, CoalgebraStruct.comul (s : A) ∈
    LinearMap.range (_root_.TensorProduct.map S.val.toLinearMap S.val.toLinearMap)
  intro s
  let f : S ⊗[R] S →ₐ[R] A ⊗[R] A := Algebra.TensorProduct.map S.val S.val
  have hC : S ≤ f.range.comap (Bialgebra.comulAlgHom R A) := by
    apply Algebra.adjoin_le
    rintro _ ⟨a, rfl⟩
    change Bialgebra.comulAlgHom R A (a ^ (p ^ n)) ∈ f.range
    rw [map_pow]
    exact Algebra.TensorProduct.pow_mem_range_map_adjoin_pow_of_charP
      (R := R) p n (Bialgebra.comulAlgHom R A a)
  have hmap : f.toLinearMap =
      _root_.TensorProduct.map S.val.toLinearMap S.val.toLinearMap :=
    (Algebra.TensorProduct.toLinearMap_map S.val S.val).trans
      (_root_.TensorProduct.AlgebraTensorModule.map_eq S.val.toLinearMap S.val.toLinearMap)
  rcases (AlgHom.mem_range f).mp (hC s.property) with ⟨x, hx⟩
  refine ⟨x, ?_⟩
  rw [← hmap]
  exact hx
