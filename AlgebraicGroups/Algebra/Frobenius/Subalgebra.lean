/-!
# Power-generated subalgebras

A finite-type commutative algebra is finite over the subalgebra generated by all powers
of a fixed positive exponent. Over a Noetherian base, that subalgebra is itself of finite
type, by the Artin–Tate lemma.

In prime characteristic, subalgebras generated by sufficiently high Frobenius powers
are geometrically reduced, even when the coefficient field is imperfect and the original
algebra is nonreduced or zero. The proof chooses the nilradical bound after scalar extension
to an algebraic closure. Frobenius is used as a ring map, not as a map linear over the
coefficient field. Scalar extension retains the coefficient-first tensor action.

## Main results

* `Algebra.finite_adjoin_range_pow`
* `Algebra.finiteType_adjoin_range_pow`
* `IsNoetherianRing.exists_forall_isReduced_range_iterateFrobenius`
* `Algebra.TensorProduct.range_map_adjoin_pow_char`
* `Algebra.mem_adjoin_range_iterateFrobenius_iff`
* `Algebra.exists_forall_isGeometricallyReduced_adjoin_pow`

## References

* The Stacks Project, Tag 00IS (Artin–Tate).
-/

@[expose] public section

open scoped TensorProduct

universe u v uK uL uA

/-- A finite-type algebra is finite over the subalgebra generated by all powers of a
positive exponent. -/
theorem Algebra.finite_adjoin_range_pow
    (R : Type u) (A : Type v) [CommRing R] [CommRing A] [Algebra R A]
    [Algebra.FiniteType R A] (q : ℕ) (hq : 0 < q) :
    Module.Finite (Algebra.adjoin R (Set.range (fun a : A => a ^ q))) A := by
  let C : Subalgebra R A := Algebra.adjoin R (Set.range (fun a : A => a ^ q))
  let : Algebra.FiniteType C A :=
    Algebra.FiniteType.of_restrictScalars_finiteType R C A
  let : Algebra.IsIntegral C A := ⟨fun a => by
    apply IsIntegral.of_pow hq
    have ha : a ^ q ∈ C := Algebra.subset_adjoin (R := R) ⟨a, rfl⟩
    change IsIntegral C (algebraMap C A (⟨a ^ q, ha⟩ : C))
    exact isIntegral_algebraMap⟩
  exact Algebra.IsIntegral.finite

/-- Over a Noetherian base, the subalgebra generated by all powers of a positive
exponent in a finite-type algebra is itself of finite type. -/
theorem Algebra.finiteType_adjoin_range_pow
    (R : Type u) (A : Type v) [CommRing R] [IsNoetherianRing R]
    [CommRing A] [Algebra R A] [Algebra.FiniteType R A] (q : ℕ) (hq : 0 < q) :
    Algebra.FiniteType R (Algebra.adjoin R (Set.range (fun a : A => a ^ q))) := by
  let : Module.Finite (Algebra.adjoin R (Set.range (fun a : A => a ^ q))) A :=
    Algebra.finite_adjoin_range_pow R A q hq
  exact ⟨fg_of_fg_of_fg R (Algebra.adjoin R (Set.range (fun a : A => a ^ q))) A
    (Algebra.FiniteType.out (R := R) (A := A))
    (Module.Finite.fg_top
      (R := Algebra.adjoin R (Set.range (fun a : A => a ^ q))) (M := A))
    Subtype.val_injective⟩

/-- In a Noetherian commutative ring of prime characteristic, the ring ranges of all
sufficiently high iterates of Frobenius are reduced. No perfection assumption is needed. -/
theorem IsNoetherianRing.exists_forall_isReduced_range_iterateFrobenius
    (A : Type u) [CommRing A] [IsNoetherianRing A] (p : ℕ)
    [Fact p.Prime] [CharP A p] :
    ∃ N : ℕ, ∀ n : ℕ, N ≤ n → IsReduced (iterateFrobenius A p n).range := by
  have hp : p.Prime := Fact.out
  obtain ⟨N, hN⟩ := IsNoetherianRing.isNilpotent_nilradical A
  refine ⟨N, ?_⟩
  intro n hn
  refine ⟨fun x hx => ?_⟩
  obtain ⟨y, hy⟩ := RingHom.mem_range.mp x.property
  have hxA : IsNilpotent (x : A) := by
    obtain ⟨k, hk⟩ := hx
    exact ⟨k, congrArg Subtype.val hk⟩
  rw [← hy, iterateFrobenius_def] at hxA
  have hyNil : IsNilpotent y := hxA.of_pow
  have hyN : y ^ N = 0 := by
    have hmem := Ideal.pow_mem_pow (mem_nilradical.mpr hyNil) N
    simpa only [hN, Ideal.zero_eq_bot, Submodule.mem_bot] using hmem
  apply Subtype.ext
  change (x : A) = 0
  rw [← hy, iterateFrobenius_def]
  exact pow_eq_zero_of_le
    (hn.trans (Nat.le_of_lt (Nat.lt_pow_self hp.one_lt))) hyN

/-- Over a commutative base of prime characteristic, scalar extension of the
power-generated subalgebra has the expected image. No flatness or perfection is needed,
and either algebra over the base may be zero. -/
theorem Algebra.TensorProduct.range_map_adjoin_pow_char
    {R : Type uK} [CommRing R] (L : Type uL) [CommRing L] [Algebra R L]
    (A : Type uA) [CommRing A] [Algebra R A]
    (p : ℕ) [Fact p.Prime] [CharP R p] (n : ℕ) :
    (Algebra.TensorProduct.map (AlgHom.id L L)
      (Algebra.adjoin R (Set.range fun a : A => a ^ (p ^ n))).val).range =
      Algebra.adjoin L (Set.range fun z : L ⊗[R] A => z ^ (p ^ n)) := by
  rcases subsingleton_or_nontrivial (L ⊗[R] A) with hA | hA
  · have := hA
    ext z
    rw [Subsingleton.elim z 0]
    simp
  · have := hA
    have : CharP (L ⊗[R] A) p := by
      apply (CharP.charP_iff_prime_eq_zero
        (R := L ⊗[R] A) (Fact.out : p.Prime)).mpr
      simpa only [map_natCast, map_zero] using
        congrArg (algebraMap R (L ⊗[R] A)) (CharP.cast_eq_zero R p)
    let C : Subalgebra R A :=
      Algebra.adjoin R (Set.range fun a : A => a ^ (p ^ n))
    let g : L ⊗[R] C →ₐ[L] L ⊗[R] A :=
      Algebra.TensorProduct.map (AlgHom.id L L) C.val
    let D : Subalgebra L (L ⊗[R] A) :=
      Algebra.adjoin L (Set.range fun z : L ⊗[R] A => z ^ (p ^ n))
    change g.range = D
    apply le_antisymm
    · have hC : C ≤ (D.restrictScalars R).comap
          (Algebra.TensorProduct.includeRight : A →ₐ[R] L ⊗[R] A) := by
        apply Algebra.adjoin_le
        rintro _ ⟨a, rfl⟩
        change (Algebra.TensorProduct.includeRight (a ^ (p ^ n)) :
          L ⊗[R] A) ∈ D
        rw [map_pow]
        exact Algebra.subset_adjoin ⟨_, rfl⟩
      rintro _ ⟨x, rfl⟩
      induction x using TensorProduct.inductionOn with
      | tmul l c =>
          change l ⊗ₜ[R] (c : A) ∈ D
          have hc : (1 : L) ⊗ₜ[R] (c : A) ∈ D := hC c.property
          simpa only [TensorProduct.smul_tmul', smul_eq_mul, mul_one] using
            D.smul_mem hc l
      | add x y hx hy =>
          simpa only [map_add] using D.add_mem hx hy
    · apply Algebra.adjoin_le
      rintro _ ⟨z, rfl⟩
      induction z using TensorProduct.inductionOn with
      | tmul l a =>
          change (l ⊗ₜ[R] a) ^ (p ^ n) ∈ g.range
          rw [Algebra.TensorProduct.tmul_pow]
          exact Subalgebra.tmul_mem_baseChange (C := C)
            (Algebra.subset_adjoin ⟨a, rfl⟩) (l ^ (p ^ n))
      | add x y hx hy =>
          change (x + y) ^ (p ^ n) ∈ g.range
          rw [add_pow_char_pow x y p n]
          exact g.range.add_mem hx hy

/-- Separate field-flatness specialization for the very same inclusion map. -/
private theorem Subalgebra.tensorProduct_val_injective
    {K : Type uK} [Field K] (L : Type uL) [CommRing L] [Algebra K L]
    {A : Type uA} [CommRing A] [Algebra K A] (C : Subalgebra K A) :
    Function.Injective
      (Algebra.TensorProduct.map (AlgHom.id L L) C.val :
        L ⊗[K] C →ₐ[L] L ⊗[K] A) := by
  let g : L ⊗[K] C →ₐ[L] L ⊗[K] A :=
    Algebra.TensorProduct.map (AlgHom.id L L) C.val
  have hg : (g.restrictScalars K).toLinearMap =
      TensorProduct.map (LinearMap.id : L →ₗ[K] L) C.val.toLinearMap := by
    ext l c
    rfl
  change Function.Injective (g.restrictScalars K).toLinearMap
  rw [hg]
  exact TensorProduct.map_injective_of_flat_flat _ _
    Function.injective_id Subtype.val_injective

namespace Algebra

variable {R : Type u} {A : Type v}
variable [CommSemiring R] [CommSemiring A] [Algebra R A]
variable (p n : ℕ) [ExpChar A p] [PerfectRing R p]

/-- Over perfect coefficients, adjoining the iterated Frobenius image adds no elements. -/
theorem mem_adjoin_range_iterateFrobenius_iff (x : A) :
    x ∈ Algebra.adjoin R (Set.range (iterateFrobenius A p n)) ↔
      ∃ y : A, iterateFrobenius A p n y = x := by
  let S : Subalgebra R A :=
    { (iterateFrobenius A p n).rangeS with
      algebraMap_mem' := fun r => by
        obtain ⟨s, hs⟩ :=
          (PerfectRing.bijective_frobenius (R := R) (p := p ^ n)).2 r
        refine ⟨algebraMap R A s, ?_⟩
        change (algebraMap R A s) ^ (p ^ n) = algebraMap R A r
        simpa only [map_pow] using congrArg (algebraMap R A) hs }
  have hS : Algebra.adjoin R (Set.range (iterateFrobenius A p n)) ≤ S :=
    Algebra.adjoin_le (S := S) (fun _ hx => hx)
  exact ⟨fun hx => hS hx, fun hx => Algebra.subset_adjoin hx⟩

/-- The underlying set of the generated algebra is exactly the ring-map image. -/
theorem coe_adjoin_range_iterateFrobenius :
    (Algebra.adjoin R (Set.range (iterateFrobenius A p n)) : Set A) =
      Set.range (iterateFrobenius A p n) := by
  exact Set.ext fun x =>
    mem_adjoin_range_iterateFrobenius_iff (R := R) (A := A) p n x

end Algebra

namespace Algebra

/-- Subalgebras generated by sufficiently high Frobenius powers in a finite-type
algebra over a field of prime characteristic are geometrically reduced. -/
theorem exists_forall_isGeometricallyReduced_adjoin_pow
    (K : Type uK) [Field K] (A : Type uA) [CommRing A] [Algebra K A]
    [Algebra.FiniteType K A] (p : ℕ) [Fact p.Prime] [CharP K p] :
    ∃ N : ℕ, ∀ n : ℕ, N ≤ n → IsGeometricallyReduced K
      (Algebra.adjoin K (Set.range fun a : A => a ^ (p ^ n))) := by
  classical
  cases subsingleton_or_nontrivial A with
  | inl hA =>
      have : Subsingleton A := hA
      refine ⟨0, fun n _ => (Algebra.isGeometricallyReduced_field_iff K _).mpr ?_⟩
      infer_instance
  | inr hA =>
      have : Nontrivial A := hA
      let Ω := AlgebraicClosure K
      let B := Ω ⊗[K] A
      have : CharP Ω p :=
        charP_of_injective_algebraMap (algebraMap K Ω).injective p
      have : Module.Flat K Ω := inferInstance
      have : Nontrivial B :=
        Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_flat_left
          (R := K) (A := Ω) (B := A) (algebraMap K A).injective
      have : CharP B p :=
        charP_of_injective_algebraMap (algebraMap Ω B).injective p
      have : ExpChar B p := inferInstance
      have : PerfectRing Ω p := inferInstance
      have : Algebra.FiniteType Ω B := inferInstance
      have : IsNoetherianRing Ω := inferInstance
      have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing Ω B
      obtain ⟨N, hN⟩ :=
        IsNoetherianRing.exists_forall_isReduced_range_iterateFrobenius B p
      refine ⟨N, fun n hn => ?_⟩
      have : IsReduced (iterateFrobenius B p n).range := hN n hn
      let C : Subalgebra K A :=
        Algebra.adjoin K (Set.range fun a : A => a ^ (p ^ n))
      let g : Ω ⊗[K] C →ₐ[Ω] B :=
        Algebra.TensorProduct.map (AlgHom.id Ω Ω) C.val
      have hg : Function.Injective g :=
        Subalgebra.tensorProduct_val_injective (K := K) Ω C
      have hgrange : g.range =
          Algebra.adjoin Ω (Set.range fun z : B => z ^ (p ^ n)) :=
        Algebra.TensorProduct.range_map_adjoin_pow_char (R := K) Ω A p n
      have hpow : (Set.range fun z : B => z ^ (p ^ n)) =
          Set.range (iterateFrobenius B p n) := by
        apply congrArg Set.range
        funext z
        simp only [iterateFrobenius_def]
      have hmem (x : Ω ⊗[K] C) :
          g x ∈ (iterateFrobenius B p n).range := by
        apply RingHom.mem_range.mpr
        apply (Algebra.mem_adjoin_range_iterateFrobenius_iff
          (R := Ω) (A := B) p n (g x)).mp
        rw [← hpow, ← hgrange]
        exact ⟨x, rfl⟩
      let f : Ω ⊗[K] C →+* (iterateFrobenius B p n).range :=
        g.toRingHom.codRestrict _ hmem
      have hf : Function.Injective f := by
        intro x y h
        apply hg
        exact congrArg Subtype.val h
      apply (Algebra.isGeometricallyReduced_field_iff K C).mpr
      exact isReduced_of_injective f hf

/-- Some power-generated subalgebra of a finite-type algebra over a field of prime
characteristic is geometrically reduced. -/
theorem exists_isGeometricallyReduced_adjoin_pow
    (K : Type uK) [Field K] (A : Type uA) [CommRing A] [Algebra K A]
    [Algebra.FiniteType K A] (p : ℕ) [Fact p.Prime] [CharP K p] :
    ∃ n : ℕ, IsGeometricallyReduced K
      (Algebra.adjoin K (Set.range fun a : A => a ^ (p ^ n))) := by
  obtain ⟨N, hN⟩ := exists_forall_isGeometricallyReduced_adjoin_pow K A p
  exact ⟨N, hN N le_rfl⟩

/-- Some power-generated subalgebra of a finite-type algebra over a field of prime
characteristic is reduced. -/
theorem exists_isReduced_adjoin_pow
    (K : Type uK) [Field K] (A : Type uA) [CommRing A] [Algebra K A]
    [Algebra.FiniteType K A] (p : ℕ) [Fact p.Prime] [CharP K p] :
    ∃ n : ℕ, IsReduced
      (Algebra.adjoin K (Set.range fun a : A => a ^ (p ^ n))) := by
  obtain ⟨n, hn⟩ := exists_isGeometricallyReduced_adjoin_pow K A p
  have := hn
  exact ⟨n, Algebra.isReduced_of_isGeometricallyReduced (k := K)⟩

end Algebra
