module

public import AlgebraicGroups.Algebra.Frobenius.TensorProduct
public import AlgebraicGroups.Algebra.HopfAlgebra.Subalgebra.Basic
import Mathlib.RingTheory.HopfAlgebra.Convolution

/-!
# Hopf subalgebras generated by Frobenius powers

For a prime `p`, the subalgebra generated by the `p ^ n`-th powers in a
commutative Hopf algebra is stable under comultiplication and antipode.
Comultiplication stability is supplied by the tensor-product closure theorem;
antipode stability follows from
the antipode algebra homomorphism and the minimality of `Algebra.adjoin`.

## Implementation notes

The result uses the existing `Subalgebra.IsHopfSubalgebra` closure predicate over
a commutative semiring of characteristic `p`. It does not construct a Hopf
algebra structure over that general base. Over a field, this closure proof can
be used with the existing Hopf-subalgebra factory and its inclusion morphism.

## References

* J. S. Milne, *Algebraic Groups* (2017), Chapter 3.
-/

@[expose] public section

universe u v

namespace HopfAlgebra

/-- Over a commutative semiring of prime characteristic `p`, the subalgebra
generated by the `p ^ n`-th powers in a commutative Hopf algebra is closed under
comultiplication and antipode.

This is the Hopf-closure property of the Frobenius-power subalgebras used in
Milne, *Algebraic Groups* (2017), Chapter 3. The closure statement here is over a
commutative semiring; a Hopf structure on the subalgebra is not constructed over
that general base. -/
theorem isHopfSubalgebra_adjoin_pow {R : Type u} {A : Type v}
    [CommSemiring R] [CommSemiring A] [HopfAlgebra R A]
    (p n : Nat) [Fact p.Prime] [CharP R p] :
    (Algebra.adjoin R (Set.range (fun a : A => a ^ (p ^ n)))).IsHopfSubalgebra := by
  let S : Subalgebra R A := Algebra.adjoin R (Set.range (fun a : A => a ^ (p ^ n)))
  change S.IsHopfSubalgebra
  refine ⟨?_, ?_⟩
  · exact Bialgebra.comul_mem_range_map_adjoin_pow R A p n
  · let f : A →ₐ[R] A := HopfAlgebra.antipodeAlgHom R A
    have hf : f.toLinearMap = HopfAlgebraStruct.antipode R :=
      HopfAlgebra.toLinearMap_antipodeAlgHom (R := R) (A := A)
    have h : S ≤ S.comap f := by
      change Algebra.adjoin R (Set.range (fun a : A => a ^ (p ^ n))) ≤ S.comap f
      apply Algebra.adjoin_le
      rintro _ ⟨a, rfl⟩
      change f (a ^ (p ^ n)) ∈ S
      rw [map_pow]
      exact Algebra.subset_adjoin ⟨f a, rfl⟩
    intro s
    have hs : f.toLinearMap (s : A) ∈ S := h s.property
    rw [hf] at hs
    exact hs

end HopfAlgebra
