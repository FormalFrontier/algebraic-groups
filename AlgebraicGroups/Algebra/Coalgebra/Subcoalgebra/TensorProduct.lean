module

public import AlgebraicGroups.Algebra.Coalgebra.TensorProduct
public import AlgebraicGroups.Algebra.Coalgebra.Subcoalgebra.Hom
public import Mathlib.RingTheory.Coalgebra.TensorProduct

/-!
# Tensor products of subcoalgebras

For subcoalgebras `D` and `E` over a field, `D.tensorProduct E` is the range of the
tensor product of their inclusions. Its underlying submodule is the span of the pure
tensors with one factor in each subcoalgebra. Membership is characterized by a preimage
in `D ⊗ E`, which need not be a pure tensor.

The range restriction of the tensor map supplies the canonical surjection onto this
subcoalgebra. Its factorization and uniqueness properties are the existing
`CoalgHom.rangeRestrict` API. Containment in any ambient submodule is equivalent to
containment of all the indicated pure tensors.

## References

The construction uses `Subcoalgebra.subtype` and `CoalgHom.range` from
`AlgebraicGroups.Algebra.Coalgebra.Subcoalgebra.Hom`.
Mathlib's coalgebra tensor products are due to Amelia Livingston and Andrew Yang;
its tensor-map and range/span API is due to Kenny Lau and Mario Carneiro.
-/

/-!
# Tensor products and subcoalgebra range containment

The range of a tensor product of coalgebra homomorphisms is contained in a subcoalgebra
exactly when every pure tensor of their values belongs to it. This criterion uses the
linear-map range as the span of these pure tensors.
-/

@[expose] public section

universe u v w

open scoped TensorProduct

namespace Subcoalgebra

variable {K : Type u} {C : Type v} {C' : Type w}
variable [Field K] [AddCommGroup C] [Module K C] [Coalgebra K C]
variable [AddCommGroup C'] [Module K C'] [Coalgebra K C']

/-- The subcoalgebra generated by pure tensors from two subcoalgebras, realized as the
range of the tensor product of their inclusions. -/
noncomputable def tensorProduct (D : Subcoalgebra K C) (E : Subcoalgebra K C') :
    Subcoalgebra K (C ⊗[K] C') :=
  (Coalgebra.TensorProduct.map (R := K) (S := K) D.subtype E.subtype).range

/-- The underlying submodule is the range of the tensor inclusion. -/
@[simp]
theorem tensorProduct_toSubmodule (D : Subcoalgebra K C) (E : Subcoalgebra K C') :
    (D.tensorProduct E).toSubmodule =
      LinearMap.range (TensorProduct.mapIncl D.toSubmodule E.toSubmodule) := by
  rw [tensorProduct, CoalgHom.range_toSubmodule]
  change LinearMap.range
      (TensorProduct.AlgebraTensorModule.map D.toSubmodule.subtype E.toSubmodule.subtype) =
    LinearMap.range (TensorProduct.map D.toSubmodule.subtype E.toSubmodule.subtype)
  exact congrArg LinearMap.range (TensorProduct.AlgebraTensorModule.map_eq _ _)

/-- The underlying submodule is spanned by pure tensors with factors in the subcoalgebras. -/
theorem tensorProduct_toSubmodule_eq_span (D : Subcoalgebra K C)
    (E : Subcoalgebra K C') :
    (D.tensorProduct E).toSubmodule =
      Submodule.span K {z : C ⊗[K] C' | ∃ c ∈ D, ∃ c' ∈ E, c ⊗ₜ[K] c' = z} := by
  rw [tensorProduct_toSubmodule, TensorProduct.mapIncl,
    TensorProduct.range_map_eq_span_tmul]
  congr 1
  ext z
  constructor
  · rintro ⟨d, e, h⟩
    exact ⟨(d : C), d.property, (e : C'), e.property, h⟩
  · rintro ⟨c, hc, c', hc', h⟩
    exact ⟨⟨c, hc⟩, ⟨c', hc'⟩, h⟩

/-- Membership is equivalent to having an arbitrary tensor preimage under the inclusion. -/
@[simp]
theorem mem_tensorProduct (D : Subcoalgebra K C) (E : Subcoalgebra K C')
    {z : C ⊗[K] C'} :
    z ∈ D.tensorProduct E ↔
      ∃ t : D ⊗[K] E, TensorProduct.mapIncl D.toSubmodule E.toSubmodule t = z := by
  rw [(D.tensorProduct E).mem_iff, tensorProduct_toSubmodule]
  exact LinearMap.mem_range (f := TensorProduct.mapIncl D.toSubmodule E.toSubmodule)

/-- A pure tensor of members of the two subcoalgebras lies in their tensor product. -/
theorem tmul_mem_tensorProduct (D : Subcoalgebra K C) (E : Subcoalgebra K C')
    {c : C} {c' : C'} (hc : c ∈ D) (hc' : c' ∈ E) :
    c ⊗ₜ[K] c' ∈ D.tensorProduct E := by
  apply (mem_tensorProduct D E).2
  exact ⟨(⟨c, hc⟩ : D) ⊗ₜ[K] (⟨c', hc'⟩ : E), rfl⟩

/-- The range restriction of the tensor map has the expected ambient pure-tensor value. -/
theorem tensorProduct_subtype_rangeRestrict_tmul (D : Subcoalgebra K C)
    (E : Subcoalgebra K C') (d : D) (e : E) :
    (((Coalgebra.TensorProduct.map (R := K) (S := K) D.subtype E.subtype).rangeRestrict
      (d ⊗ₜ[K] e)) : C ⊗[K] C') = (d : C) ⊗ₜ[K] (e : C') := by
  simp only [CoalgHom.coe_rangeRestrict, Coalgebra.TensorProduct.map_tmul, subtype_apply]

/-- Containment in any submodule is equivalent to containing every generating pure tensor.
Taking the target submodule to be that of a subcoalgebra gives the least-subcoalgebra
property. -/
theorem tensorProduct_toSubmodule_le_iff (D : Subcoalgebra K C)
    (E : Subcoalgebra K C') (S : Submodule K (C ⊗[K] C')) :
    (D.tensorProduct E).toSubmodule ≤ S ↔
      ∀ c ∈ D, ∀ c' ∈ E, c ⊗ₜ[K] c' ∈ S := by
  rw [tensorProduct_toSubmodule_eq_span, Submodule.span_le]
  constructor
  · intro h c hc c' hc'
    exact h ⟨c, hc, c', hc', rfl⟩
  · rintro h z ⟨c, hc, c', hc', rfl⟩
    exact h c hc c' hc'

end Subcoalgebra

universe uK uA uB uC uD

open scoped TensorProduct

namespace TensorProduct

variable {K : Type uK} [Field K]
variable {A : Type uA} [AddCommMonoid A] [Module K A] [CoalgebraStruct K A]
variable {B : Type uB} [AddCommGroup B] [Module K B] [Coalgebra K B]
variable {C : Type uC} [AddCommMonoid C] [Module K C] [CoalgebraStruct K C]
variable {D : Type uD} [AddCommGroup D] [Module K D] [Coalgebra K D]

/-- The range of a tensor product of coalgebra homomorphisms lies in a subcoalgebra if and
only if every pure tensor of their values belongs to it. -/
theorem range_mapCoalgHom_le_iff (f : A →ₗc[K] B) (g : C →ₗc[K] D)
    (S : Subcoalgebra K (B ⊗[K] D)) :
    (mapCoalgHom f g).range ≤ S ↔ ∀ a c, f a ⊗ₜ[K] g c ∈ S := by
  rw [← Subcoalgebra.toSubmodule_le_toSubmodule, CoalgHom.range_toSubmodule]
  change LinearMap.range (AlgebraTensorModule.map f.toLinearMap g.toLinearMap) ≤
    S.toSubmodule ↔ _
  rw [AlgebraTensorModule.map_eq, range_map_eq_span_tmul, Submodule.span_le]
  constructor
  · intro h a c
    exact h ⟨a, c, rfl⟩
  · rintro h _ ⟨a, c, rfl⟩
    exact h a c

end TensorProduct
