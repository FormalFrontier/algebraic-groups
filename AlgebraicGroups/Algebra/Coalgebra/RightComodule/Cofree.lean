module

public import AlgebraicGroups.Algebra.Coalgebra.RightComodule.TensorProduct

/-!
# Cofree specified right comodules

For a coalgebra `C` over a commutative semiring `R` and an arbitrary `R`-module
`V`, `cofree R C V` is the specified right comodule on `V ⊗[R] C`. Its coaction
is the inverse associator after `id ⊗ Δ`. The construction reuses the external
tensor product of the scalar and regular comodules, followed by the coalgebra
left unitor; it introduces no new coaction-law engine.

`homCofreeEquiv` identifies colinear maps into this comodule with ordinary linear
maps into `V`, as an `R`-linear equivalence. Its inverse `cofreeLift` has underlying
map `(f ⊗ id) ∘ δ`. The canonical `coactionHom` is colinear and injective, and its
cogenerating projection is a left inverse **as a linear map only**. In general
that projection is not colinear, even when `V` already has a specified coaction.
The API includes both naturalities and adjunction triangles. At `V = R`, the
left unitor compares the construction with the existing regular comodule and
its coefficient correspondence (an ordinary equivalence).

All scalar, coalgebra, source and cogenerator universes are independent. No
field, flatness, projectivity, basis or finiteness hypothesis is imposed.

## References

The coaction embedding is inspired by J. S. Milne, *Algebraic Groups* (2017),
Proposition 4.12; here its cofree universal property is developed over a
commutative semiring rather than just a field. For classical comodules see
M. E. Sweedler, *Hopf Algebras* (1969). The specified-comodule, external-tensor
and coefficient constructions are by Formal Frontier Agents. Tensor maps,
associators and unitors follow Mathlib's formalizations by Kenny Lau and Mario
Carneiro; its tensor coalgebra and coalgebra unitors are by Amelia Livingston
and Andrew Yang.
-/

@[expose] public section

noncomputable section

universe uR uC uM uN uV uW

open scoped TensorProduct

namespace Coalgebra.RightComodule

variable (R : Type uR) (C : Type uC) (V : Type uV)
variable [CommSemiring R] [AddCommMonoid C] [Module R C] [Coalgebra R C]
variable [AddCommMonoid V] [Module R V]

/-- The cofree specified right `C`-comodule cogenerated by the module `V`. -/
def cofree : RightComodule R C (V ⊗[R] C) :=
  ((scalar R V).externalTensor (regular R C)).mapCoalgebra
    (Coalgebra.TensorProduct.lid R C).toCoalgHom

/-- The full cofree coaction: apply comultiplication in the second factor,
then the inverse associator. The value of comultiplication need not be pure. -/
theorem cofree_coaction :
    (cofree R C V).coaction =
      (_root_.TensorProduct.assoc R V C C).symm.toLinearMap ∘ₗ
        (Coalgebra.comul (R := R) (A := C)).lTensor V := by
  have hlid : (Coalgebra.TensorProduct.lid R C).toCoalgHom.toLinearMap =
      (_root_.TensorProduct.lid R C).toLinearMap :=
    congrArg LinearEquiv.toLinearMap
      (Coalgebra.TensorProduct.lid_toLinearEquiv (R := R) (P := C))
  apply _root_.TensorProduct.ext'
  intro v c
  have h :
      (_root_.TensorProduct.lid R C).toLinearMap.lTensor (V ⊗[R] C) ∘ₗ
          (_root_.TensorProduct.tensorTensorTensorComm R V R C C).toLinearMap ∘ₗ
          _root_.TensorProduct.mk R (V ⊗[R] R) (C ⊗[R] C) (v ⊗ₜ[R] 1) =
        (_root_.TensorProduct.assoc R V C C).symm.toLinearMap ∘ₗ
          _root_.TensorProduct.mk R V (C ⊗[R] C) v := by
    apply _root_.TensorProduct.ext'
    intro c₁ c₂
    simp
  simpa only [cofree, mapCoalgebra_coaction, externalTensor_coaction,
    externalTensorCoaction, LinearMap.comp_apply, _root_.TensorProduct.map_tmul,
    scalar_coaction, regular_coaction, LinearMap.lTensor_tmul,
    _root_.TensorProduct.mk_apply, hlid] using
    LinearMap.congr_fun h (Coalgebra.comul (R := R) c)

/-- Coaction on a pure input, retaining the entire comultiplication value. -/
@[simp] theorem cofree_coaction_tmul (v : V) (c : C) :
    (cofree R C V).coaction (v ⊗ₜ[R] c) =
      (_root_.TensorProduct.assoc R V C C).symm
        (v ⊗ₜ[R] Coalgebra.comul (R := R) c) := by
  rw [cofree_coaction]
  rfl

/-- The ordinary linear projection to the cogenerating module. It is not in
general a comodule morphism. -/
def cofreeProjection : V ⊗[R] C →ₗ[R] V :=
  (_root_.TensorProduct.rid R V).toLinearMap ∘ₗ
    (Coalgebra.counit (R := R) (A := C)).lTensor V

/-- Projecting a pure tensor contracts its coalgebra factor by the counit. -/
@[simp] theorem cofreeProjection_tmul (v : V) (c : C) :
    cofreeProjection R C V (v ⊗ₜ[R] c) = Coalgebra.counit (R := R) c • v := by
  simp [cofreeProjection]

variable {R C V}
variable {M : Type uM} {N : Type uN} {W : Type uW}
variable [AddCommMonoid M] [Module R M] [AddCommMonoid N] [Module R N]
variable [AddCommMonoid W] [Module R W]

/-- The cofree coaction is natural in the cogenerating module. -/
theorem cofree_coaction_natural (f : M →ₗ[R] V) :
    (cofree R C V).coaction ∘ₗ f.rTensor C =
      (f.rTensor C).rTensor C ∘ₗ (cofree R C M).coaction := by
  have h := _root_.TensorProduct.map_map_comp_assoc_symm_eq f
    (LinearMap.id : C →ₗ[R] C) (LinearMap.id : C →ₗ[R] C)
  simp only [← LinearMap.rTensor_def, LinearMap.rTensor_id] at h
  rw [cofree_coaction, cofree_coaction, LinearMap.comp_assoc,
    LinearMap.lTensor_comp_rTensor, ← LinearMap.rTensor_comp_lTensor,
    ← LinearMap.comp_assoc, ← h, LinearMap.comp_assoc]

/-- Comultiplication on the cofree target packages the source coassociativity. -/
theorem cofree_coaction_comp (X : RightComodule R C M) :
    (cofree R C M).coaction ∘ₗ X.coaction =
      X.coaction.rTensor C ∘ₗ X.coaction := by
  ext m
  simpa only [cofree_coaction, LinearMap.comp_apply, LinearEquiv.coe_coe] using
    X.coassoc_symm_apply m

/-- The projection is natural in arbitrary linear maps of cogenerators. -/
theorem cofreeProjection_natural (f : M →ₗ[R] V) :
    cofreeProjection R C V ∘ₗ f.rTensor C = f ∘ₗ cofreeProjection R C M := by
  apply _root_.TensorProduct.ext'
  intro m c
  simp

/-- The source's right counit is the first adjunction triangle, on linear maps. -/
@[simp] theorem cofreeProjection_comp_coaction (X : RightComodule R C M) :
    cofreeProjection R C M ∘ₗ X.coaction = LinearMap.id := by
  ext m
  exact X.rid_counit_coaction m

/-- Contracting the first coalgebra factor of the cofree coaction is the
identity. This uses the coalgebra's left counit. -/
@[simp] theorem cofreeProjection_rTensor_comp_coaction :
    (cofreeProjection R C V).rTensor C ∘ₗ (cofree R C V).coaction = LinearMap.id := by
  apply _root_.TensorProduct.ext'
  intro v c
  have h :
      (cofreeProjection R C V).rTensor C ∘ₗ
          (_root_.TensorProduct.assoc R V C C).symm.toLinearMap ∘ₗ
          _root_.TensorProduct.mk R V (C ⊗[R] C) v =
        _root_.TensorProduct.mk R V C v ∘ₗ
          (_root_.TensorProduct.lid R C).toLinearMap ∘ₗ
          (Coalgebra.counit (R := R) (A := C)).rTensor C := by
    apply _root_.TensorProduct.ext'
    intro c₁ c₂
    simp [_root_.TensorProduct.smul_tmul']
  simpa only [LinearMap.comp_apply, cofree_coaction_tmul,
    Coalgebra.rTensor_counit_comul, LinearEquiv.coe_coe,
    _root_.TensorProduct.lid_tmul, one_smul, _root_.TensorProduct.mk_apply,
    LinearMap.id_apply] using LinearMap.congr_fun h (Coalgebra.comul (R := R) c)

/-- The colinear lift of an arbitrary linear map to the cogenerating module. -/
def cofreeLift (X : RightComodule R C M) (f : M →ₗ[R] V) :
    RightComoduleHom X (cofree R C V) where
  toLinearMap := f.rTensor C ∘ₗ X.coaction
  colinear := by
    rw [← LinearMap.comp_assoc, cofree_coaction_natural, LinearMap.comp_assoc,
      cofree_coaction_comp, LinearMap.rTensor_comp, LinearMap.comp_assoc]

/-- The underlying lift is exactly `(f ⊗ id) ∘ δ`. -/
@[simp] theorem cofreeLift_toLinearMap (X : RightComodule R C M) (f : M →ₗ[R] V) :
    (X.cofreeLift f).toLinearMap = f.rTensor C ∘ₗ X.coaction := rfl

/-- Evaluate the lift on any source element. -/
@[simp] theorem cofreeLift_apply (X : RightComodule R C M) (f : M →ₗ[R] V) (m : M) :
    X.cofreeLift f m = f.rTensor C (X.coaction m) := rfl

/-- Projecting a lift recovers the same linear map. -/
@[simp↓] theorem cofreeProjection_comp_cofreeLift (X : RightComodule R C M)
    (f : M →ₗ[R] V) :
    cofreeProjection R C V ∘ₗ (X.cofreeLift f).toLinearMap = f := by
  rw [cofreeLift_toLinearMap, ← LinearMap.comp_assoc, cofreeProjection_natural,
    LinearMap.comp_assoc, cofreeProjection_comp_coaction, LinearMap.comp_id]

/-- The projection-after-lift normal form on elements. -/
@[simp↓] theorem cofreeProjection_cofreeLift (X : RightComodule R C M)
    (f : M →ₗ[R] V) (m : M) :
    cofreeProjection R C V (X.cofreeLift f m) = f m :=
  LinearMap.congr_fun (X.cofreeProjection_comp_cofreeLift f) m

/-- Every colinear map into a cofree comodule is recovered from its projection. -/
@[simp] theorem cofreeLift_projection (X : RightComodule R C M)
    (g : RightComoduleHom X (cofree R C V)) :
    X.cofreeLift (cofreeProjection R C V ∘ₗ g.toLinearMap) = g := by
  apply RightComoduleHom.toLinearMap_injective
  dsimp only
  rw [cofreeLift_toLinearMap, LinearMap.rTensor_comp, LinearMap.comp_assoc,
    ← g.colinear, ← LinearMap.comp_assoc, cofreeProjection_rTensor_comp_coaction,
    LinearMap.id_comp]

/-- The cofree universal property, linear over the commutative semiring.
The inverse is the explicit lift, not a choice of a factorization. -/
def homCofreeEquiv (X : RightComodule R C M) (V : Type uV)
    [AddCommMonoid V] [Module R V] :
    RightComoduleHom X (cofree R C V) ≃ₗ[R] (M →ₗ[R] V) where
  toFun g := cofreeProjection R C V ∘ₗ g.toLinearMap
  invFun f := X.cofreeLift f
  left_inv := X.cofreeLift_projection
  right_inv := X.cofreeProjection_comp_cofreeLift
  map_add' g h := by simp [LinearMap.comp_add]
  map_smul' r g := by simp [LinearMap.comp_smul]

/-- The universal correspondence is projection after the underlying map. -/
@[simp] theorem homCofreeEquiv_apply (X : RightComodule R C M)
    (g : RightComoduleHom X (cofree R C V)) :
    X.homCofreeEquiv V g = cofreeProjection R C V ∘ₗ g.toLinearMap := rfl

/-- The inverse universal correspondence is the explicit colinear lift. -/
@[simp] theorem homCofreeEquiv_symm_apply (X : RightComodule R C M) (f : M →ₗ[R] V) :
    (X.homCofreeEquiv V).symm f = X.cofreeLift f := rfl

/-- Maps into cofree comodules are determined by their projection. -/
theorem hom_cofree_ext (X : RightComodule R C M)
    {g h : RightComoduleHom X (cofree R C V)}
    (heq : cofreeProjection R C V ∘ₗ g.toLinearMap =
      cofreeProjection R C V ∘ₗ h.toLinearMap) : g = h :=
  (X.homCofreeEquiv V).injective heq

/-- Every linear cogenerator map has exactly one colinear lift. -/
theorem existsUnique_cofreeLift (X : RightComodule R C M) (f : M →ₗ[R] V) :
    ∃! g : RightComoduleHom X (cofree R C V),
      cofreeProjection R C V ∘ₗ g.toLinearMap = f := by
  refine ⟨X.cofreeLift f, X.cofreeProjection_comp_cofreeLift f, ?_⟩
  intro g hg
  exact X.hom_cofree_ext (hg.trans (X.cofreeProjection_comp_cofreeLift f).symm)

/-- The canonical colinear coaction embedding into the cofree comodule on the
underlying module. Its splitting below is only linear. -/
def coactionHom (X : RightComodule R C M) : RightComoduleHom X (cofree R C M) :=
  X.cofreeLift LinearMap.id

/-- The embedding's underlying map is the original full coaction. -/
@[simp] theorem coactionHom_toLinearMap (X : RightComodule R C M) :
    X.coactionHom.toLinearMap = X.coaction := by
  simp [coactionHom, LinearMap.rTensor_id]

/-- The coaction embedding evaluates to the original coaction. -/
@[simp] theorem coactionHom_apply (X : RightComodule R C M) (m : M) :
    X.coactionHom m = X.coaction m :=
  LinearMap.congr_fun X.coactionHom_toLinearMap m

/-- Injectivity is the existing counital injectivity of a specified coaction. -/
theorem coactionHom_injective (X : RightComodule R C M) :
    Function.Injective X.coactionHom := by
  intro m n h
  apply X.coaction_injective
  simpa only [coactionHom_apply] using h

/-- The first triangle exhibits a split linear injection;
no colinear retraction is asserted. -/
@[simp↓] theorem cofreeProjection_comp_coactionHom (X : RightComodule R C M) :
    cofreeProjection R C M ∘ₗ X.coactionHom.toLinearMap = LinearMap.id := by
  rw [coactionHom_toLinearMap, cofreeProjection_comp_coaction]

/-- Projecting the canonical coaction embedding recovers its source element. -/
@[simp↓] theorem cofreeProjection_coactionHom (X : RightComodule R C M) (m : M) :
    cofreeProjection R C M (X.coactionHom m) = m :=
  LinearMap.congr_fun (cofreeProjection_comp_coactionHom X) m

/-- The cofree morphism induced by an arbitrary linear map of cogenerators. -/
def cofreeMap (k : V →ₗ[R] W) : RightComoduleHom (cofree R C V) (cofree R C W) :=
  (cofree R C V).cofreeLift (k ∘ₗ cofreeProjection R C V)

/-- The induced morphism has underlying map `k ⊗ id`. -/
@[simp] theorem cofreeMap_toLinearMap (k : V →ₗ[R] W) :
    (cofreeMap (C := C) k).toLinearMap = k.rTensor C := by
  rw [cofreeMap, cofreeLift_toLinearMap, LinearMap.rTensor_comp, LinearMap.comp_assoc,
    cofreeProjection_rTensor_comp_coaction, LinearMap.comp_id]

/-- Evaluate the induced cofree morphism on any tensor. -/
@[simp] theorem cofreeMap_apply (k : V →ₗ[R] W) (t : V ⊗[R] C) :
    cofreeMap (C := C) k t = k.rTensor C t :=
  LinearMap.congr_fun (cofreeMap_toLinearMap k) t

/-- On pure tensors only the cogenerator factor changes. -/
@[simp↓] theorem cofreeMap_tmul (k : V →ₗ[R] W) (v : V) (c : C) :
    cofreeMap (C := C) k (v ⊗ₜ[R] c) = k v ⊗ₜ[R] c := by simp

/-- Cofree preserves identities as bundled comodule maps. -/
@[simp] theorem cofreeMap_id :
    cofreeMap (C := C) (LinearMap.id : V →ₗ[R] V) = RightComoduleHom.id (cofree R C V) := by
  apply RightComoduleHom.toLinearMap_injective
  simp [RightComoduleHom.id, LinearMap.rTensor_id]

/-- Cofree preserves composition as bundled comodule maps. -/
theorem cofreeMap_comp (k : V →ₗ[R] W) (f : M →ₗ[R] V) :
    cofreeMap (C := C) (k ∘ₗ f) = (cofreeMap k).comp (cofreeMap f) := by
  apply RightComoduleHom.toLinearMap_injective
  simp [RightComoduleHom.comp, LinearMap.rTensor_comp]

/-- Projection is natural for the bundled cofree maps. -/
@[simp↓] theorem cofreeProjection_comp_cofreeMap (k : V →ₗ[R] W) :
    cofreeProjection R C W ∘ₗ (cofreeMap (C := C) k).toLinearMap =
      k ∘ₗ cofreeProjection R C V := by
  rw [cofreeMap_toLinearMap, cofreeProjection_natural]

/-- Lifting is natural under precomposition by a colinear map. -/
theorem cofreeLift_comp (X : RightComodule R C M) (Y : RightComodule R C N)
    (f : N →ₗ[R] V) (h : RightComoduleHom X Y) :
    X.cofreeLift (f ∘ₗ h.toLinearMap) = (Y.cofreeLift f).comp h := by
  apply RightComoduleHom.toLinearMap_injective
  simp only [cofreeLift_toLinearMap, RightComoduleHom.comp,
    LinearMap.rTensor_comp, LinearMap.comp_assoc]
  rw [← h.colinear]

/-- Lifting is natural under postcomposition in the cogenerating module. -/
@[simp] theorem cofreeMap_comp_cofreeLift (X : RightComodule R C M)
    (f : M →ₗ[R] V) (k : V →ₗ[R] W) :
    (cofreeMap k).comp (X.cofreeLift f) = X.cofreeLift (k ∘ₗ f) := by
  apply RightComoduleHom.toLinearMap_injective
  simp [RightComoduleHom.comp, LinearMap.rTensor_comp, LinearMap.comp_assoc]

/-- The universal correspondence is natural in both variables. -/
theorem homCofreeEquiv_natural (X : RightComodule R C M) (Y : RightComodule R C N)
    (g : RightComoduleHom Y (cofree R C V)) (h : RightComoduleHom X Y)
    (k : V →ₗ[R] W) :
    X.homCofreeEquiv W ((cofreeMap k).comp (g.comp h)) =
      k ∘ₗ Y.homCofreeEquiv V g ∘ₗ h.toLinearMap := by
  simp only [homCofreeEquiv_apply, RightComoduleHom.comp]
  rw [← LinearMap.comp_assoc, cofreeProjection_comp_cofreeMap]
  simp only [LinearMap.comp_assoc]

/-- The canonical embedding is natural in colinear maps. -/
theorem coactionHom_natural {X : RightComodule R C M} {Y : RightComodule R C N}
    (h : RightComoduleHom X Y) :
    (cofreeMap h.toLinearMap).comp X.coactionHom = Y.coactionHom.comp h := by
  apply RightComoduleHom.toLinearMap_injective
  simpa only [RightComoduleHom.comp, cofreeMap_toLinearMap,
    coactionHom_toLinearMap] using h.colinear.symm

/-- The second triangle is an equality of bundled comodule maps. -/
@[simp] theorem cofreeMap_projection_comp_coactionHom :
    (cofreeMap (cofreeProjection R C V)).comp (cofree R C V).coactionHom =
      RightComoduleHom.id (cofree R C V) := by
  apply RightComoduleHom.toLinearMap_injective
  simpa only [RightComoduleHom.comp, cofreeMap_toLinearMap,
    coactionHom_toLinearMap, RightComoduleHom.id] using
    (cofreeProjection_rTensor_comp_coaction (R := R) (C := C) (V := V))

/-- At the scalar cogenerator the left unitor is a morphism to the existing
regular comodule. -/
def cofreeToRegular : RightComoduleHom (cofree R C R) (regular R C) where
  toLinearMap := (_root_.TensorProduct.lid R C).toLinearMap
  colinear := by
    apply _root_.TensorProduct.ext'
    intro r c
    have h :
        (_root_.TensorProduct.lid R C).toLinearMap.rTensor C ∘ₗ
            (_root_.TensorProduct.assoc R R C C).symm.toLinearMap ∘ₗ
            _root_.TensorProduct.mk R R (C ⊗[R] C) r =
          r • (LinearMap.id : C ⊗[R] C →ₗ[R] C ⊗[R] C) := by
      apply _root_.TensorProduct.ext'
      intro c₁ c₂
      simp [_root_.TensorProduct.smul_tmul']
    simpa only [LinearMap.comp_apply, regular_coaction, LinearEquiv.coe_coe,
      _root_.TensorProduct.lid_tmul, map_smul, cofree_coaction_tmul,
      LinearMap.smul_apply, LinearMap.id_apply, _root_.TensorProduct.mk_apply] using
      (LinearMap.congr_fun h (Coalgebra.comul (R := R) c)).symm

/-- The scalar comparison has underlying left unitor. -/
@[simp] theorem cofreeToRegular_toLinearMap :
    (cofreeToRegular (R := R) (C := C)).toLinearMap =
      (_root_.TensorProduct.lid R C).toLinearMap := rfl

/-- The scalar comparison evaluates to the left unitor. -/
@[simp] theorem cofreeToRegular_apply (t : R ⊗[R] C) :
    cofreeToRegular (R := R) (C := C) t = _root_.TensorProduct.lid R C t := rfl

/-- The inverse left unitor is also colinear. -/
def regularToCofree : RightComoduleHom (regular R C) (cofree R C R) where
  toLinearMap := (_root_.TensorProduct.lid R C).symm.toLinearMap
  colinear := RightComoduleHom.colinear_symm (_root_.TensorProduct.lid R C)
    (cofreeToRegular (R := R) (C := C)).colinear

/-- The inverse scalar comparison has underlying inverse left unitor. -/
@[simp] theorem regularToCofree_toLinearMap :
    (regularToCofree (R := R) (C := C)).toLinearMap =
      (_root_.TensorProduct.lid R C).symm.toLinearMap := rfl

/-- The inverse scalar comparison inserts the scalar unit. -/
@[simp] theorem regularToCofree_apply (c : C) :
    regularToCofree (R := R) (C := C) c = 1 ⊗ₜ[R] c := rfl

/-- The scalar comparison and its inverse cancel on the regular comodule. -/
@[simp] theorem cofreeToRegular_comp_regularToCofree :
    (cofreeToRegular (R := R) (C := C)).comp regularToCofree =
      RightComoduleHom.id (regular R C) := by
  ext c
  exact (_root_.TensorProduct.lid R C).apply_symm_apply c

/-- The inverse comparison cancels on the scalar-cogenerated cofree comodule. -/
@[simp] theorem regularToCofree_comp_cofreeToRegular :
    (regularToCofree (R := R) (C := C)).comp cofreeToRegular =
      RightComoduleHom.id (cofree R C R) := by
  ext t
  exact (_root_.TensorProduct.lid R C).symm_apply_apply t

/-- The counit of the scalar comparison is the cofree projection. -/
@[simp↓] theorem counit_comp_cofreeToRegular :
    Coalgebra.counit (R := R) ∘ₗ (cofreeToRegular (R := R) (C := C)).toLinearMap =
      cofreeProjection R C R := by
  apply _root_.TensorProduct.ext'
  intro r c
  simp [mul_comm]

/-- The scalar-cogenerated lift transports to the existing coefficient morphism. -/
@[simp] theorem cofreeToRegular_comp_cofreeLift (X : RightComodule R C M)
    (ell : M →ₗ[R] R) :
    cofreeToRegular.comp (X.cofreeLift ell) = X.coefficientHom ell := by
  apply X.hom_regular_ext
  simp only [RightComoduleHom.comp, ← LinearMap.comp_assoc,
    counit_comp_cofreeToRegular, cofreeProjection_comp_cofreeLift,
    counit_comp_coefficientHom]

/-- Comparison with the existing ordinary regular-target equivalence.
No linear-equivalence structure on `homRegularEquiv` is presumed. -/
theorem homRegularEquiv_cofreeToRegular (X : RightComodule R C M)
    (g : RightComoduleHom X (cofree R C R)) :
    X.homRegularEquiv (cofreeToRegular.comp g) = X.homCofreeEquiv R g := by
  simp only [homRegularEquiv_apply, homCofreeEquiv_apply, RightComoduleHom.comp,
    ← LinearMap.comp_assoc, counit_comp_cofreeToRegular]

end Coalgebra.RightComodule
