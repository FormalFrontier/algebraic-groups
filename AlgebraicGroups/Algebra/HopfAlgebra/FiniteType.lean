/-!
# Finite-type Hopf subalgebras

A finite subset of a Hopf algebra over a field with involutive antipode lies in a
finite-type Hopf subalgebra. In particular, this holds for commutative Hopf algebras.

Comultiplication stability of an antipode-generated subalgebra is proved first over
a commutative semiring. This part needs neither a finite-dimensional submodule nor
an involutive antipode. Finiteness enters through the finite-subcoalgebra theorem
over a field, and involutivity supplies antipode stability.

## References

* J. S. Milne, *Algebraic Groups* (2017), §3.
-/

@[expose] public section

open scoped TensorProduct

universe u v

/-- Comultiplication stability extends from a submodule to the subalgebra
generated by it and its antipode image. -/
theorem Submodule.comul_mem_adjoin_union_antipode
    {R : Type u} {H : Type v}
    [CommSemiring R] [Semiring H] [HopfAlgebra R H]
    (P : Submodule R H)
    (hP : ∀ ⦃x : H⦄, x ∈ P →
      Coalgebra.comul (R := R) x ∈
        LinearMap.range (TensorProduct.mapIncl P P)) :
    let A := Algebra.adjoin R
      ((P : Set H) ∪ (HopfAlgebra.antipode R : H → H) '' (P : Set H))
    ∀ a : A, Coalgebra.comul (R := R) (a : H) ∈
      LinearMap.range
        (TensorProduct.map A.val.toLinearMap A.val.toLinearMap) := by
  let A : Subalgebra R H := Algebra.adjoin R
    ((P : Set H) ∪ (HopfAlgebra.antipode R : H → H) '' (P : Set H))
  change ∀ a : A, Coalgebra.comul (R := R) (a : H) ∈
    LinearMap.range
      (TensorProduct.map A.val.toLinearMap A.val.toLinearMap)
  let S : H →ₗ[R] H := HopfAlgebra.antipode R
  have hPA : ∀ ⦃x : H⦄, x ∈ P → x ∈ A := by
    intro x hx
    exact Algebra.subset_adjoin (Or.inl hx)
  have hSA : ∀ ⦃x : H⦄, x ∈ P → S x ∈ A := by
    intro x hx
    exact Algebra.subset_adjoin (Or.inr ⟨x, hx, rfl⟩)
  let i : P →ₗ[R] A :=
    { toFun := fun x => ⟨(x : H), hPA x.property⟩
      map_add' := by
        intro x y
        apply Subtype.ext
        rfl
      map_smul' := by
        intro r x
        apply Subtype.ext
        rfl }
  let j : P →ₗ[R] A :=
    { toFun := fun x => ⟨S (x : H), hSA x.property⟩
      map_add' := by
        intro x y
        apply Subtype.ext
        change S ((x : H) + (y : H)) = S (x : H) + S (y : H)
        exact S.map_add (x : H) (y : H)
      map_smul' := by
        intro r x
        apply Subtype.ext
        change S (r • (x : H)) = r • S (x : H)
        exact S.map_smul r (x : H) }
  let g : A ⊗[R] A →ₐ[R] H ⊗[R] H :=
    Algebra.TensorProduct.map A.val A.val
  let Q : Subalgebra R (H ⊗[R] H) := g.range
  have hg : g.toLinearMap =
      TensorProduct.map A.val.toLinearMap A.val.toLinearMap := by
    apply TensorProduct.ext'
    intro x y
    rfl
  have hi : g.toLinearMap.comp (TensorProduct.map i i) =
      TensorProduct.mapIncl P P := by
    apply TensorProduct.ext'
    intro x y
    rfl
  have hj :
      g.toLinearMap.comp
        ((TensorProduct.map j j).comp
          (TensorProduct.comm R P P).toLinearMap) =
      (TensorProduct.map S S).comp
        ((TensorProduct.comm R H H).toLinearMap.comp
          (TensorProduct.mapIncl P P)) := by
    apply TensorProduct.ext'
    intro x y
    rfl
  have hPq : ∀ ⦃x : H⦄, x ∈ P →
      Coalgebra.comul (R := R) x ∈ Q := by
    intro x hx
    apply (AlgHom.mem_range g).2
    rcases hP hx with ⟨t, ht⟩
    refine ⟨TensorProduct.map i i t, ?_⟩
    exact (LinearMap.congr_fun hi t).trans ht
  have hSq : ∀ ⦃x : H⦄, x ∈ P →
      Coalgebra.comul (R := R) (S x) ∈ Q := by
    intro x hx
    apply (AlgHom.mem_range g).2
    rcases hP hx with ⟨t, ht⟩
    refine ⟨TensorProduct.map j j (TensorProduct.comm R P P t), ?_⟩
    calc
      g (TensorProduct.map j j (TensorProduct.comm R P P t)) =
          TensorProduct.map S S
            (TensorProduct.comm R H H (TensorProduct.mapIncl P P t)) :=
        LinearMap.congr_fun hj t
      _ = TensorProduct.map S S
            (TensorProduct.comm R H H (Coalgebra.comul (R := R) x)) := by
        rw [ht]
      _ = Coalgebra.comul (R := R) (S x) :=
        (HopfAlgebra.comul_antipode (R := R) x).symm
  have hA : A ≤ Q.comap (Bialgebra.comulAlgHom R H) := by
    apply Algebra.adjoin_le
    intro x hx
    rcases hx with hx | ⟨y, hy, rfl⟩
    · exact hPq hx
    · exact hSq hy
  intro a
  have ha : Bialgebra.comulAlgHom R H (a : H) ∈ Q := hA a.property
  rcases (AlgHom.mem_range g).1 ha with ⟨t, ht⟩
  refine ⟨t, ?_⟩
  exact (LinearMap.congr_fun hg t).symm.trans ht

/-- Every finite subset of a Hopf algebra over a field with involutive antipode
lies in a finite-type Hopf subalgebra. This extends the commutative-Hopf argument
in Milne, *Algebraic Groups* (2017), §3. -/
theorem Subalgebra.exists_finiteType_isHopfSubalgebra_of_finite
    {K : Type u} {H : Type v} [Field K] [Semiring H] [HopfAlgebra K H]
    (hι : Function.Involutive (HopfAlgebra.antipode K : H → H))
    {s : Set H} (hs : s.Finite) :
    ∃ A : Subalgebra K H,
      A.IsHopfSubalgebra ∧ Algebra.FiniteType K A ∧ s ⊆ (A : Set H) := by
  classical
  let G : AddCommGroup H :=
    @Module.addCommMonoidToAddCommGroup K H
      (inferInstance : Ring K)
      (inferInstance : AddCommMonoid H)
      (inferInstance : Module K H)
  obtain ⟨C, hsC, hCfinite⟩ :=
    @Coalgebra.exists_finite_subcoalgebra_of_finite K H
      (inferInstance : Field K) G
      (inferInstance : Module K H)
      (inferInstance : Coalgebra K H) s hs
  let P : Submodule K H := C.toSubmodule
  have hPfg : P.FG :=
    (Module.Finite.iff_fg (R := K) (N := P)).mp hCfinite
  let A : Subalgebra K H := Algebra.adjoin K
    ((P : Set H) ∪ (HopfAlgebra.antipode K : H → H) '' (P : Set H))
  have hDeltaA : ∀ a : A, Coalgebra.comul (R := K) (a : H) ∈
      LinearMap.range
        (TensorProduct.map A.val.toLinearMap A.val.toLinearMap) := by
    exact Submodule.comul_mem_adjoin_union_antipode
      (R := K) C.toSubmodule C.comul_mem'
  have hSA : ∀ a : A, HopfAlgebra.antipode K (a : H) ∈ A := by
    intro a
    exact HopfAlgebra.antipode_mem_adjoin_union_image
      (R := K) hι a.property
  have hA : A.IsHopfSubalgebra :=
    { comul_mem := hDeltaA, antipode_mem := hSA }
  have hspan :
      Submodule.span K
        ((P : Set H) ∪ HopfAlgebra.antipode K '' (P : Set H)) =
      P ⊔ P.map (HopfAlgebra.antipode K) := by
    simp only [Submodule.span_union, Submodule.span_image, Submodule.span_eq]
  have hsum : (P ⊔ P.map (HopfAlgebra.antipode K)).FG :=
    hPfg.sup (hPfg.map (HopfAlgebra.antipode K))
  obtain ⟨t, ht, h_t⟩ := Submodule.fg_def.mp hsum
  have hAFG : A.FG := by
    change (Algebra.adjoin K
      ((P : Set H) ∪ HopfAlgebra.antipode K '' (P : Set H))).FG
    refine Subalgebra.fg_def.mpr ⟨t, ht, ?_⟩
    calc
      Algebra.adjoin K t =
          Algebra.adjoin K (Submodule.span K t : Set H) :=
        (Algebra.adjoin_span (R := K) (s := t)).symm
      _ = Algebra.adjoin K
          (Submodule.span K
            ((P : Set H) ∪ HopfAlgebra.antipode K '' (P : Set H)) : Set H) := by
        rw [h_t, hspan]
      _ = Algebra.adjoin K
          ((P : Set H) ∪ HopfAlgebra.antipode K '' (P : Set H)) :=
        Algebra.adjoin_span K
  have hAfiniteType : Algebra.FiniteType K A :=
    (Subalgebra.fg_iff_finiteType A).mp hAFG
  refine ⟨A, hA, hAfiniteType, ?_⟩
  intro x hx
  exact Algebra.subset_adjoin (Or.inl (hsC hx))

/-- Every finite subset of a commutative Hopf algebra over a field lies in
a finite-type Hopf subalgebra; see Milne, *Algebraic Groups* (2017), §3. -/
theorem Subalgebra.exists_finiteType_isHopfSubalgebra_of_finite_of_commutative
    {K : Type u} {H : Type v}
    [Field K] [CommSemiring H] [HopfAlgebra K H]
    {s : Set H} (hs : s.Finite) :
    ∃ A : Subalgebra K H,
      A.IsHopfSubalgebra ∧ Algebra.FiniteType K A ∧ s ⊆ (A : Set H) := by
  exact Subalgebra.exists_finiteType_isHopfSubalgebra_of_finite
    (K := K) (H := H)
    (HopfAlgebra.antipode_involutive (R := K) (A := H)) hs
