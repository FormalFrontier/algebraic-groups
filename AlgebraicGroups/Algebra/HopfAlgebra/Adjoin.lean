module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.RingTheory.HopfAlgebra.Convolution

/-!
# Antipodes and generated subalgebras

An antipode sends the algebra generated by a set into the algebra generated by its image.
If the antipode is involutive, adjoining a set together with its antipode image gives an
antipode-stable subalgebra. The carrier algebra need not be commutative.
-/

@[expose] public section

universe u v

namespace HopfAlgebra

variable {R : Type u} {H : Type v} [CommSemiring R] [Semiring H] [HopfAlgebra R H]

/-- An antipode sends elements of a generated subalgebra into the algebra generated by the
antipode image of its generating set. -/
theorem antipode_mem_adjoin_image {s : Set H} {x : H}
    (hx : x ∈ Algebra.adjoin R s) :
    antipode R x ∈ Algebra.adjoin R ((antipode R : H → H) '' s) := by
  let A : Subalgebra R H := Algebra.adjoin R ((antipode R : H → H) '' s)
  change antipode R x ∈ A
  refine Algebra.adjoin_induction
    (p := fun y _ => antipode R y ∈ A)
    (mem := ?_) (algebraMap := ?_) (add := ?_) (mul := ?_) hx
  · intro y hy
    exact Algebra.subset_adjoin ⟨y, hy, rfl⟩
  · intro r
    have hr : r • (1 : H) = algebraMap R H r := by
      rw [Algebra.smul_def, mul_one]
    simpa only [← hr, map_smul, antipode_one] using A.algebraMap_mem r
  · intro y z _ _ ihy ihz
    simpa only [map_add] using A.add_mem ihy ihz
  · intro y z _ _ ihy ihz
    simpa only [antipode_mul_antidistrib] using A.mul_mem ihz ihy

/-- For an involutive antipode, adjoining a set and its antipode image gives a subalgebra
stable under the antipode. -/
theorem antipode_mem_adjoin_union_image
    (hS : Function.Involutive (antipode R : H → H)) {s : Set H} {x : H}
    (hx : x ∈ Algebra.adjoin R (s ∪ (antipode R : H → H) '' s)) :
    antipode R x ∈ Algebra.adjoin R (s ∪ (antipode R : H → H) '' s) := by
  have hs :
      (antipode R : H → H) '' (s ∪ (antipode R : H → H) '' s) ⊆
        s ∪ (antipode R : H → H) '' s := by
    rintro y ⟨z, hz, rfl⟩
    rcases hz with hz | ⟨w, hw, rfl⟩
    · exact Or.inr ⟨z, hz, rfl⟩
    · rw [hS w]
      exact Or.inl hw
  exact Algebra.adjoin_mono hs (antipode_mem_adjoin_image hx)

end HopfAlgebra
