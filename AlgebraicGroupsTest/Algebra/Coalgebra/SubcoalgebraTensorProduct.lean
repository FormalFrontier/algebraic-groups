module

public import AlgebraicGroups.Algebra.Coalgebra.Subcoalgebra.TensorProduct
public import AlgebraicGroupsTest.Algebra.Coalgebra.SubcoalgebraDiagonal

/-!
# Tensoring a finite proper part of a diagonal coalgebra

For every field `K`, choose the subcoalgebra of `ℕ →₀ K` supported on `{0, 1}` using
`Coalgebra.exists_finite_proper_subcoalgebra_finsupp_nat`. Tensoring this same subcoalgebra
with itself gives a nonzero proper subcoalgebra of the tensor square. Its underlying
submodule is generated by the four coordinate tensors with indices in `{0, 1}`.

Coordinate evaluation on both factors, followed by the scalar tensor unitor, detects a
nonzero member and excludes a tensor with first coordinate index `2`. The latter map
vanishes on the entire tensor subcoalgebra; its kernel is used only as a submodule.
The sum of the two diagonal coordinate tensors illustrates membership by a general
tensor preimage rather than by a single pair of factors.

## References

The subcoalgebra and tensor-image APIs are those of this project. The coordinate maps,
supported submodules and tensor maps use Mathlib's Finsupp and tensor-product APIs,
including work of Mario Carneiro, Kenny Lau, Amelia Livingston and Andrew Yang.
Only the public existence theorem of `SubcoalgebraDiagonal` is used to choose the factors.
-/

@[expose] public section

noncomputable section

universe u

open scoped TensorProduct

namespace Coalgebra

variable (K : Type u) [Field K]

private def tensorCoordinate (a b : ℕ) :
    ((ℕ →₀ K) ⊗[K] (ℕ →₀ K)) →ₗ[K] K :=
  (TensorProduct.lid K K).toLinearMap ∘ₗ
    _root_.TensorProduct.map (Finsupp.lapply a) (Finsupp.lapply b)

private theorem tensorCoordinate_tmul (a b : ℕ) (c d : ℕ →₀ K) :
    tensorCoordinate K a b (c ⊗ₜ[K] d) = c a * d b := by
  rfl


set_option maxHeartbeats 800000 in
-- Induced coalgebra structures on nested tensor subtypes require more reductions.
/-- The tensor square of the finite proper subcoalgebra supported on `{0, 1}` is
nonzero and proper, has the four expected generators, and satisfies the corresponding
least-subcoalgebra criterion. Both factors are the same subcoalgebra of the original
Finsupp coalgebra, over an arbitrary field. -/
theorem exists_tensorProduct_subcoalgebra_finsupp_nat :
    ∃ (D : Subcoalgebra K (ℕ →₀ K)) (d₀ d₁ : D),
      let δ : ℕ → (ℕ →₀ K) := fun i => Finsupp.single i (1 : K)
      let A := D ⊗[K] D
      let B := (ℕ →₀ K) ⊗[K] (ℕ →₀ K)
      let f : A →ₗc[K] B :=
        _root_.Coalgebra.TensorProduct.map (R := K) (S := K) D.subtype D.subtype
      let U := D.tensorProduct D
      let r : A →ₗc[K] (_root_.CoalgHom.range (K := K) (A := A) (B := B) f) :=
        _root_.CoalgHom.rangeRestrict (K := K) (A := A) (B := B) f
      let i : (_root_.CoalgHom.range (K := K) (A := A) (B := B) f) →ₗc[K] B :=
        _root_.Subcoalgebra.subtype (K := K) (C := B)
          (_root_.CoalgHom.range (K := K) (A := A) (B := B) f)
      let g : A →ₗc[K] B :=
        _root_.CoalgHom.comp (R := K) (A := A)
          (B := (_root_.CoalgHom.range (K := K) (A := A) (B := B) f)) (C := B) i r
      D.toSubmodule = Finsupp.supported K K ({0, 1} : Set ℕ) ∧
      D.toSubmodule ≠ ⊥ ∧ D.toSubmodule ≠ ⊤ ∧ D.toSubmodule.FG ∧
      Module.Finite K D ∧ ¬ Module.Finite K (ℕ →₀ K) ∧
      (d₀ : ℕ →₀ K) = δ 0 ∧ (d₁ : ℕ →₀ K) = δ 1 ∧
      U.toSubmodule = LinearMap.range (TensorProduct.mapIncl D.toSubmodule D.toSubmodule) ∧
      U.toSubmodule = Submodule.span K
        {z | ∃ c ∈ D, ∃ d ∈ D, c ⊗ₜ[K] d = z} ∧
      U.toSubmodule = Submodule.span K
        {δ 0 ⊗ₜ[K] δ 0, δ 0 ⊗ₜ[K] δ 1, δ 1 ⊗ₜ[K] δ 0, δ 1 ⊗ₜ[K] δ 1} ∧
      δ 0 ⊗ₜ[K] δ 0 ∈ U ∧ δ 0 ⊗ₜ[K] δ 0 ≠ 0 ∧ U.toSubmodule ≠ ⊥ ∧
      δ 2 ⊗ₜ[K] δ 0 ∉ U ∧ U.toSubmodule ≠ ⊤ ∧
      δ 0 ⊗ₜ[K] δ 0 + δ 1 ⊗ₜ[K] δ 1 ∈ U ∧
      g (d₀ ⊗ₜ[K] d₁) = δ 0 ⊗ₜ[K] δ 1 ∧
      (∀ Y : Subcoalgebra K ((ℕ →₀ K) ⊗[K] (ℕ →₀ K)),
        U.toSubmodule ≤ Y.toSubmodule ↔
          δ 0 ⊗ₜ[K] δ 0 ∈ Y ∧ δ 0 ⊗ₜ[K] δ 1 ∈ Y ∧
          δ 1 ⊗ₜ[K] δ 0 ∈ Y ∧ δ 1 ⊗ₜ[K] δ 1 ∈ Y) ∧
      (0 : (ℕ →₀ K) ⊗[K] (ℕ →₀ K)) ∈ U := by
  obtain ⟨D, hD, hDbot, hDtop, hFG, hFinite, hInfinite, h₀, h₁⟩ :=
    exists_finite_proper_subcoalgebra_finsupp_nat K
  let δ : ℕ → (ℕ →₀ K) := fun i => Finsupp.single i (1 : K)
  let A := D ⊗[K] D
  let B := (ℕ →₀ K) ⊗[K] (ℕ →₀ K)
  let f : A →ₗc[K] B :=
    _root_.Coalgebra.TensorProduct.map (R := K) (S := K) D.subtype D.subtype
  let U := D.tensorProduct D
  let r : A →ₗc[K] (_root_.CoalgHom.range (K := K) (A := A) (B := B) f) :=
    _root_.CoalgHom.rangeRestrict (K := K) (A := A) (B := B) f
  let i : (_root_.CoalgHom.range (K := K) (A := A) (B := B) f) →ₗc[K] B :=
    _root_.Subcoalgebra.subtype (K := K) (C := B)
      (_root_.CoalgHom.range (K := K) (A := A) (B := B) f)
  let g : A →ₗc[K] B :=
    _root_.CoalgHom.comp (R := K) (A := A)
      (B := (_root_.CoalgHom.range (K := K) (A := A) (B := B) f)) (C := B) i r
  let d₀ : D := ⟨δ 0, h₀⟩
  let d₁ : D := ⟨δ 1, h₁⟩
  have h00 : δ 0 ⊗ₜ[K] δ 0 ∈ U :=
    Subcoalgebra.tmul_mem_tensorProduct (D := D) (E := D)
      (c := δ 0) (c' := δ 0) h₀ h₀
  have hspan : U.toSubmodule = Submodule.span K
      {z | ∃ c ∈ D, ∃ d ∈ D, c ⊗ₜ[K] d = z} :=
    Subcoalgebra.tensorProduct_toSubmodule_eq_span (D := D) (E := D)
  have h01 : δ 0 ⊗ₜ[K] δ 1 ∈ U :=
    Subcoalgebra.tmul_mem_tensorProduct (D := D) (E := D)
      (c := δ 0) (c' := δ 1) h₀ h₁
  have h10 : δ 1 ⊗ₜ[K] δ 0 ∈ U :=
    Subcoalgebra.tmul_mem_tensorProduct (D := D) (E := D)
      (c := δ 1) (c' := δ 0) h₁ h₀
  have h11 : δ 1 ⊗ₜ[K] δ 1 ∈ U :=
    Subcoalgebra.tmul_mem_tensorProduct (D := D) (E := D)
      (c := δ 1) (c' := δ 1) h₁ h₁
  have hDspan : D.toSubmodule = Submodule.span K {δ 0, δ 1} := by
    rw [hD, Finsupp.supported_eq_span_single]
    simp only [Set.image_insert_eq, Set.image_singleton, δ]
  have hfour : U.toSubmodule = Submodule.span K
      {δ 0 ⊗ₜ[K] δ 0, δ 0 ⊗ₜ[K] δ 1, δ 1 ⊗ₜ[K] δ 0, δ 1 ⊗ₜ[K] δ 1} := by
    rw [Subcoalgebra.tensorProduct_toSubmodule, TensorProduct.range_mapIncl,
      hDspan, Submodule.map₂_span_span]
    congr 1
    ext z
    constructor
    · rintro ⟨c, hc, d, hd, rfl⟩
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hc hd ⊢
      rcases hc with rfl | rfl <;> rcases hd with rfl | rfl
      · exact Or.inl rfl
      · exact Or.inr (Or.inl rfl)
      · exact Or.inr (Or.inr (Or.inl rfl))
      · exact Or.inr (Or.inr (Or.inr rfl))
    · intro hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl | rfl | rfl
      · exact ⟨δ 0, Or.inl rfl, δ 0, Or.inl rfl, rfl⟩
      · exact ⟨δ 0, Or.inl rfl, δ 1, Or.inr rfl, rfl⟩
      · exact ⟨δ 1, Or.inr rfl, δ 0, Or.inl rfl, rfl⟩
      · exact ⟨δ 1, Or.inr rfl, δ 1, Or.inr rfl, rfl⟩
  have hleast (S : Submodule K ((ℕ →₀ K) ⊗[K] (ℕ →₀ K))) :
      U.toSubmodule ≤ S ↔
        δ 0 ⊗ₜ[K] δ 0 ∈ S ∧ δ 0 ⊗ₜ[K] δ 1 ∈ S ∧
        δ 1 ⊗ₜ[K] δ 0 ∈ S ∧ δ 1 ⊗ₜ[K] δ 1 ∈ S := by
    constructor
    · intro h
      exact ⟨h h00, h h01, h h10, h h11⟩
    · rintro ⟨h00S, h01S, h10S, h11S⟩
      rw [hfour]
      refine Submodule.span_le.mpr ?_
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl | rfl | rfl
      · exact h00S
      · exact h01S
      · exact h10S
      · exact h11S
  have hPhi00 : tensorCoordinate K 0 0 (δ 0 ⊗ₜ[K] δ 0) = 1 := by
    simp only [tensorCoordinate_tmul, δ, Finsupp.single_eq_same, mul_one]
  have h00ne : δ 0 ⊗ₜ[K] δ 0 ≠ 0 := by
    intro hz
    have hone : (1 : K) = 0 := by
      rw [← hPhi00, hz, map_zero]
    exact one_ne_zero hone
  have hUbot : U.toSubmodule ≠ ⊥ := by
    intro hbot
    have hm : δ 0 ⊗ₜ[K] δ 0 ∈ U.toSubmodule := h00
    rw [hbot] at hm
    exact h00ne (by simpa only [Submodule.mem_bot] using hm)
  have hker : U.toSubmodule ≤ LinearMap.ker (tensorCoordinate K 2 0) := by
    apply (Subcoalgebra.tensorProduct_toSubmodule_le_iff
      (D := D) (E := D) (S := LinearMap.ker (tensorCoordinate K 2 0))).2
    intro c hc d hd
    have hcS : c ∈ Finsupp.supported K K ({0, 1} : Set ℕ) := by
      rw [Subcoalgebra.mem_iff D] at hc
      rwa [hD] at hc
    have hc2 : c 2 = 0 :=
      (Finsupp.mem_supported' K c).mp hcS 2 (by simp)
    rw [LinearMap.mem_ker, tensorCoordinate_tmul, hc2, zero_mul]
  have hPhi20 : tensorCoordinate K 2 0 (δ 2 ⊗ₜ[K] δ 0) = 1 := by
    simp only [tensorCoordinate_tmul, δ, Finsupp.single_eq_same, mul_one]
  have h20out : δ 2 ⊗ₜ[K] δ 0 ∉ U := by
    intro hm
    have hz := LinearMap.mem_ker.mp (hker hm)
    rw [hPhi20] at hz
    exact one_ne_zero hz
  have hUtop : U.toSubmodule ≠ ⊤ := by
    intro htop
    apply h20out
    rw [Subcoalgebra.mem_iff U]
    simpa only [htop] using
      (Submodule.mem_top : δ 2 ⊗ₜ[K] δ 0 ∈
        (⊤ : Submodule K ((ℕ →₀ K) ⊗[K] (ℕ →₀ K))))
  have hsum : δ 0 ⊗ₜ[K] δ 0 + δ 1 ⊗ₜ[K] δ 1 ∈ U := by
    apply (Subcoalgebra.mem_tensorProduct (D := D) (E := D)).2
    refine ⟨d₀ ⊗ₜ[K] d₀ + d₁ ⊗ₜ[K] d₁, ?_⟩
    exact map_add (TensorProduct.mapIncl D.toSubmodule D.toSubmodule) _ _
  have hrestrict : g (d₀ ⊗ₜ[K] d₁) = δ 0 ⊗ₜ[K] δ 1 := by
    simpa only [g, _root_.CoalgHom.coe_comp, Function.comp_apply, i,
      _root_.Subcoalgebra.subtype_apply, r, f] using
      (Subcoalgebra.tensorProduct_subtype_rangeRestrict_tmul D D d₀ d₁)
  refine ⟨D, d₀, d₁, hD, hDbot, hDtop, hFG, hFinite, hInfinite, rfl, rfl,
    Subcoalgebra.tensorProduct_toSubmodule (D := D) (E := D), hspan,
    hfour, h00, h00ne, hUbot, h20out, hUtop, hsum, hrestrict, ?_, ?_⟩
  · intro Y
    exact hleast Y.toSubmodule
  · exact U.toSubmodule.zero_mem

end Coalgebra
