module

public import AlgebraicGroupsTest.Algebra.Coalgebra.ComoduleCoefficientsGL2
public import Mathlib.Algebra.EuclideanDomain.Int
public import Mathlib.Data.ZMod.Basic
public import Mathlib.RingTheory.Finiteness.Prod
public import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# Uses of right-comodule coefficient coalgebras

These uses express corestriction to an existing subcoalgebra of the coordinate
coalgebra and to the intrinsic coefficient subcoalgebra. They retain the
coordinate algebra's existing additive-group structure and use the tensor
inclusion on the coalgebra factor.

For the standard two-dimensional representation over `ℚ`, the intrinsic
coefficient subcoalgebra admits a unique whole right-comodule structure with
the inclusion equation. Its underlying submodule is finitely generated by the
finite-comodule theorem, and the matrix-entry model independently shows that
it is nonzero and proper. Any competing corestriction with the inclusion
equation equals the coefficient comodule.

For the coalgebra structure of a commutative semiring over itself, the regular
coefficient span is full over `ℕ`; over `ℚ`, the coefficient subcoalgebra has
full underlying submodule. Evaluating at zero illustrates the zero boundary
in the same self-coalgebra family.

The scalar coaction on `ℤ × ZMod 2` is finite but not free over `ℤ`. A pure
tensor coefficient detects the unit, so its coefficient span is full and
nonzero. Finite generation uses the Noetherian-ring theorem, without a basis.
-/

@[expose] public section

noncomputable section

open scoped TensorProduct

namespace ComoduleCoefficientsGL2

example (D : Subcoalgebra ℚ C)
    (h : ∀ m : M, comodule.coaction m ∈
      LinearMap.range (D.subtype.toLinearMap.lTensor M)) :
    Coalgebra.RightComodule ℚ D M :=
  comodule.restrictCoalgebra D h

example (D : Subcoalgebra ℚ C)
    (h : ∀ m : M, comodule.coaction m ∈
      LinearMap.range (D.subtype.toLinearMap.lTensor M)) :
    D.subtype.toLinearMap.lTensor M ∘ₗ
        (comodule.restrictCoalgebra D h).coaction = comodule.coaction :=
  comodule.subtype_lTensor_comp_restrictCoalgebra_coaction D h

example : Coalgebra.RightComodule ℚ comodule.coefficientSubcoalgebra M :=
  comodule.coefficientComodule

example : comodule.coefficientSubcoalgebra.subtype.toLinearMap.lTensor M ∘ₗ
    comodule.coefficientComodule.coaction = comodule.coaction :=
  comodule.subtype_lTensor_comp_coefficientComodule_coaction

/-- The standard representation has a unique corestriction to its coefficient subcoalgebra. -/
theorem existsUnique_coefficientComodule :
    ∃! Y : Coalgebra.RightComodule ℚ comodule.coefficientSubcoalgebra M,
      comodule.coefficientSubcoalgebra.subtype.toLinearMap.lTensor M ∘ₗ Y.coaction =
        comodule.coaction := by
  apply (comodule.existsUnique_restrictCoalgebra_iff comodule.coefficientSubcoalgebra).mpr
  simpa only [Coalgebra.RightComodule.coefficientSubcoalgebra_toSubmodule] using
    (le_rfl : comodule.coefficientSpan ≤ comodule.coefficientSpan)

/-- The intrinsic coefficient subcoalgebra is module-finitely-generated, nonzero and proper. -/
theorem coefficientSubcoalgebra_fg_nonzero_proper :
    comodule.coefficientSubcoalgebra.toSubmodule.FG ∧
      comodule.coefficientSubcoalgebra.toSubmodule ≠ ⊥ ∧
      comodule.coefficientSubcoalgebra.toSubmodule ≠ ⊤ := by
  refine ⟨comodule.coefficientSubcoalgebra_fg, ?_⟩
  simpa only [Coalgebra.RightComodule.coefficientSubcoalgebra_toSubmodule,
    coefficientSpan_eq_entrySpan] using entrySpan_nonzero_proper

/-- Any corestriction with the inclusion equation is the standard coefficient comodule. -/
theorem eq_coefficientComodule_of_inclusion
    (Y : Coalgebra.RightComodule ℚ comodule.coefficientSubcoalgebra M)
    (hY : comodule.coefficientSubcoalgebra.subtype.toLinearMap.lTensor M ∘ₗ Y.coaction =
      comodule.coaction) :
    Y = comodule.coefficientComodule := by
  obtain ⟨Z, _, hunique⟩ := existsUnique_coefficientComodule
  exact (hunique Y hY).trans
    (hunique comodule.coefficientComodule
      comodule.subtype_lTensor_comp_coefficientComodule_coaction).symm

end ComoduleCoefficientsGL2

example : (Coalgebra.RightComodule.regular ℕ ℕ).coefficientSpan = (⊤ : Submodule ℕ ℕ) :=
  Coalgebra.RightComodule.coefficientSpan_regular

example : (Coalgebra.RightComodule.regular ℚ ℚ).coefficientSubcoalgebra.toSubmodule =
    (⊤ : Submodule ℚ ℚ) :=
  Coalgebra.RightComodule.coefficientSubcoalgebra_regular_toSubmodule

example : (Coalgebra.RightComodule.regular ℕ ℕ).coefficient (Coalgebra.counit (R := ℕ)) 0 = 0 := by
  simp only [Coalgebra.RightComodule.coefficient, Coalgebra.RightComodule.regular_coaction,
    Coalgebra.rTensor_counit_comul, TensorProduct.lid_tmul, one_smul]

namespace ScalarComoduleCoefficients

local notation "X" => Coalgebra.RightComodule.scalar ℕ (Bool → ℕ)
local notation "b" => Pi.basisFun ℕ Bool

-- The scalar coaction has identity matrix and a full, finitely generated coefficient span.
example :
    (fun i j : Bool ↦ (X).coefficient ((b).coord i) ((b) j)) =
        (1 : Matrix Bool Bool ℕ) ∧
      (X).coefficientSpan = ⊤ ∧
      (X).coefficientSpan = Submodule.span ℕ ({1} : Set ℕ) ∧
      (X).coefficientSpan.FG := by
  have hmatrix :
      (fun i j : Bool ↦ (X).coefficient ((b).coord i) ((b) j)) =
        (1 : Matrix Bool Bool ℕ) := by
    ext i j
    simp [Coalgebra.RightComodule.coefficient, Module.Basis.coord_apply,
      Matrix.one_apply, Pi.single_apply]
  have hone : (X).coefficient ((b).coord false) ((b) false) = 1 := by
    simpa using congrFun (congrFun hmatrix false) false
  have htop : (X).coefficientSpan = ⊤ := by
    apply Submodule.eq_top_iff'.mpr
    intro n
    have hmem : (1 : ℕ) ∈ (X).coefficientSpan :=
      hone ▸ (X).coefficient_mem_coefficientSpan ((b).coord false) ((b) false)
    simpa only [smul_eq_mul, mul_one] using (X).coefficientSpan.smul_mem n hmem
  have hspan : Submodule.span ℕ ({1} : Set ℕ) = ⊤ :=
    (Submodule.span_singleton_eq_top_iff ℕ (1 : ℕ)).mpr fun n ↦ ⟨n, by simp⟩
  exact ⟨hmatrix, htop, htop.trans hspan.symm, (X).coefficientSpan_fg (b)⟩

end ScalarComoduleCoefficients

namespace NonfreeScalarComoduleCoefficients

local notation "M" => ℤ × ZMod 2
local notation "X" => Coalgebra.RightComodule.scalar ℤ M
local notation "ell" => LinearMap.fst ℤ ℤ (ZMod 2)

/-- A finite nonfree integral scalar comodule has a unit tensor coefficient and a full,
nonzero coefficient span; its finite generation follows from the Noetherian-ring theorem. -/
theorem finite_nonfree_span_top :
    Module.Finite ℤ M ∧ ¬ Module.Free ℤ M ∧
      (X).coefficientTensor ((ell) ⊗ₜ[ℤ] ((1, 0) : M)) = 1 ∧
      (X).coefficientSpan = (⊤ : Submodule ℤ ℤ) ∧
      (X).coefficientSpan ≠ (⊥ : Submodule ℤ ℤ) ∧ (X).coefficientSpan.FG := by
  have hfinite : Module.Finite ℤ M := inferInstance
  have htnonzero : ((0, 1) : M) ≠ 0 := by
    intro ht
    exact one_ne_zero (congrArg Prod.snd ht : (1 : ZMod 2) = 0)
  have hkill : (2 : ℤ) • ((0, 1) : M) = 0 := by
    apply Prod.ext
    · change (2 : ℤ) • (0 : ℤ) = 0
      exact smul_zero _
    · change (2 : ℤ) • (1 : ZMod 2) = 0
      rw [← Int.cast_smul_eq_zsmul (ZMod 2), smul_eq_mul, mul_one]
      simpa only [Int.cast_ofNat, Nat.cast_ofNat] using (ZMod.natCast_self 2)
  have hnonfree : ¬ Module.Free ℤ M := by
    intro hfree
    let : Module.Free ℤ M := hfree
    have htf : Module.IsTorsionFree ℤ M := Module.Free.instIsTorsionFree ℤ M
    rcases (Module.isTorsionFree_iff_smul_eq_zero.mp htf) (2 : ℤ)
        ((0, 1) : M) hkill with htwo | ht
    · exact (by decide : (2 : ℤ) ≠ 0) htwo
    · exact htnonzero ht
  have hone : (X).coefficient (ell) ((1, 0) : M) = 1 := by
    simp only [Coalgebra.RightComodule.coefficient_eq,
      Coalgebra.RightComodule.scalar_coaction, LinearMap.rTensor_tmul,
      TensorProduct.lid_tmul, LinearMap.fst_apply, one_smul]
  have htensor : (X).coefficientTensor ((ell) ⊗ₜ[ℤ] ((1, 0) : M)) = 1 := by
    rw [Coalgebra.RightComodule.coefficientTensor_apply_tmul]
    exact hone
  have htop : (X).coefficientSpan = (⊤ : Submodule ℤ ℤ) := by
    apply Submodule.eq_top_iff'.mpr
    intro n
    have hmem : (1 : ℤ) ∈ (X).coefficientSpan :=
      hone ▸ (X).coefficient_mem_coefficientSpan (ell) ((1, 0) : M)
    simpa only [smul_eq_mul, mul_one] using (X).coefficientSpan.smul_mem n hmem
  have hnonzero : (X).coefficientSpan ≠ (⊥ : Submodule ℤ ℤ) := by
    rw [htop]
    exact top_ne_bot
  exact ⟨hfinite, hnonfree, htensor, htop, hnonzero,
    (X).coefficientSpan_fg_of_isNoetherianRing⟩

end NonfreeScalarComoduleCoefficients
