module

public import AlgebraicGroups.GroupScheme.Additive
public import AlgebraicGroups.Algebra.Coalgebra.CoefficientMatrixUnit
public import AlgebraicGroups.Algebra.Coalgebra.FiniteSubcoalgebra
public import Mathlib.LinearAlgebra.Matrix.Notation
public import Mathlib.RingTheory.Adjoin.Polynomial.Basic
public import Mathlib.RingTheory.Coalgebra.GroupLike
public import Mathlib.RingTheory.Polynomial.Basic

/-!
# Algebra-generating coalgebra matrices

The additive-group coordinate ring over `ℚ` is the rank-one symmetric algebra,
with its primitive coordinate `x` and its existing Hopf algebra structure. The
matrix `!![1, x; 0, 1]` satisfies the coefficient comultiplication and counit
identities, and its entries generate the coordinate ring as an algebra.

This algebra is of finite type but is not a finite `ℚ`-module. Consequently the
finite linear span of these entries is proper, even though their algebraic
adjoin is the whole ring. The off-diagonal coordinate is nonzero and is not
group-like. The polynomial presentation is used only as an algebra and linear
equivalence, not to transport the coalgebra structure.

The empty matrix also gives the scalar boundary `C = ℚ` and the zero ambient
algebra `C = Fin 0 → ℚ`. The latter uses the existing pointwise algebra and Pi
coalgebra, without a bialgebra structure on the zero algebra. For the displayed
matrices, all laws and generation claims are proved directly from these constructions.

## References

- J. S. Milne, *Algebraic Groups* (2017), item 2.1, for the additive coordinate.
- The additive-group and symmetric-algebra formalizations in
  `AlgebraicGroups.GroupScheme.Additive` and
  `AlgebraicGroups.Algebra.SymmetricAlgebra`.
- Mathlib's primitive symmetric-algebra bialgebra, polynomial-adjoin,
  module-finiteness, group-like-element, scalar-coalgebra and Pi-coalgebra APIs.
-/

@[expose] public noncomputable section

open scoped TensorProduct

namespace CoalgebraExamples.FiniteAlgebraGenerators

local notation "C" => (SymmetricAlgebra ℚ ℚ)
local notation "x" => (SymmetricAlgebra.ι ℚ ℚ 1)

/-- The upper-triangular coefficient matrix of the additive coordinate. -/
def additiveMatrix : Matrix (Fin 2) (Fin 2) C :=
  !![1, x; 0, 1]

/-- The four entries of the additive-coordinate matrix. -/
@[simp]
theorem additiveMatrix_apply (i j : Fin 2) :
    additiveMatrix i j =
      if i = 0 then (if j = 0 then 1 else x) else (if j = 0 then 0 else 1) := by
  fin_cases i <;> fin_cases j <;> rfl

/-- The additive-coordinate matrix satisfies the coefficient comultiplication law. -/
theorem additiveMatrix_comul (i j : Fin 2) :
    Coalgebra.comul (R := ℚ) (additiveMatrix i j) =
      ∑ k, additiveMatrix i k ⊗ₜ[ℚ] additiveMatrix k j := by
  fin_cases i <;> fin_cases j <;>
    simp [Fin.sum_univ_two, Algebra.TensorProduct.one_def, add_comm]

/-- The additive-coordinate matrix has the Kronecker-delta counit. -/
theorem additiveMatrix_counit (i j : Fin 2) :
    Coalgebra.counit (R := ℚ) (additiveMatrix i j) = if i = j then 1 else 0 := by
  fin_cases i <;> fin_cases j <;> simp

/-- The matrix entries generate the whole additive-group coordinate algebra. -/
theorem additiveMatrix_adjoin_eq_top :
    Algebra.adjoin ℚ (Set.range (Function.uncurry additiveMatrix)) = ⊤ := by
  let e := AlgebraicGeometry.additiveGroupCoordinateAlgEquiv ℚ
  have hX : e.symm (Polynomial.X : Polynomial ℚ) = x := by
    apply e.injective
    simp [e]
  have hgen : Algebra.adjoin ℚ ({x} : Set C) = ⊤ := by
    calc
      Algebra.adjoin ℚ ({x} : Set C) =
          (Algebra.adjoin ℚ ({Polynomial.X} : Set (Polynomial ℚ))).map
            e.symm.toAlgHom := by
        rw [AlgHom.map_adjoin, Set.image_singleton, AlgEquiv.toAlgHom_apply, hX]
      _ = ⊤ := by
        rw [Polynomial.adjoin_X, Algebra.map_top]
        exact (AlgHom.range_eq_top _).mpr e.symm.surjective
  have hx : x ∈ Set.range (Function.uncurry additiveMatrix) :=
    ⟨(0, 1), rfl⟩
  apply top_unique
  rw [← hgen]
  exact Algebra.adjoin_mono (Set.singleton_subset_iff.mpr hx)

/-- The additive-group coordinate ring is an algebra of finite type over `ℚ`. -/
theorem additive_finiteType : Algebra.FiniteType ℚ C :=
  inferInstance

/-- The additive-group coordinate algebra is generated by the entries of a finite matrix unit. -/
theorem exists_additiveMatrixUnit_adjoin_eq_top :
    ∃ (n : ℕ) (U : (Matrix (Fin n) (Fin n) C)ˣ),
      Algebra.adjoin ℚ (Set.range (Function.uncurry (↑U : Matrix (Fin n) (Fin n) C))) = ⊤ := by
  obtain ⟨n, M, hΔ, hε, hgen⟩ :=
    Coalgebra.exists_coefficientMatrix_adjoin_eq_top (K := ℚ) (A := C)
  let U := HopfAlgebra.coefficientMatrixUnit (R := ℚ) M hΔ hε
  refine ⟨n, U, ?_⟩
  have hU : (↑U : Matrix (Fin n) (Fin n) C) = M :=
    HopfAlgebra.coe_coefficientMatrixUnit M hΔ hε
  rw [hU]
  exact hgen

/-- The additive-group coordinate algebra is not finite-dimensional over `ℚ`. -/
theorem additive_not_finite : ¬ Module.Finite ℚ C := by
  intro h
  exact Polynomial.not_finite
    ((Module.Finite.equiv_iff
      (AlgebraicGeometry.additiveGroupCoordinateAlgEquiv ℚ).toLinearEquiv).mp h)

/-- The linear span of the finite matrix-entry family is finitely generated. -/
theorem additiveMatrix_span_fg :
    (Submodule.span ℚ (Set.range (Function.uncurry additiveMatrix))).FG :=
  Coalgebra.fg_span_coefficients additiveMatrix

/-- The finite coefficient span is proper, despite algebraic generation by the same entries. -/
theorem additiveMatrix_span_ne_top :
    Submodule.span ℚ (Set.range (Function.uncurry additiveMatrix)) ≠ ⊤ := by
  intro htop
  exact additive_not_finite (Module.Finite.of_fg_top (htop ▸ additiveMatrix_span_fg))

/-- The off-diagonal entry is a nonzero primitive coordinate. -/
theorem additiveMatrix_zero_one_ne_zero : additiveMatrix 0 1 ≠ 0 := by
  intro h
  have hX : (Polynomial.X : Polynomial ℚ) = 0 := by
    simpa using congrArg (AlgebraicGeometry.additiveGroupCoordinateAlgEquiv ℚ) h
  exact Polynomial.X_ne_zero hX

/-- The primitive additive coordinate is not group-like: its counit is zero. -/
theorem coordinate_not_groupLike : ¬ IsGroupLikeElem ℚ x := by
  intro h
  simpa using h.counit_eq_one

/-- The empty coefficient matrix over the scalar coalgebra `ℚ`. -/
def scalarEmptyMatrix : Matrix (Fin 0) (Fin 0) ℚ :=
  !![]

/-- The scalar algebra is of finite type over itself. -/
theorem scalar_finiteType : Algebra.FiniteType ℚ ℚ :=
  inferInstance

/-- The empty scalar matrix has vacuous coalgebra laws and algebra-generates `ℚ` over itself. -/
theorem scalarEmptyMatrix_laws :
    (∀ i j, Coalgebra.comul (R := ℚ) (scalarEmptyMatrix i j) =
      ∑ k, scalarEmptyMatrix i k ⊗ₜ[ℚ] scalarEmptyMatrix k j) ∧
    (∀ i j, Coalgebra.counit (R := ℚ) (scalarEmptyMatrix i j) =
      if i = j then 1 else 0) ∧
    Algebra.adjoin ℚ (Set.range (Function.uncurry scalarEmptyMatrix)) = ⊤ := by
  refine ⟨fun i => Fin.elim0 i, fun i => Fin.elim0 i, ?_⟩
  apply Algebra.eq_top_iff.mpr
  intro q
  exact (Algebra.adjoin ℚ (Set.range (Function.uncurry scalarEmptyMatrix))).algebraMap_mem q

/-- The empty matrix in the zero algebra with its pointwise algebra and Pi coalgebra. -/
def zeroEmptyMatrix : Matrix (Fin 0) (Fin 0) (Fin 0 → ℚ) :=
  !![]

/-- The empty-function algebra is of finite type over `ℚ`. -/
theorem zero_finiteType : Algebra.FiniteType ℚ (Fin 0 → ℚ) :=
  inferInstance

/-- In the zero ambient algebra, the empty matrix has vacuous coalgebra laws and full adjoin. -/
theorem zeroEmptyMatrix_laws :
    (∀ i j, Coalgebra.comul (R := ℚ) (zeroEmptyMatrix i j) =
      ∑ k, zeroEmptyMatrix i k ⊗ₜ[ℚ] zeroEmptyMatrix k j) ∧
    (∀ i j, Coalgebra.counit (R := ℚ) (zeroEmptyMatrix i j) =
      if i = j then 1 else 0) ∧
    Algebra.adjoin ℚ (Set.range (Function.uncurry zeroEmptyMatrix)) = ⊤ := by
  exact ⟨fun i => Fin.elim0 i, fun i => Fin.elim0 i, Subsingleton.elim _ _⟩

end CoalgebraExamples.FiniteAlgebraGenerators
