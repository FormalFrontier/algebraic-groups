module

public import AlgebraicGroups.Algebra.Coalgebra.IdempotentIdealTensor
public import AlgebraicGroupsTest.Algebra.Coalgebra.CounitRange
public import Mathlib.Data.ZMod.Basic

/-!
# Tensor products of proper idempotent ideal coalgebras

Over `ZMod 6`, the ideals generated by three and four are proper and nonzero.
Their orthogonal generators give a zero tensor product, whereas the tensor
square of the ideal generated by three has a nonzero specified generator.
The coalgebra equivalence is used through its characteristic API and the
inherited coalgebra-morphism laws, in both directions.

The displayed scalar coefficients need not be unique. These principal ideals
are direct summands, hence these examples do not assert that the factors are
nonflat or not finitely generated.

## References

The `ZMod 6` fixtures and their proper nonzero scalar supports, orthogonal
zero tensor product, and nonzero self-tensor generator are supplied by
`AlgebraicGroupsTest.Algebra.Coalgebra.CounitRange`. These boundary facts are
reused independently of the multiplication coalgebra equivalence.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

open scoped TensorProduct

universe u

section ScalarGenerator

variable {R : Type u} [CommSemiring R] {e f : R}

example (he : IsIdempotentElem e) (hf : IsIdempotentElem f) (r : R) :
    (he.tensorCoalgebraSpanEquiv hf)
        (r • (Ideal.spanSingletonGenerator e ⊗ₜ[R] Ideal.spanSingletonGenerator f)) =
      r • Ideal.spanSingletonGenerator (e * f) := by
  rw [map_smul, he.tensorCoalgebraSpanEquiv_generator hf]

end ScalarGenerator

namespace IdempotentIdealTensorExamples

private abbrev K := ZMod 6
private abbrev I3 := Ideal.span ({(3 : K)} : Set K)
private abbrev I4 := Ideal.span ({(4 : K)} : Set K)
private abbrev I33 := Ideal.span ({(3 : K) * 3} : Set K)
private abbrev I34 := Ideal.span ({(3 : K) * 4} : Set K)
private abbrev g3 : I3 := Ideal.spanSingletonGenerator (3 : K)
private abbrev g4 : I4 := Ideal.spanSingletonGenerator (4 : K)
private abbrev q33 : I33 := Ideal.spanSingletonGenerator ((3 : K) * 3)
private abbrev q34 : I34 := Ideal.spanSingletonGenerator ((3 : K) * 4)
private abbrev T33 := I3 ⊗[K] I3
private abbrev T34 := I3 ⊗[K] I4
private noncomputable abbrev t33 : T33 := g3 ⊗ₜ[K] g3
private noncomputable abbrev t34 : T34 := g3 ⊗ₜ[K] g4

private theorem three_idempotent : IsIdempotentElem (3 : K) := by
  change (3 : K) * 3 = 3
  decide

private theorem four_idempotent : IsIdempotentElem (4 : K) := by
  change (4 : K) * 4 = 4
  decide

private theorem three_mul_three : (3 : K) * 3 = 3 := by decide
private theorem three_mul_four : (3 : K) * 4 = 0 := by decide
private theorem three_ne_zero : (3 : K) ≠ 0 := by decide
private theorem four_ne_zero : (4 : K) ≠ 0 := by decide
private theorem three_ne_one : (3 : K) ≠ 1 := by decide
private theorem four_ne_one : (4 : K) ≠ 1 := by decide

private theorem g3_ne_zero : g3 ≠ 0 := by
  intro h
  exact three_ne_zero (congrArg (fun x : I3 ↦ (x : K)) h)

private theorem g4_ne_zero : g4 ≠ 0 := by
  intro h
  exact four_ne_zero (congrArg (fun x : I4 ↦ (x : K)) h)

private theorem span_three_ne_bot : I3 ≠ ⊥ := by
  have h : (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal K) ≠ ⊥ :=
    CoalgebraTest.orthogonal_ideal_factors_nontrivial_support.2.2.1
  rwa [three_idempotent.coalgebraSpan_counit, Submodule.range_subtype] at h

private theorem span_four_ne_bot : I4 ≠ ⊥ := by
  have h : (LinearMap.range four_idempotent.coalgebraSpan.counit : Ideal K) ≠ ⊥ :=
    CoalgebraTest.orthogonal_ideal_factors_nontrivial_support.2.2.2.2.1
  rwa [four_idempotent.coalgebraSpan_counit, Submodule.range_subtype] at h

private theorem span_three_ne_top : I3 ≠ ⊤ := by
  have h : (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal K) ≠ ⊤ :=
    CoalgebraTest.orthogonal_ideal_factors_nontrivial_support.2.2.2.1
  rwa [three_idempotent.coalgebraSpan_counit, Submodule.range_subtype] at h

private theorem span_four_ne_top : I4 ≠ ⊤ := by
  have h : (LinearMap.range four_idempotent.coalgebraSpan.counit : Ideal K) ≠ ⊤ :=
    CoalgebraTest.orthogonal_ideal_factors_nontrivial_support.2.2.2.2.2
  rwa [four_idempotent.coalgebraSpan_counit, Submodule.range_subtype] at h

private noncomputable local instance : Coalgebra K I3 := three_idempotent.coalgebraSpan
private noncomputable local instance : Coalgebra K I4 := four_idempotent.coalgebraSpan
private noncomputable local instance : Coalgebra K I33 :=
  (three_idempotent.mul three_idempotent).coalgebraSpan
private noncomputable local instance : Coalgebra K I34 :=
  (three_idempotent.mul four_idempotent).coalgebraSpan

private noncomputable abbrev E33 := three_idempotent.tensorCoalgebraSpanEquiv three_idempotent
private noncomputable abbrev E34 := three_idempotent.tensorCoalgebraSpanEquiv four_idempotent

/-- The tensor generator is detected by the stock tensor counit, without using
the multiplication equivalence. -/
private theorem tensor33_counit_generator : Coalgebra.counit (R := K) t33 = 3 := by
  simp only [t33, g3, TensorProduct.counit_tmul, Ideal.coe_spanSingletonGenerator,
    three_idempotent.coalgebraSpan_counit_apply, smul_eq_mul, three_mul_three]

/-- The tensor product of the orthogonal principal ideals of three and four in
`ZMod 6` is zero, even though both factor ideals are proper and nonzero.
This reuses `CoalgebraTest.orthogonal_ideal_tensor_subsingleton`, independently
of the multiplication equivalence. -/
theorem tensor_span_three_four_eq_zero
    (t : (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))) ⊗[ZMod 6]
      (Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6)))) : t = 0 := by
  let : Subsingleton T34 := CoalgebraTest.orthogonal_ideal_tensor_subsingleton.2
  exact Subsingleton.elim t 0

/-- The specified generator of the tensor square of the principal ideal of
three in `ZMod 6` is nonzero. This reuses the counit-detected generator result
in `CoalgebraTest.span_three_tensor_self_support`. -/
theorem tensor_span_three_generator_ne_zero :
    (Ideal.spanSingletonGenerator (3 : ZMod 6) ⊗ₜ[ZMod 6]
      Ideal.spanSingletonGenerator (3 : ZMod 6)) ≠ 0 :=
  CoalgebraTest.span_three_tensor_self_support.2.2.2

private theorem product33_ne_bot : I33 ≠ ⊥ := by
  simpa only [I33, three_mul_three] using CoalgebraTest.span_three_tensor_self_support.2.1

private theorem product33_ne_top : I33 ≠ ⊤ := by
  simpa only [I33, three_mul_three] using CoalgebraTest.span_three_tensor_self_support.2.2.1

private theorem product34_eq_bot : I34 = ⊥ := by
  simp only [I34, three_mul_four, Ideal.span_singleton_zero]

example : Nontrivial I3 ∧ Nontrivial I4 ∧ I3 ≠ ⊥ ∧ I3 ≠ ⊤ ∧ I4 ≠ ⊥ ∧ I4 ≠ ⊤ :=
  ⟨CoalgebraTest.orthogonal_ideal_factors_nontrivial_support.1,
    CoalgebraTest.orthogonal_ideal_factors_nontrivial_support.2.1,
    span_three_ne_bot, span_three_ne_top, span_four_ne_bot, span_four_ne_top⟩

example : I33 ≠ ⊥ ∧ I33 ≠ ⊤ ∧ t33 ≠ 0 :=
  ⟨product33_ne_bot, product33_ne_top, tensor_span_three_generator_ne_zero⟩

example : I34 = ⊥ ∧ g3 ≠ 0 ∧ g4 ≠ 0 ∧ t34 = 0 :=
  ⟨product34_eq_bot, g3_ne_zero, g4_ne_zero, tensor_span_three_four_eq_zero t34⟩

example : E33 t33 = q33 := by
  exact three_idempotent.tensorCoalgebraSpanEquiv_generator three_idempotent

example : E33.symm q33 = t33 := by
  have hg : E33 t33 = q33 :=
    three_idempotent.tensorCoalgebraSpanEquiv_generator three_idempotent
  rw [← hg, E33.symm_apply_apply]

example (r s : K) : E33 ((r • g3) ⊗ₜ[K] (s • g3)) = (r * s) • q33 := by
  rw [TensorProduct.smul_tmul_smul, map_smul,
    three_idempotent.tensorCoalgebraSpanEquiv_generator three_idempotent]

example (z : I33) : E33.symm z = (z : K) • t33 := by
  exact three_idempotent.tensorCoalgebraSpanEquiv_symm_apply three_idempotent z

example (z : I33) : E33 (E33.symm z) = z :=
  E33.apply_symm_apply z

example (x : T33) : ((E33 x : K) • t33) = x := by
  exact three_idempotent.tensorCoalgebraSpanEquiv_coe_smul_generator three_idempotent x

example : (three_idempotent.mul three_idempotent).coalgebraSpan.counit q33 = 3 := by
  simp only [IsIdempotentElem.coalgebraSpan_counit_apply,
    Ideal.coe_spanSingletonGenerator, three_mul_three]

example : Coalgebra.comul (R := K) t33 = t33 ⊗ₜ[K] t33 := by
  exact three_idempotent.tensorCoalgebraSpan_comul_apply three_idempotent t33

example : (three_idempotent.mul three_idempotent).coalgebraSpan.comul q33 =
    q33 ⊗ₜ[K] q33 := by
  exact (three_idempotent.mul three_idempotent).coalgebraSpan_comul_generator

-- These clients consume the bundled coalgebra-morphism laws in both directions.
example :
    TensorProduct.map E33.toLinearEquiv.toLinearMap E33.toLinearEquiv.toLinearMap
        (Coalgebra.comul (R := K) t33) = q33 ⊗ₜ[K] q33 := by
  have hg : E33 t33 = q33 :=
    three_idempotent.tensorCoalgebraSpanEquiv_generator three_idempotent
  calc
    TensorProduct.map E33.toLinearEquiv.toLinearMap E33.toLinearEquiv.toLinearMap
        (Coalgebra.comul (R := K) t33) =
        (three_idempotent.mul three_idempotent).coalgebraSpan.comul (E33 t33) :=
      CoalgHomClass.map_comp_comul_apply E33 t33
    _ = q33 ⊗ₜ[K] q33 := by
      rw [hg]
      exact (three_idempotent.mul three_idempotent).coalgebraSpan_comul_generator

example :
    TensorProduct.map E33.symm.toLinearEquiv.toLinearMap E33.symm.toLinearEquiv.toLinearMap
        ((three_idempotent.mul three_idempotent).coalgebraSpan.comul q33) =
      t33 ⊗ₜ[K] t33 := by
  have hg : E33 t33 = q33 :=
    three_idempotent.tensorCoalgebraSpanEquiv_generator three_idempotent
  calc
    TensorProduct.map E33.symm.toLinearEquiv.toLinearMap E33.symm.toLinearEquiv.toLinearMap
        ((three_idempotent.mul three_idempotent).coalgebraSpan.comul q33) =
        Coalgebra.comul (R := K) (E33.symm q33) :=
      CoalgHomClass.map_comp_comul_apply E33.symm q33
    _ = t33 ⊗ₜ[K] t33 := by
      rw [← hg, E33.symm_apply_apply]
      exact three_idempotent.tensorCoalgebraSpan_comul_apply three_idempotent t33

example : (three_idempotent.mul three_idempotent).coalgebraSpan.counit (E33 t33) =
    Coalgebra.counit (R := K) t33 := by
  exact CoalgHomClass.counit_comp_apply E33 t33

example : Coalgebra.counit (R := K) (E33.symm q33) =
    (three_idempotent.mul three_idempotent).coalgebraSpan.counit q33 := by
  exact CoalgHomClass.counit_comp_apply E33.symm q33

example (x : I3) (y : I4) : E34 (x ⊗ₜ[K] y) = 0 := by
  apply Subtype.ext
  calc
    (E34 (x ⊗ₜ[K] y) : K) = (x : K) * (y : K) :=
      three_idempotent.coe_tensorCoalgebraSpanEquiv_tmul four_idempotent x y
    _ = Coalgebra.counit (R := K) (x ⊗ₜ[K] y) := by
      simp only [TensorProduct.counit_tmul,
        three_idempotent.coalgebraSpan_counit_apply,
        four_idempotent.coalgebraSpan_counit_apply, smul_eq_mul, mul_comm]
    _ = 0 := by
      rw [tensor_span_three_four_eq_zero (x ⊗ₜ[K] y), map_zero]

example (z : I34) : E34.symm z = 0 := by
  rw [three_idempotent.tensorCoalgebraSpanEquiv_symm_apply four_idempotent]
  change (z : K) • t34 = 0
  rw [tensor_span_three_four_eq_zero t34, smul_zero]

example : E34 t34 = q34 ∧ q34 = 0 ∧ E34.symm q34 = t34 := by
  have hg : E34 t34 = q34 :=
    three_idempotent.tensorCoalgebraSpanEquiv_generator four_idempotent
  refine ⟨hg, ?_, ?_⟩
  · rw [← hg, tensor_span_three_four_eq_zero t34, map_zero]
  · rw [← hg, E34.symm_apply_apply]

example : Coalgebra.counit (R := K) t34 = 0 ∧ Coalgebra.comul (R := K) t34 = 0 := by
  constructor
  · rw [tensor_span_three_four_eq_zero t34, map_zero]
  · rw [three_idempotent.tensorCoalgebraSpan_comul_apply four_idempotent,
      tensor_span_three_four_eq_zero t34, TensorProduct.zero_tmul]

example (x : T34) :
    TensorProduct.map E34.toLinearEquiv.toLinearMap E34.toLinearEquiv.toLinearMap
        (Coalgebra.comul (R := K) x) =
      (three_idempotent.mul four_idempotent).coalgebraSpan.comul (E34 x) := by
  exact CoalgHomClass.map_comp_comul_apply E34 x

example (z : I34) :
    TensorProduct.map E34.symm.toLinearEquiv.toLinearMap E34.symm.toLinearEquiv.toLinearMap
        ((three_idempotent.mul four_idempotent).coalgebraSpan.comul z) =
      Coalgebra.comul (R := K) (E34.symm z) := by
  exact CoalgHomClass.map_comp_comul_apply E34.symm z

example : (1 : K) ≠ 3 ∧ (1 : K) • g3 = (3 : K) • g3 := by
  constructor
  · decide
  · rw [one_smul, three_idempotent.smul_span_singleton]

example : (1 : K) ≠ 4 ∧ (1 : K) • g4 = (4 : K) • g4 := by
  constructor
  · decide
  · rw [one_smul, four_idempotent.smul_span_singleton]

example : (1 : K) ≠ 3 ∧ (1 : K) • t33 = (3 : K) • t33 := by
  constructor
  · decide
  · apply EquivLike.injective E33
    have hg : E33 t33 = q33 :=
      three_idempotent.tensorCoalgebraSpanEquiv_generator three_idempotent
    simp only [map_smul, hg, one_smul]
    have hq := (three_idempotent.mul three_idempotent).smul_span_singleton q33
    calc
      q33 = ((3 : K) * 3) • q33 := hq.symm
      _ = (3 : K) • q33 := congrArg (fun r : K ↦ r • q33) three_mul_three

example : Coalgebra.counit (R := K) t33 ≠ 1 := by
  rw [tensor33_counit_generator]
  exact three_ne_one

end IdempotentIdealTensorExamples
