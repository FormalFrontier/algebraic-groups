module

public import AlgebraicGroups.Algebra.Coalgebra.Quotient
public import Mathlib.RingTheory.Bialgebra.MonoidAlgebra
public import Mathlib.RingTheory.Finiteness.Cardinality
import Mathlib.LinearAlgebra.Finsupp.LSum
import Mathlib.Tactic.NormNum

/-!
# Nonzero proper coideal images in integer group algebras

Doubling the indices of `AddMonoidAlgebra ℤ ℤ` maps the coideal generated by
`e₀ - e₁` onto the nonzero proper coideal generated by `e₀ - e₂`, where
`eₘ = single m 1`. The ambient morphism is not surjective.

The doubled first-coordinate projection from `AddMonoidAlgebra ℤ (ℤ × ℤ)` to
`AddMonoidAlgebra ℤ ℤ` has the same nonzero proper coideal image and is neither
injective nor surjective. Its canonical induced quotient map sends the class
of `e₍₁,₀₎` to the class of `e₀`, preserving the diagonal comultiplication.
All ambient modules are infinite and carry Mathlib's full coalgebra structures.

The input coideals are checked directly: their counits vanish, and their two
basis vectors become equal in the module quotient, so their diagonal tensor
squares agree. Image coideality then uses `Submodule.IsCoideal.map` with the
stock bialgebra-homomorphism type as the generic morphism type. These group-algebra
examples introduce no global coideal instances or new coalgebra structures.

## References

Mathlib's `RingTheory.Bialgebra.MonoidAlgebra` supplies the lawful morphisms,
group-like basis vectors and their formulas. The span and quotient calculations
use `LinearAlgebra.Span.Basic` and `LinearAlgebra.Quotient.Basic`. The quotient
morphism and its characteristic API are those of
`AlgebraicGroups.Algebra.Coalgebra.Quotient`.
-/

@[expose] public section

noncomputable section

open scoped TensorProduct

namespace AddMonoidAlgebra

private abbrev double : ℤ →+ ℤ := AddMonoidHom.id ℤ + AddMonoidHom.id ℤ

private abbrev doubleFst : (ℤ × ℤ) →+ ℤ := double.comp (AddMonoidHom.fst ℤ ℤ)

private abbrev difference {M : Type*} (a b : M) : AddMonoidAlgebra ℤ M :=
  single a 1 - single b 1

private abbrev differenceSpan {M : Type*} (a b : M) : Submodule ℤ (AddMonoidAlgebra ℤ M) :=
  Submodule.span ℤ {difference a b}

private lemma difference_quotient_eq {M : Type*} (a b : M) :
    (differenceSpan a b).mkQ (single a 1) = (differenceSpan a b).mkQ (single b 1) := by
  apply sub_eq_zero.mp
  rw [← map_sub]
  exact (Submodule.Quotient.mk_eq_zero (differenceSpan a b)).mpr
    (Submodule.mem_span_singleton_self _)

-- This helper is only the direct two-field check for the spans used below.
private lemma differenceSpan_isCoideal {M : Type*} [AddMonoid M] (a b : M) :
    (differenceSpan a b).IsCoideal := by
  have ha := isGroupLikeElem_single_one (R := ℤ) (A := ℤ) a
  have hb := isGroupLikeElem_single_one (R := ℤ) (A := ℤ) b
  have hε : Coalgebra.counit (R := ℤ) (difference a b) = 0 := by
    rw [map_sub, ha.counit_eq_one, hb.counit_eq_one, sub_self]
  have hΔ : TensorProduct.map (differenceSpan a b).mkQ (differenceSpan a b).mkQ
      (Coalgebra.comul (R := ℤ) (difference a b)) = 0 := by
    rw [map_sub, ha.comul_eq_tmul_self, hb.comul_eq_tmul_self, map_sub,
      TensorProduct.map_tmul, TensorProduct.map_tmul, difference_quotient_eq a b, sub_self]
  constructor
  · intro x hx
    obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.mp hx
    simp only [map_smul, hε, smul_zero]
  · intro x hx
    obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.mp hx
    change TensorProduct.map (differenceSpan a b).mkQ (differenceSpan a b).mkQ
      (Coalgebra.comul (R := ℤ) (r • difference a b)) = 0
    rw [map_smul, map_smul, hΔ, smul_zero]

private lemma difference_ne_zero {M : Type*} {a b : M} (hab : a ≠ b) :
    difference a b ≠ 0 := by
  classical
  intro h
  have ha := congrArg (fun x : AddMonoidAlgebra ℤ M => x.coeff a) h
  simp [difference, hab] at ha

private lemma differenceSpan_ne_bot {M : Type*} {a b : M} (hab : a ≠ b) :
    differenceSpan a b ≠ ⊥ := by
  intro h
  apply difference_ne_zero hab
  have hx : difference a b ∈ differenceSpan a b :=
    Submodule.mem_span_singleton_self (difference a b)
  rw [h, Submodule.mem_bot] at hx
  exact hx

private lemma differenceSpan_ne_top {M : Type*} [AddMonoid M] (a b : M) :
    differenceSpan a b ≠ ⊤ := by
  intro h
  have hx : single a (1 : ℤ) ∈ differenceSpan a b := h.symm ▸ Submodule.mem_top
  have hε := (differenceSpan_isCoideal a b).counit_eq_zero hx
  rw [(isGroupLikeElem_single_one (R := ℤ) (A := ℤ) a).counit_eq_one] at hε
  norm_num at hε

private lemma differenceSpan_map {M N : Type*} [AddMonoid M] [AddMonoid N]
    (α : M →+ N) (a b : M) :
    (differenceSpan a b).map (mapDomainBialgHom ℤ α : AddMonoidAlgebra ℤ M →ₗ[ℤ]
      AddMonoidAlgebra ℤ N) = differenceSpan (α a) (α b) := by
  simp only [differenceSpan, Submodule.map_span, Set.image_singleton,
    BialgHom.coe_toLinearMap, difference, map_sub, mapDomainBialgHom_single]

private lemma mapDomainBialgHom_coeff_one_eq_zero {M : Type*} [AddMonoid M]
    (α : M →+ ℤ) (hα : ∀ m, α m ≠ 1) (x : AddMonoidAlgebra ℤ M) :
    (mapDomainBialgHom ℤ α x).coeff 1 = 0 := by
  classical
  induction x using induction_linear with
  | zero => simp only [map_zero, coeff_zero, Finsupp.zero_apply]
  | add x y hx hy =>
    simp only [map_add, coeff_add, Finsupp.add_apply, hx, hy, add_zero]
  | single m r =>
    rw [mapDomainBialgHom_single, coeff_single, Finsupp.single_apply, ite_eq_right (hα m)]

private lemma mapDomainBialgHom_not_surjective {M : Type*} [AddMonoid M]
    (α : M →+ ℤ) (hα : ∀ m, α m ≠ 1) :
    ¬ Function.Surjective (mapDomainBialgHom ℤ α) := by
  intro h
  obtain ⟨x, hx⟩ := h (single 1 1)
  have h1 := mapDomainBialgHom_coeff_one_eq_zero α hα x
  rw [hx] at h1
  norm_num at h1

private lemma double_ne_one (n : ℤ) : double n ≠ 1 := by
  change n + n ≠ 1
  omega

/-- Doubling on the infinite integer group algebra has a nonzero proper coideal image:
`ℤ(e₀ - e₁)` maps onto `ℤ(e₀ - e₂)`. The ambient morphism is not surjective. -/
theorem mapDomainBialgHom_double_coideal_image :
    let f := mapDomainBialgHom ℤ (AddMonoidHom.id ℤ + AddMonoidHom.id ℤ)
    let I := Submodule.span ℤ {single (0 : ℤ) 1 - single (1 : ℤ) 1}
    let J := I.map (f : AddMonoidAlgebra ℤ ℤ →ₗ[ℤ] AddMonoidAlgebra ℤ ℤ)
    I.IsCoideal ∧ J.IsCoideal ∧
      J = Submodule.span ℤ {single (0 : ℤ) 1 - single (2 : ℤ) 1} ∧
      I ≠ ⊥ ∧ I ≠ ⊤ ∧ J ≠ ⊥ ∧ J ≠ ⊤ ∧
      ¬ Function.Surjective f ∧ ¬ Module.Finite ℤ (AddMonoidAlgebra ℤ ℤ) := by
  change (differenceSpan (0 : ℤ) 1).IsCoideal ∧
    ((differenceSpan (0 : ℤ) 1).map (mapDomainBialgHom ℤ double :
      AddMonoidAlgebra ℤ ℤ →ₗ[ℤ] AddMonoidAlgebra ℤ ℤ)).IsCoideal ∧ _
  have hI := differenceSpan_isCoideal (0 : ℤ) 1
  refine ⟨hI, hI.map (mapDomainBialgHom ℤ double), ?_⟩
  have hJ : (differenceSpan (0 : ℤ) 1).map (mapDomainBialgHom ℤ double :
      AddMonoidAlgebra ℤ ℤ →ₗ[ℤ] AddMonoidAlgebra ℤ ℤ) = differenceSpan (0 : ℤ) 2 := by
    simpa only [show double 0 = 0 from rfl, show double 1 = 2 from rfl] using
      differenceSpan_map double (0 : ℤ) 1
  rw [hJ]
  exact ⟨rfl, differenceSpan_ne_bot (by norm_num), differenceSpan_ne_top 0 1,
    differenceSpan_ne_bot (by norm_num), differenceSpan_ne_top 0 2,
    mapDomainBialgHom_not_surjective double double_ne_one,
    Module.not_finite_of_infinite_basis (basis ℤ ℤ)⟩

private lemma doubleFst_not_injective :
    ¬ Function.Injective (mapDomainBialgHom ℤ doubleFst) := by
  intro h
  have hz : mapDomainBialgHom ℤ doubleFst (difference (0, 0) (0, 1)) = 0 := by
    simp [difference, map_sub, mapDomainBialgHom_single, doubleFst, double]
  have heq := h (hz.trans (map_zero _).symm)
  exact difference_ne_zero (by norm_num) heq

/-- The doubled first-coordinate projection between infinite integer group algebras is
neither injective nor surjective, but carries the nonzero proper coideal
`ℤ(e₍₀,₀₎ - e₍₁,₀₎)` onto the nonzero proper coideal `ℤ(e₀ - e₂)`. -/
theorem mapDomainBialgHom_double_fst_coideal_image :
    let α := (AddMonoidHom.id ℤ + AddMonoidHom.id ℤ).comp (AddMonoidHom.fst ℤ ℤ)
    let f := mapDomainBialgHom ℤ α
    let I := Submodule.span ℤ {single ((0, 0) : ℤ × ℤ) 1 - single (1, 0) 1}
    let J := I.map (f : AddMonoidAlgebra ℤ (ℤ × ℤ) →ₗ[ℤ] AddMonoidAlgebra ℤ ℤ)
    I.IsCoideal ∧ J.IsCoideal ∧
      J = Submodule.span ℤ {single (0 : ℤ) 1 - single (2 : ℤ) 1} ∧
      I ≠ ⊥ ∧ I ≠ ⊤ ∧ J ≠ ⊥ ∧ J ≠ ⊤ ∧
      ¬ Function.Injective f ∧ ¬ Function.Surjective f ∧
      ¬ Module.Finite ℤ (AddMonoidAlgebra ℤ (ℤ × ℤ)) ∧
      ¬ Module.Finite ℤ (AddMonoidAlgebra ℤ ℤ) := by
  change (differenceSpan ((0, 0) : ℤ × ℤ) (1, 0)).IsCoideal ∧
    ((differenceSpan ((0, 0) : ℤ × ℤ) (1, 0)).map (mapDomainBialgHom ℤ doubleFst :
      AddMonoidAlgebra ℤ (ℤ × ℤ) →ₗ[ℤ] AddMonoidAlgebra ℤ ℤ)).IsCoideal ∧ _
  have hI := differenceSpan_isCoideal ((0, 0) : ℤ × ℤ) (1, 0)
  refine ⟨hI, hI.map (mapDomainBialgHom ℤ doubleFst), ?_⟩
  have hJ : (differenceSpan ((0, 0) : ℤ × ℤ) (1, 0)).map (mapDomainBialgHom ℤ doubleFst :
      AddMonoidAlgebra ℤ (ℤ × ℤ) →ₗ[ℤ] AddMonoidAlgebra ℤ ℤ) =
      differenceSpan (0 : ℤ) 2 := by
    simpa only [show doubleFst (0, 0) = 0 from rfl,
      show doubleFst (1, 0) = 2 from rfl] using
      differenceSpan_map doubleFst ((0, 0) : ℤ × ℤ) (1, 0)
  rw [hJ]
  exact ⟨rfl, differenceSpan_ne_bot (by norm_num), differenceSpan_ne_top (0, 0) (1, 0),
    differenceSpan_ne_bot (by norm_num), differenceSpan_ne_top 0 2,
    doubleFst_not_injective,
    mapDomainBialgHom_not_surjective doubleFst (fun n => double_ne_one n.1),
    Module.not_finite_of_infinite_basis (basis (ℤ × ℤ) ℤ),
    Module.not_finite_of_infinite_basis (basis ℤ ℤ)⟩

/-- On the doubled-projection coideal quotients, the canonical quotient map sends
`[e₍₁,₀₎]` to `[e₀]`, and sends its diagonal comultiplication to `[e₀] ⊗ [e₀]`.
The map is the linear map underlying `Submodule.mapQCoalgHom`. -/
theorem mapDomainBialgHom_double_fst_mapQ :
    let α := (AddMonoidHom.id ℤ + AddMonoidHom.id ℤ).comp (AddMonoidHom.fst ℤ ℤ)
    let f := mapDomainBialgHom ℤ α
    let I := Submodule.span ℤ {single ((0, 0) : ℤ × ℤ) 1 - single (1, 0) 1}
    let J := I.map (f : AddMonoidAlgebra ℤ (ℤ × ℤ) →ₗ[ℤ] AddMonoidAlgebra ℤ ℤ)
    let g := I.mapQ J (f : AddMonoidAlgebra ℤ (ℤ × ℤ) →ₗ[ℤ] AddMonoidAlgebra ℤ ℤ)
      (Submodule.le_comap_map _ _)
    g (I.mkQ (single (1, 0) 1)) = J.mkQ (single 0 1) ∧
      TensorProduct.map g g (TensorProduct.map I.mkQ I.mkQ
        (Coalgebra.comul (R := ℤ) (single (1, 0) 1))) =
        J.mkQ (single 0 1) ⊗ₜ[ℤ] J.mkQ (single 0 1) := by
  let f := mapDomainBialgHom ℤ doubleFst
  let I := differenceSpan ((0, 0) : ℤ × ℤ) (1, 0)
  let J := I.map (f : AddMonoidAlgebra ℤ (ℤ × ℤ) →ₗ[ℤ] AddMonoidAlgebra ℤ ℤ)
  let : I.IsCoideal := differenceSpan_isCoideal _ _
  let : J.IsCoideal := (differenceSpan_isCoideal ((0, 0) : ℤ × ℤ) (1, 0)).map f
  let h : I ≤ J.comap f.toCoalgHom.toLinearMap := Submodule.le_comap_map _ _
  let g := I.mapQCoalgHom J f.toCoalgHom h
  have hg : g.toLinearMap = I.mapQ J
      (f : AddMonoidAlgebra ℤ (ℤ × ℤ) →ₗ[ℤ] AddMonoidAlgebra ℤ ℤ)
      (Submodule.le_comap_map _ _) := Submodule.mapQCoalgHom_toLinearMap _ _ _ _
  have hJ : J = differenceSpan (0 : ℤ) 2 := by
    simpa only [J, I, f, show doubleFst (0, 0) = 0 from rfl,
      show doubleFst (1, 0) = 2 from rfl] using
      differenceSpan_map doubleFst ((0, 0) : ℤ × ℤ) (1, 0)
  have h02 : J.mkQ (single 2 1) = J.mkQ (single 0 1) := by
    rw [hJ]
    exact (difference_quotient_eq (0 : ℤ) 2).symm
  have hrep : g (I.mkQ (single (1, 0) 1)) = J.mkQ (single 0 1) := by
    rw [Submodule.mkQ_apply, Submodule.mapQCoalgHom_mk]
    simpa only [f, BialgHom.toCoalgHom_apply, mapDomainBialgHom_single,
      show doubleFst (1, 0) = 2 from rfl, Submodule.mkQ_apply] using h02
  change (I.mapQ J _ _) (I.mkQ (single (1, 0) 1)) = J.mkQ (single 0 1) ∧ _
  rw [← hg]
  refine ⟨hrep, ?_⟩
  have hΔ := CoalgHomClass.map_comp_comul_apply g (I.mkQ (single (1, 0) 1))
  rw [hrep] at hΔ
  simpa only [CoalgHom.toLinearMap_eq_coe, Submodule.mkQ_apply,
    Coalgebra.Quotient.comul_mk,
    (isGroupLikeElem_single_one (R := ℤ) (A := ℤ) (0 : ℤ)).comul_eq_tmul_self,
    TensorProduct.map_tmul] using hΔ

end AddMonoidAlgebra

/-! A chosen weak coalgebra structure with zero comultiplication and nonzero counit.
The basis-index permutation below preserves these data, without any coalgebra laws.
The coefficient at zero rules out a coideal containing the zeroth basis vector. -/

namespace Finsupp

section CoidealReflection

private abbrev coefficientCoalgebraStruct : CoalgebraStruct ℤ (ℕ →₀ ℤ) where
  comul := 0
  counit := Finsupp.lapply 0

attribute [local instance] coefficientCoalgebraStruct

private lemma coefficient_counit (x : ℕ →₀ ℤ) :
    Coalgebra.counit (R := ℤ) x = x 0 :=
  rfl

private lemma coefficient_comul (x : ℕ →₀ ℤ) :
    Coalgebra.comul (R := ℤ) x = 0 :=
  rfl

private abbrev coordinateSpan (n : ℕ) : Submodule ℤ (ℕ →₀ ℤ) :=
  Submodule.span ℤ {Finsupp.single n 1}

private def coordinateSwap : (ℕ →₀ ℤ) ≃ₗc[ℤ] (ℕ →₀ ℤ) where
  __ := (Finsupp.domLCongr (Equiv.swap (1 : ℕ) 2) : (ℕ →₀ ℤ) ≃ₗ[ℤ] (ℕ →₀ ℤ))
  counit_comp := by
    apply LinearMap.ext
    intro x
    change x ((Equiv.swap (1 : ℕ) 2).symm 0) = x 0
    rw [Equiv.symm_swap,
      Equiv.swap_apply_of_ne_of_ne (by norm_num) (by norm_num)]
  map_comp_comul := by
    apply LinearMap.ext
    intro x
    change TensorProduct.map
      (Finsupp.domLCongr (Equiv.swap (1 : ℕ) 2) :
        (ℕ →₀ ℤ) ≃ₗ[ℤ] (ℕ →₀ ℤ)).toLinearMap
      (Finsupp.domLCongr (Equiv.swap (1 : ℕ) 2) :
        (ℕ →₀ ℤ) ≃ₗ[ℤ] (ℕ →₀ ℤ)).toLinearMap 0 = 0
    exact map_zero _

private lemma coordinateSwap_single (n : ℕ) (r : ℤ) :
    coordinateSwap (Finsupp.single n r) = Finsupp.single (Equiv.swap (1 : ℕ) 2 n) r :=
  Finsupp.domLCongr_single (R := ℤ) _ _ _

private lemma coordinateSpan_isCoideal {n : ℕ} (hn : n ≠ 0) :
    (coordinateSpan n).IsCoideal where
  counit_eq_zero := by
    intro x hx
    obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.mp hx
    change (r • Finsupp.single n (1 : ℤ)) 0 = 0
    simp [hn]
  map_mkQ_comul_eq_zero := by
    intro x hx
    rw [coefficient_comul, map_zero]

private lemma coordinateSpan_zero_not_isCoideal : ¬ (coordinateSpan 0).IsCoideal := by
  intro h
  have hε := h.counit_eq_zero
    (Submodule.mem_span_singleton_self (Finsupp.single (0 : ℕ) (1 : ℤ)))
  rw [coefficient_counit] at hε
  norm_num at hε

private lemma coordinateSpan_ne_bot (n : ℕ) : coordinateSpan n ≠ ⊥ := by
  intro h
  have hx : Finsupp.single n (1 : ℤ) ∈ coordinateSpan n :=
    Submodule.mem_span_singleton_self _
  rw [h, Submodule.mem_bot] at hx
  have hcoeff := congrArg (fun x : ℕ →₀ ℤ => x n) hx
  norm_num at hcoeff

private lemma coordinateSpan_ne_top {n : ℕ} (hn : n ≠ 0) : coordinateSpan n ≠ ⊤ := by
  intro h
  have hx : Finsupp.single (0 : ℕ) (1 : ℤ) ∈ coordinateSpan n :=
    h.symm ▸ Submodule.mem_top
  have hε := (coordinateSpan_isCoideal hn).counit_eq_zero hx
  rw [coefficient_counit] at hε
  norm_num at hε

private lemma coordinateSpan_ne {m n : ℕ} (hmn : m ≠ n) :
    coordinateSpan m ≠ coordinateSpan n := by
  intro h
  have hx : Finsupp.single m (1 : ℤ) ∈ coordinateSpan n :=
    h ▸ Submodule.mem_span_singleton_self _
  obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp hx
  have hcoeff := congrArg (fun x : ℕ →₀ ℤ => x m) hr
  simp [hmn] at hcoeff

private lemma coordinateSpan_map (n : ℕ) :
    (coordinateSpan n).map (coordinateSwap : (ℕ →₀ ℤ) →ₗ[ℤ] (ℕ →₀ ℤ)) =
      coordinateSpan (Equiv.swap (1 : ℕ) 2 n) := by
  change (Submodule.span ℤ {Finsupp.single n (1 : ℤ)}).map
    (coordinateSwap : (ℕ →₀ ℤ) →ₗ[ℤ] (ℕ →₀ ℤ)) =
      Submodule.span ℤ {Finsupp.single (Equiv.swap (1 : ℕ) 2 n) 1}
  rw [Submodule.map_span, Set.image_singleton]
  change Submodule.span ℤ {coordinateSwap (Finsupp.single n 1)} = _
  rw [coordinateSwap_single]

-- Both new transport proofs are used on distinct proper nonzero coideals. The final
-- negative case also uses reflection: the coefficient counit does not vanish on δ₀.
private theorem coefficient_coideal_reflection :
    (coordinateSpan 1).IsCoideal ∧ (coordinateSpan 2).IsCoideal ∧
      (coordinateSpan 1).map (coordinateSwap : (ℕ →₀ ℤ) →ₗ[ℤ] (ℕ →₀ ℤ)) =
        coordinateSpan 2 ∧
      coordinateSpan 1 ≠ coordinateSpan 2 ∧
      coordinateSpan 1 ≠ ⊥ ∧ coordinateSpan 1 ≠ ⊤ ∧
      coordinateSpan 2 ≠ ⊥ ∧ coordinateSpan 2 ≠ ⊤ ∧
      ¬ (coordinateSpan 0).IsCoideal ∧
      ¬ ((coordinateSpan 0).map
        (coordinateSwap : (ℕ →₀ ℤ) →ₗ[ℤ] (ℕ →₀ ℤ))).IsCoideal := by
  have hmap : (coordinateSpan 1).map
      (coordinateSwap : (ℕ →₀ ℤ) →ₗ[ℤ] (ℕ →₀ ℤ)) = coordinateSpan 2 := by
    simpa only [Equiv.swap_apply_left] using coordinateSpan_map 1
  have hH : (coordinateSpan 2).IsCoideal := coordinateSpan_isCoideal (by norm_num)
  have hImage : ((coordinateSpan 1).map
      (coordinateSwap : (ℕ →₀ ℤ) →ₗ[ℤ] (ℕ →₀ ℤ))).IsCoideal := hmap.symm ▸ hH
  have hI : (coordinateSpan 1).IsCoideal :=
    Submodule.IsCoideal.of_map coordinateSwap coordinateSwap.toLinearEquiv.bijective hImage
  have hH' : (coordinateSpan 2).IsCoideal := hmap ▸
    (Submodule.isCoideal_map_iff_of_bijective coordinateSwap
      coordinateSwap.toLinearEquiv.bijective).2 hI
  refine ⟨hI, hH', hmap, coordinateSpan_ne (by norm_num), coordinateSpan_ne_bot 1,
    coordinateSpan_ne_top (by norm_num), coordinateSpan_ne_bot 2,
    coordinateSpan_ne_top (by norm_num), coordinateSpan_zero_not_isCoideal, ?_⟩
  intro hzero
  exact coordinateSpan_zero_not_isCoideal
    ((Submodule.isCoideal_map_iff_of_bijective coordinateSwap
      coordinateSwap.toLinearEquiv.bijective).1 hzero)

end CoidealReflection

end Finsupp
