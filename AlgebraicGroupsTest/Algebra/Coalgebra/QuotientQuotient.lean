module

public import AlgebraicGroups.Algebra.Coalgebra.Quotient
public import Mathlib.RingTheory.Bialgebra.MonoidAlgebra
public import Mathlib.Data.ZMod.Basic
public import Mathlib.Tactic.NormNum

/-!
# Effective iterated quotients, with and without counit laws

The lawful examples use `AddMonoidAlgebra (ZMod 6) ℤ`. The group is infinite,
although each vector has finite support, and the coefficient ring has nonzero
zero divisors. The lines generated by `δ₂ - δ₀` and `δ₁ - δ₀` are nonzero,
incomparable coideals with proper join. Quotienting successively kills a
nonzero first-stage class, while the class of `δ₀` survives. A twice-descended
coefficient at `3` also distinguishes the final classes of `δ₃` and `δ₀`.

The second family equips `ℕ →₀ ZMod 6` locally with zero comultiplication and
zero counit. Its two coordinate lines are again nonzero incomparable coideals
with proper join and effective successive quotients. A twice-descended
coordinate, not the zero counit, witnesses a surviving class. The left
counit equation fails on that class's representative, as the tensor unitor
and coordinate evaluation show. All quotient structures are the canonical
ones; the zero-data structure is not a transported lawful coalgebra.

Mathlib supplies the group-like singletons, coefficient linear equivalence,
span and quotient maps, and tensor unitor. Coideal proofs use the two
coideal fields, extending the singleton calculations by linearity. Fixtures
and their instance attributes are private or section-local.
-/

@[expose] public section

noncomputable section

open Coalgebra
open scoped TensorProduct

namespace QuotientQuotient

private abbrev R := ZMod 6

private lemma coefficient_zero_divisors :
    (2 : R) ≠ 0 ∧ (3 : R) ≠ 0 ∧ (2 : R) * 3 = 0 := by
  decide

namespace Lawful

private abbrev A := AddMonoidAlgebra R ℤ

private abbrev delta (n : ℤ) : A := AddMonoidAlgebra.single n 1

private abbrev difference (n : ℤ) : A := delta n - delta 0

private abbrev line (n : ℤ) : Submodule R A :=
  Submodule.span R ({difference n} : Set A)

private def coordinate (n : ℤ) : A →ₗ[R] R :=
  (Finsupp.lapply n).comp (AddMonoidAlgebra.coeffLinearEquiv R).toLinearMap

private lemma coordinate_delta (k n : ℤ) :
    coordinate k (delta n) = if n = k then 1 else 0 := by
  simp [coordinate, delta, Finsupp.lapply, Finsupp.single_apply]

private lemma difference_mem (n : ℤ) : difference n ∈ line n :=
  Submodule.mem_span_singleton_self _

private lemma counit_delta (n : ℤ) : counit (R := R) (delta n) = 1 :=
  (AddMonoidAlgebra.isGroupLikeElem_single_one (R := R) (A := R) n).counit_eq_one

private lemma comul_delta (n : ℤ) :
    comul (R := R) (delta n) = delta n ⊗ₜ[R] delta n :=
  (AddMonoidAlgebra.isGroupLikeElem_single_one (R := R) (A := R) n).comul_eq_tmul_self

private lemma line_isCoideal (n : ℤ) : (line n).IsCoideal where
  counit_eq_zero := by
    have hk : line n ≤ LinearMap.ker (counit (R := R)) := by
      apply (Submodule.span_singleton_le_iff_mem _ _).mpr
      simp only [LinearMap.mem_ker, difference, map_sub, counit_delta, sub_self]
    exact fun x hx => hk hx
  map_mkQ_comul_eq_zero := by
    have hq : (line n).mkQ (delta n) = (line n).mkQ (delta 0) := by
      apply sub_eq_zero.mp
      rw [← map_sub, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact difference_mem n
    have hk : line n ≤ LinearMap.ker
        ((TensorProduct.map (line n).mkQ (line n).mkQ).comp (comul (R := R))) := by
      apply (Submodule.span_singleton_le_iff_mem _ _).mpr
      simp only [LinearMap.mem_ker, LinearMap.comp_apply, difference, map_sub,
        comul_delta, TensorProduct.map_tmul, hq, sub_self]
    exact fun x hx => hk hx

private lemma line_le_coordinate_ker {n k : ℤ} (hk : k ≠ 0) (hkn : k ≠ n) :
    line n ≤ LinearMap.ker (coordinate k) := by
  apply (Submodule.span_singleton_le_iff_mem _ _).mpr
  change coordinate k (delta n - delta 0) = 0
  rw [map_sub, coordinate_delta, coordinate_delta,
    ite_eq_right (Ne.symm hkn), ite_eq_right (Ne.symm hk), sub_self]

private lemma line_ne_bot {n : ℤ} (hn : n ≠ 0) : line n ≠ ⊥ := by
  intro h
  have hx := difference_mem n
  rw [h, Submodule.mem_bot] at hx
  have hc := congrArg (coordinate n) hx
  change coordinate n (delta n - delta 0) = coordinate n 0 at hc
  rw [map_sub, coordinate_delta, coordinate_delta, map_zero,
    ite_eq_left rfl, ite_eq_right (Ne.symm hn), sub_zero] at hc
  have h10 : (1 : R) ≠ 0 := by decide
  exact h10 hc

private lemma line_not_le {m n : ℤ} (hm : m ≠ 0) (hmn : m ≠ n) :
    ¬ line m ≤ line n := by
  intro h
  have hc := (line_le_coordinate_ker hm hmn) (h (difference_mem m))
  change coordinate m (delta m - delta 0) = 0 at hc
  rw [map_sub, coordinate_delta, coordinate_delta,
    ite_eq_left rfl, ite_eq_right (Ne.symm hm), sub_zero] at hc
  have h10 : (1 : R) ≠ 0 := by decide
  exact h10 hc

private abbrev I : Submodule R A := line 2
private abbrev H : Submodule R A := line 1
private abbrev J : Submodule R A := I ⊔ H

private lemma i_isCoideal : I.IsCoideal := line_isCoideal 2
private lemma h_isCoideal : H.IsCoideal := line_isCoideal 1
private lemma j_isCoideal : J.IsCoideal := i_isCoideal.sup h_isCoideal

attribute [local instance] i_isCoideal h_isCoideal j_isCoideal

private lemma lines_nonzero_incomparable :
    I ≠ ⊥ ∧ H ≠ ⊥ ∧ ¬ I ≤ H ∧ ¬ H ≤ I := by
  exact ⟨line_ne_bot (by norm_num), line_ne_bot (by norm_num),
    line_not_le (by norm_num) (by norm_num), line_not_le (by norm_num) (by norm_num)⟩

private lemma i_lt_j : I < J := by
  refine lt_of_le_of_ne le_sup_left ?_
  intro h
  apply lines_nonzero_incomparable.2.2.2
  rw [h]
  exact le_sup_right

private lemma j_lt_top : J < ⊤ := by
  apply lt_top_iff_ne_top.mpr
  intro h
  have hc := j_isCoideal.counit_eq_zero
    (show delta 0 ∈ J by rw [h]; exact Submodule.mem_top)
  rw [counit_delta] at hc
  have h10 : (1 : R) ≠ 0 := by decide
  exact h10 hc

private abbrev K : Submodule R (A ⧸ I) := H.map I.mkQ

private lemma k_isCoideal : K.IsCoideal :=
  h_isCoideal.map (Coalgebra.Quotient.mkQCoalgHom I)

attribute [local instance] k_isCoideal

private abbrev double (x : A) : (A ⧸ I) ⧸ K := K.mkQ (I.mkQ x)

private lemma larger_image : J.map I.mkQ = K := by
  simp only [J, Submodule.map_sup, Submodule.mkQ_map_self, bot_sup_eq]

private lemma first_difference_ne_zero : I.mkQ (difference 1) ≠ 0 := by
  intro h
  have hm : difference 1 ∈ I := (Submodule.Quotient.mk_eq_zero I).mp h
  exact lines_nonzero_incomparable.2.2.2
    ((Submodule.span_singleton_le_iff_mem _ _).mpr hm)

private lemma first_difference_mem_image : I.mkQ (difference 1) ∈ K :=
  Submodule.mem_map.mpr ⟨difference 1, difference_mem 1, rfl⟩

private lemma double_difference_zero : double (difference 1) = 0 :=
  (Submodule.Quotient.mk_eq_zero K).mpr first_difference_mem_image

private lemma double_counit (x : A) :
    counit (R := R) (double x) = counit (R := R) x := by
  simp only [double, Submodule.mkQ_apply, Coalgebra.Quotient.counit_mk]

private lemma double_comul (x : A) :
    comul (R := R) (double x) =
      TensorProduct.map K.mkQ K.mkQ (TensorProduct.map I.mkQ I.mkQ (comul x)) := by
  simp only [double, Submodule.mkQ_apply, Coalgebra.Quotient.comul_mk]

private lemma double_left_counit (x : (A ⧸ I) ⧸ K) :
    (counit (R := R) (A := (A ⧸ I) ⧸ K)).rTensor ((A ⧸ I) ⧸ K)
        (comul (R := R) x) = (1 : R) ⊗ₜ[R] x :=
  LinearMap.congr_fun
    (Coalgebra.rTensor_counit_comp_comul (R := R) (A := (A ⧸ I) ⧸ K)) x

private lemma double_delta_zero_counit : counit (R := R) (double (delta 0)) = 1 := by
  rw [double_counit, counit_delta]

private lemma double_delta_zero_ne_zero : double (delta 0) ≠ 0 := by
  intro h
  have hc := congrArg (counit (R := R)) h
  rw [double_delta_zero_counit, map_zero] at hc
  have h10 : (1 : R) ≠ 0 := by decide
  exact h10 hc

private lemma image_nonzero_proper : K ≠ ⊥ ∧ K < ⊤ := by
  constructor
  · intro h
    have hm := first_difference_mem_image
    rw [h, Submodule.mem_bot] at hm
    exact first_difference_ne_zero hm
  · apply lt_top_iff_ne_top.mpr
    intro h
    apply double_delta_zero_ne_zero
    apply (Submodule.Quotient.mk_eq_zero K).mpr
    rw [h]
    exact Submodule.mem_top

private def coordinateThreeFirst : (A ⧸ I) →ₗ[R] R :=
  I.liftQ (coordinate 3) (line_le_coordinate_ker (by norm_num) (by norm_num))

private lemma image_le_coordinateThreeFirst_ker :
    K ≤ LinearMap.ker coordinateThreeFirst := by
  intro y hy
  obtain ⟨x, hx, rfl⟩ := Submodule.mem_map.mp hy
  change coordinate 3 x = 0
  exact line_le_coordinate_ker (by norm_num) (by norm_num) hx

private def coordinateThreeDouble : ((A ⧸ I) ⧸ K) →ₗ[R] R :=
  K.liftQ coordinateThreeFirst image_le_coordinateThreeFirst_ker

private lemma coordinateThree_double (x : A) :
    coordinateThreeDouble (double x) = coordinate 3 x := rfl

private lemma double_delta_three_ne_delta_zero : double (delta 3) ≠ double (delta 0) := by
  intro h
  have hc := congrArg coordinateThreeDouble h
  rw [coordinateThree_double, coordinateThree_double, coordinate_delta,
    coordinate_delta, ite_eq_left rfl, ite_eq_right (by decide : (0 : ℤ) ≠ 3)] at hc
  have h10 : (1 : R) ≠ 0 := by decide
  exact h10 hc

private lemma infinite_group : Infinite ℤ := inferInstance

private lemma quotient_equiv_toLinearEquiv :
    (Submodule.quotientQuotientCoalgEquivQuotientSup I H).toLinearEquiv =
      Submodule.quotientQuotientEquivQuotientSup I H :=
  Submodule.quotientQuotientCoalgEquivQuotientSup_toLinearEquiv I H

private lemma quotient_equiv_double_delta_zero :
    Submodule.quotientQuotientCoalgEquivQuotientSup I H (double (delta 0)) =
      J.mkQ (delta 0) :=
  Submodule.quotientQuotientCoalgEquivQuotientSup_mk_mk I H (delta 0)

private lemma quotient_equiv_symm_delta_zero :
    (Submodule.quotientQuotientCoalgEquivQuotientSup I H).symm (J.mkQ (delta 0)) =
      double (delta 0) :=
  Submodule.quotientQuotientCoalgEquivQuotientSup_symm_mk I H (delta 0)

private lemma quotient_equiv_comp_projections :
    (Submodule.quotientQuotientCoalgEquivQuotientSup I H).toCoalgHom.comp
        ((Coalgebra.Quotient.mkQCoalgHom K).comp (Coalgebra.Quotient.mkQCoalgHom I)) =
      Coalgebra.Quotient.mkQCoalgHom J :=
  Submodule.quotientQuotientCoalgEquivQuotientSup_comp_mkQCoalgHom I H

end Lawful

namespace Weak

private abbrev M := ℕ →₀ R

private def zeroData : CoalgebraStruct R M where
  comul := 0
  counit := 0

attribute [local instance] zeroData

private abbrev delta (n : ℕ) : M := Finsupp.single n 1

private abbrev line (n : ℕ) : Submodule R M :=
  Submodule.span R ({delta n} : Set M)

private def coordinate (n : ℕ) : M →ₗ[R] R := Finsupp.lapply n

private lemma coordinate_delta (k n : ℕ) :
    coordinate k (delta n) = if n = k then 1 else 0 := by
  simp [coordinate, delta, Finsupp.lapply, Finsupp.single_apply]

private lemma zero_comul (x : M) : comul (R := R) x = 0 := rfl
private lemma zero_counit (x : M) : counit (R := R) x = 0 := rfl

private lemma delta_mem (n : ℕ) : delta n ∈ line n :=
  Submodule.mem_span_singleton_self _

private lemma line_isCoideal (n : ℕ) : (line n).IsCoideal where
  counit_eq_zero := by
    intro x _hx
    rfl
  map_mkQ_comul_eq_zero := by
    intro x _hx
    rw [zero_comul, map_zero]

private lemma line_le_coordinate_ker {n k : ℕ} (hkn : k ≠ n) :
    line n ≤ LinearMap.ker (coordinate k) := by
  apply (Submodule.span_singleton_le_iff_mem _ _).mpr
  simp [LinearMap.mem_ker, coordinate_delta, Ne.symm hkn]

private lemma line_ne_bot (n : ℕ) : line n ≠ ⊥ := by
  intro h
  have hx := delta_mem n
  rw [h, Submodule.mem_bot] at hx
  have hc := congrArg (coordinate n) hx
  rw [coordinate_delta, map_zero, ite_eq_left rfl] at hc
  have h10 : (1 : R) ≠ 0 := by decide
  exact h10 hc

private lemma line_not_le {m n : ℕ} (hmn : m ≠ n) : ¬ line m ≤ line n := by
  intro h
  have hc := (line_le_coordinate_ker hmn) (h (delta_mem m))
  change coordinate m (delta m) = 0 at hc
  rw [coordinate_delta, ite_eq_left rfl] at hc
  have h10 : (1 : R) ≠ 0 := by decide
  exact h10 hc

private abbrev I : Submodule R M := line 2
private abbrev H : Submodule R M := line 1
private abbrev J : Submodule R M := I ⊔ H

private lemma i_isCoideal : I.IsCoideal := line_isCoideal 2
private lemma h_isCoideal : H.IsCoideal := line_isCoideal 1
private lemma j_isCoideal : J.IsCoideal := i_isCoideal.sup h_isCoideal

attribute [local instance] i_isCoideal h_isCoideal j_isCoideal

private lemma lines_nonzero_incomparable :
    I ≠ ⊥ ∧ H ≠ ⊥ ∧ ¬ I ≤ H ∧ ¬ H ≤ I := by
  exact ⟨line_ne_bot 2, line_ne_bot 1, line_not_le (by norm_num), line_not_le (by norm_num)⟩

private lemma join_le_coordinateZero_ker : J ≤ LinearMap.ker (coordinate 0) :=
  sup_le (line_le_coordinate_ker (by norm_num)) (line_le_coordinate_ker (by norm_num))

private lemma i_lt_j : I < J := by
  refine lt_of_le_of_ne le_sup_left ?_
  intro h
  apply lines_nonzero_incomparable.2.2.2
  rw [h]
  exact le_sup_right

private lemma j_lt_top : J < ⊤ := by
  apply lt_top_iff_ne_top.mpr
  intro h
  have hc := join_le_coordinateZero_ker
    (show delta 0 ∈ J by rw [h]; exact Submodule.mem_top)
  change coordinate 0 (delta 0) = 0 at hc
  rw [coordinate_delta, ite_eq_left rfl] at hc
  have h10 : (1 : R) ≠ 0 := by decide
  exact h10 hc

private abbrev K : Submodule R (M ⧸ I) := H.map I.mkQ

private lemma k_isCoideal : K.IsCoideal :=
  h_isCoideal.map (Coalgebra.Quotient.mkQCoalgHom I)

attribute [local instance] k_isCoideal

private abbrev double (x : M) : (M ⧸ I) ⧸ K := K.mkQ (I.mkQ x)

private lemma larger_image : J.map I.mkQ = K := by
  simp only [J, Submodule.map_sup, Submodule.mkQ_map_self, bot_sup_eq]

private lemma first_delta_one_ne_zero : I.mkQ (delta 1) ≠ 0 := by
  intro h
  have hm : delta 1 ∈ I := (Submodule.Quotient.mk_eq_zero I).mp h
  exact lines_nonzero_incomparable.2.2.2
    ((Submodule.span_singleton_le_iff_mem _ _).mpr hm)

private lemma first_delta_one_mem_image : I.mkQ (delta 1) ∈ K :=
  Submodule.mem_map.mpr ⟨delta 1, delta_mem 1, rfl⟩

private lemma double_delta_one_zero : double (delta 1) = 0 :=
  (Submodule.Quotient.mk_eq_zero K).mpr first_delta_one_mem_image

private def coordinateZeroFirst : (M ⧸ I) →ₗ[R] R :=
  I.liftQ (coordinate 0) (line_le_coordinate_ker (by norm_num))

private lemma image_le_coordinateZeroFirst_ker : K ≤ LinearMap.ker coordinateZeroFirst := by
  intro y hy
  obtain ⟨x, hx, rfl⟩ := Submodule.mem_map.mp hy
  change coordinate 0 x = 0
  exact line_le_coordinate_ker (by norm_num) hx

private def coordinateZeroDouble : ((M ⧸ I) ⧸ K) →ₗ[R] R :=
  K.liftQ coordinateZeroFirst image_le_coordinateZeroFirst_ker

private lemma coordinateZero_double (x : M) :
    coordinateZeroDouble (double x) = coordinate 0 x := rfl

private lemma double_delta_zero_readback : coordinateZeroDouble (double (delta 0)) = 1 := by
  rw [coordinateZero_double, coordinate_delta, ite_eq_left rfl]

private lemma double_delta_zero_ne_zero : double (delta 0) ≠ 0 := by
  intro h
  have hc := congrArg coordinateZeroDouble h
  rw [double_delta_zero_readback, map_zero] at hc
  have h10 : (1 : R) ≠ 0 := by decide
  exact h10 hc

private lemma image_nonzero_proper : K ≠ ⊥ ∧ K < ⊤ := by
  constructor
  · intro h
    have hm := first_delta_one_mem_image
    rw [h, Submodule.mem_bot] at hm
    exact first_delta_one_ne_zero hm
  · apply lt_top_iff_ne_top.mpr
    intro h
    apply double_delta_zero_ne_zero
    apply (Submodule.Quotient.mk_eq_zero K).mpr
    rw [h]
    exact Submodule.mem_top

private lemma quotient_comul_zero (L : Submodule R M) [L.IsCoideal] (x : M ⧸ L) :
    comul (R := R) x = 0 := by
  obtain ⟨m, rfl⟩ := L.mkQ_surjective x
  rw [Submodule.mkQ_apply, Coalgebra.Quotient.comul_mk, zero_comul, map_zero]

private lemma quotient_counit_zero (L : Submodule R M) [L.IsCoideal] (x : M ⧸ L) :
    counit (R := R) x = 0 := by
  obtain ⟨m, rfl⟩ := L.mkQ_surjective x
  rw [Submodule.mkQ_apply, Coalgebra.Quotient.counit_mk, zero_counit]

private lemma double_comul_zero (x : (M ⧸ I) ⧸ K) : comul (R := R) x = 0 := by
  obtain ⟨m, rfl⟩ := K.mkQ_surjective x
  rw [Submodule.mkQ_apply, Coalgebra.Quotient.comul_mk, quotient_comul_zero, map_zero]

private lemma double_counit_zero (x : (M ⧸ I) ⧸ K) : counit (R := R) x = 0 := by
  obtain ⟨m, rfl⟩ := K.mkQ_surjective x
  rw [Submodule.mkQ_apply, Coalgebra.Quotient.counit_mk, quotient_counit_zero]

private lemma sup_quotient_zero_data (x : M ⧸ J) :
    comul (R := R) x = 0 ∧ counit (R := R) x = 0 :=
  ⟨quotient_comul_zero J x, quotient_counit_zero J x⟩

private lemma left_counit_fails_on_delta_zero :
    (counit (R := R) (A := M)).rTensor M (comul (R := R) (delta 0)) ≠
      (1 : R) ⊗ₜ[R] delta 0 := by
  intro h
  have hzero : (0 : R ⊗[R] M) = (1 : R) ⊗ₜ[R] delta 0 := by
    simpa only [zero_comul, map_zero] using h
  have hm : (0 : M) = delta 0 := by
    simpa only [map_zero, TensorProduct.lid_tmul, one_smul] using
      congrArg (TensorProduct.lid R M) hzero
  have hc := congrArg (coordinate 0) hm
  rw [map_zero, coordinate_delta, ite_eq_left rfl] at hc
  have h10 : (1 : R) ≠ 0 := by decide
  exact h10 hc.symm

private lemma left_counit_law_fails :
    (counit (R := R) (A := M)).rTensor M ∘ₗ comul (R := R) ≠
      TensorProduct.mk R R M 1 := by
  intro h
  exact left_counit_fails_on_delta_zero (LinearMap.congr_fun h (delta 0))

private lemma quotient_equiv_toLinearEquiv :
    (Submodule.quotientQuotientCoalgEquivQuotientSup I H).toLinearEquiv =
      Submodule.quotientQuotientEquivQuotientSup I H :=
  Submodule.quotientQuotientCoalgEquivQuotientSup_toLinearEquiv I H

private lemma quotient_equiv_double_delta_zero :
    Submodule.quotientQuotientCoalgEquivQuotientSup I H (double (delta 0)) =
      J.mkQ (delta 0) :=
  Submodule.quotientQuotientCoalgEquivQuotientSup_mk_mk I H (delta 0)

private lemma quotient_equiv_symm_delta_zero :
    (Submodule.quotientQuotientCoalgEquivQuotientSup I H).symm (J.mkQ (delta 0)) =
      double (delta 0) :=
  Submodule.quotientQuotientCoalgEquivQuotientSup_symm_mk I H (delta 0)

private lemma quotient_equiv_comp_projections :
    (Submodule.quotientQuotientCoalgEquivQuotientSup I H).toCoalgHom.comp
        ((Coalgebra.Quotient.mkQCoalgHom K).comp (Coalgebra.Quotient.mkQCoalgHom I)) =
      Coalgebra.Quotient.mkQCoalgHom J :=
  Submodule.quotientQuotientCoalgEquivQuotientSup_comp_mkQCoalgHom I H

end Weak

end QuotientQuotient
