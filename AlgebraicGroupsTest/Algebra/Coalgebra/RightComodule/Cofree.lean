module

import AlgebraicGroups.Algebra.Coalgebra.RightComodule.Cofree
import AlgebraicGroupsTest.Algebra.Coalgebra.RightComodule

/-!
# Cofree lifts in the infinite natural-number diagonal coalgebra

The existing regular comodule on `MonoidAlgebra ℕ ℕ` embeds into the cofree
comodule cogenerated by that same nonscalar module. The full two-term diagonal
coaction and the lift of twice the identity survive projection. The embedding
is injective and nonzero but has proper range: the off-diagonal tensor is
nonzero and cannot be a comultiplication, by its two different counit
contractions. The stock model and its distinct basis points are reused from
`RightComoduleExamples`.
-/

open scoped TensorProduct
open Coalgebra.RightComodule

noncomputable section

namespace CofreeComoduleExamples

local notation "C" => MonoidAlgebra ℕ ℕ
local notation "X" => regular ℕ C
local notation "e₀" => (MonoidAlgebra.single (0 : ℕ) (1 : ℕ) : C)
local notation "e₁" => (MonoidAlgebra.single (1 : ℕ) (1 : ℕ) : C)

/-- The diagonal embedding keeps both distinct diagonal summands, and projection
recovers their sum. -/
theorem diagonal_sum :
    (coactionHom X) (e₀ + e₁) = e₀ ⊗ₜ[ℕ] e₀ + e₁ ⊗ₜ[ℕ] e₁ ∧
      cofreeProjection ℕ C C ((coactionHom X) (e₀ + e₁)) = e₀ + e₁ := by
  constructor
  · simp
  · exact LinearMap.congr_fun (cofreeProjection_comp_coactionHom X) (e₀ + e₁)

/-- Twice the identity is genuinely nonidentity on the nonscalar cogenerator. -/
theorem twice_id_ne_id :
    (2 : ℕ) • (LinearMap.id : C →ₗ[ℕ] C) ≠ LinearMap.id := by
  intro h
  have hc := congrArg (fun f : C →ₗ[ℕ] C ↦ (f e₀).coeff 0) h
  norm_num at hc

/-- The colinear lift of twice the identity has the full doubled diagonal value,
and its projection is the original doubled cogenerator map. -/
theorem twice_diagonal_lift (i : ℕ) :
    (cofreeLift X) ((2 : ℕ) • (LinearMap.id : C →ₗ[ℕ] C)) (MonoidAlgebra.single i 1) =
        (2 : ℕ) • ((MonoidAlgebra.single i 1 : C) ⊗ₜ[ℕ] MonoidAlgebra.single i 1) ∧
      cofreeProjection ℕ C C
        ((cofreeLift X) ((2 : ℕ) • (LinearMap.id : C →ₗ[ℕ] C))
          (MonoidAlgebra.single i 1)) = (2 : ℕ) • (MonoidAlgebra.single i 1 : C) := by
  constructor
  · simp [TensorProduct.smul_tmul']
  · exact LinearMap.congr_fun (cofreeProjection_comp_cofreeLift X
      ((2 : ℕ) • (LinearMap.id : C →ₗ[ℕ] C))) (MonoidAlgebra.single i 1)

/-- The off-diagonal tensor is nonzero: right counit contraction is the
existing nonzero zeroth basis point. -/
theorem off_diagonal_ne_zero : (e₀ ⊗ₜ[ℕ] e₁ : C ⊗[ℕ] C) ≠ 0 := by
  intro h
  have hc := congrArg (cofreeProjection ℕ C C) h
  simp at hc

/-- The off-diagonal tensor is outside the coaction embedding's range. The
right and left counit contractions would identify the two distinct points. -/
theorem off_diagonal_not_mem_range :
    (e₀ ⊗ₜ[ℕ] e₁ : C ⊗[ℕ] C) ∉ LinearMap.range (coactionHom X).toLinearMap := by
  rintro ⟨x, hx⟩
  have hx0 : x = e₀ := by
    calc
      x = cofreeProjection ℕ C C ((coactionHom X) x) :=
        (LinearMap.congr_fun (cofreeProjection_comp_coactionHom X) x).symm
      _ = cofreeProjection ℕ C C (e₀ ⊗ₜ[ℕ] e₁) := congrArg _ hx
      _ = e₀ := by simp
  have hl := congrArg (fun t : C ⊗[ℕ] C ↦ TensorProduct.lid ℕ C
    ((Coalgebra.counit (R := ℕ) (A := C)).rTensor C t)) hx
  have hx1 : x = e₁ := by
    simpa using hl
  exact RightComoduleExamples.natural_counit_noninjective.2.2.1 (hx0.symm.trans hx1)

/-- In the existing infinite semiring model the coaction is a nonzero injective
map with proper range, not a surjection onto the cofree comodule. -/
theorem diagonal_embedding_proper :
    Function.Injective (coactionHom X) ∧ (coactionHom X).toLinearMap ≠ 0 ∧
      ¬ Function.Surjective (coactionHom X) := by
  refine ⟨coactionHom_injective X, ?_, ?_⟩
  · intro h
    have hz : (coactionHom X) e₀ = (coactionHom X) 0 := by
      have he := LinearMap.congr_fun h e₀
      simpa only [Coalgebra.RightComoduleHom.toLinearMap_apply, LinearMap.zero_apply,
        map_zero] using he
    exact RightComoduleExamples.natural_counit_noninjective.1
      (coactionHom_injective X hz)
  · intro h
    obtain ⟨x, hx⟩ := h (e₀ ⊗ₜ[ℕ] e₁)
    exact off_diagonal_not_mem_range ⟨x, hx⟩

end CofreeComoduleExamples
