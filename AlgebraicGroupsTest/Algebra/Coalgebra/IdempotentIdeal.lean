module

public import AlgebraicGroups.Algebra.Coalgebra.IdempotentIdeal
public import Mathlib.Data.Finsupp.Fintype
public import Mathlib.Data.ZMod.Basic
public import Mathlib.LinearAlgebra.FreeModule.Basic
public import Mathlib.RingTheory.Coalgebra.GroupLike
public import Mathlib.RingTheory.Finiteness.Cardinality

/-!
# Clients of the idempotent principal ideal coalgebra

The constructor gives coalgebras for zero and one over every commutative semiring.
Over `ZMod 6`, the ideal generated by three is nonzero and nonfree; its generator
has diagonal comultiplication and counit three, not one. The existing Finsupp
coalgebra on countably many copies is not finitely generated as a module.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

open scoped TensorProduct
open Coalgebra

universe u

section Generic

variable {K : Type u} [CommSemiring K] {e : K}

-- Install the constructor and use the existing coalgebra laws without unfolding it.
/-- The coalgebra on the principal ideal generated by an idempotent element is coassociative. -/
theorem coalgebraSpan_coassoc_apply (he : IsIdempotentElem e) (d : Ideal.span ({e} : Set K)) :
    TensorProduct.assoc K _ _ _
        (he.coalgebraSpan.comul.rTensor _ (he.coalgebraSpan.comul d)) =
      he.coalgebraSpan.comul.lTensor _ (he.coalgebraSpan.comul d) := by
  let := he.coalgebraSpan
  exact Coalgebra.coassoc_apply d

example (he : IsIdempotentElem e) (d : Ideal.span ({e} : Set K)) :
    (Ideal.span ({e} : Set K)).subtype.rTensor _
        (d ⊗ₜ[K] Ideal.spanSingletonGenerator e) = (1 : K) ⊗ₜ[K] d := by
  let := he.coalgebraSpan
  simpa only [he.coalgebraSpan_comul_apply, he.coalgebraSpan_counit] using
    (Coalgebra.rTensor_counit_comul (R := K) d)

example (he : IsIdempotentElem e) (d : Ideal.span ({e} : Set K)) :
    (Ideal.span ({e} : Set K)).subtype.lTensor _
        (d ⊗ₜ[K] Ideal.spanSingletonGenerator e) = d ⊗ₜ[K] (1 : K) := by
  let := he.coalgebraSpan
  simpa only [he.coalgebraSpan_comul_apply, he.coalgebraSpan_counit] using
    (Coalgebra.lTensor_counit_comul (R := K) d)

example (he : IsIdempotentElem e) (d : Ideal.span ({e} : Set K)) : e • d = d :=
  he.smul_span_singleton d

example (he : IsIdempotentElem e) (d : Ideal.span ({e} : Set K)) :
    (d : K) • Ideal.spanSingletonGenerator e = d :=
  he.smul_spanSingletonGenerator d

end Generic

section Zero

variable {K : Type u} [CommSemiring K]

private noncomputable local instance : Coalgebra K (Ideal.span ({0} : Set K)) :=
  IsIdempotentElem.zero.coalgebraSpan

example : counit (R := K) (Ideal.spanSingletonGenerator (0 : K)) = 0 := by simp

example (d : Ideal.span ({0} : Set K)) : comul (R := K) d = 0 := by
  have hd : d = 0 := Subtype.ext (by simpa using d.property)
  rw [hd, map_zero]

end Zero

section One

variable {K : Type u} [CommSemiring K]

private noncomputable local instance : Coalgebra K (Ideal.span ({1} : Set K)) :=
  IsIdempotentElem.one.coalgebraSpan

example : counit (R := K) (Ideal.spanSingletonGenerator (1 : K)) = 1 := by simp

example (d : Ideal.span ({1} : Set K)) :
    comul (R := K) d = d ⊗ₜ[K] Ideal.spanSingletonGenerator 1 := by simp

example (d : Ideal.span ({1} : Set K)) : counit (R := K) d = (d : K) := by simp

end One

namespace IdempotentIdealExamples

private abbrev K := ZMod 6
private abbrev D := Ideal.span ({(3 : K)} : Set K)
private abbrev generator : D := Ideal.spanSingletonGenerator (3 : K)

private theorem three_idempotent : IsIdempotentElem (3 : K) := by
  change (3 : K) * 3 = 3
  decide

private theorem three_ne_zero : (3 : K) ≠ 0 := by decide
private theorem three_ne_one : (3 : K) ≠ 1 := by decide
private theorem four_ne_zero : (4 : K) ≠ 0 := by decide
private theorem four_mul_three : (4 : K) * 3 = 0 := by decide

private noncomputable local instance : Coalgebra K D := three_idempotent.coalgebraSpan

example : counit (R := K) generator = 3 := by simp [generator]

example : comul (R := K) generator = generator ⊗ₜ[K] generator := by simp [generator]

private theorem generator_ne_zero : generator ≠ 0 := by
  intro h
  have hc := congrArg (fun d : D ↦ (d : K)) h
  exact three_ne_zero hc

private local instance : Nontrivial D := ⟨⟨generator, 0, generator_ne_zero⟩⟩

private theorem four_smul_ideal (d : D) : (4 : K) • d = 0 := by
  apply Subtype.ext
  change (4 : K) * (d : K) = 0
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp d.property
  rw [← hr, mul_left_comm (4 : K) r 3, four_mul_three, mul_zero]

/-- The nonzero coalgebra on the ideal generated by three is not free over `ZMod 6`. -/
private theorem not_free_ideal : ¬ Module.Free K D := by
  intro h
  let := h
  have hz : (4 : K) = 0 := eq_of_smul_eq_smul (α := D) fun d ↦ by
    rw [four_smul_ideal, zero_smul]
  exact four_ne_zero hz

example : ¬ IsGroupLikeElem K generator := by
  intro h
  have hc := h.counit_eq_one
  have hthree : counit (R := K) generator = 3 := by simp [generator]
  exact three_ne_one (hthree.symm.trans hc)

private abbrev C := ℕ →₀ D

-- These clients use Mathlib's Finsupp coalgebra instance on the installed ideal coalgebra.
example (n : ℕ) (d : D) :
    comul (R := K) (Finsupp.single n d : C) =
      Finsupp.single n d ⊗ₜ[K] Finsupp.single n generator := by
  simp [Finsupp.comul_single, generator]

example (n : ℕ) : counit (R := K) (Finsupp.single n generator : C) = 3 := by
  simp [generator]

private theorem four_smul_finsupp (x : C) : (4 : K) • x = 0 := by
  ext n
  simp [four_smul_ideal]

/-- Countably many copies of the ideal coalgebra still form a nonfree module. -/
private theorem not_free_finsupp : ¬ Module.Free K C := by
  intro h
  let := h
  have hz : (4 : K) = 0 := eq_of_smul_eq_smul (α := C) fun x ↦ by
    rw [four_smul_finsupp, zero_smul]
  exact four_ne_zero hz

/-- This countable Finsupp coalgebra is not finitely generated as a module. -/
private theorem not_finite_finsupp : ¬ Module.Finite K C := by
  intro h
  let := h
  let : Finite C := Module.finite_of_finite K
  exact (Finite.not_infinite (inferInstance : Finite C)) (inferInstance : Infinite C)

example : ¬ (⊤ : Submodule K C).FG := by
  intro h
  exact not_finite_finsupp (Module.Finite.of_fg_top h)

end IdempotentIdealExamples
