module

public import AlgebraicGroups.Algebra.Coalgebra.Hom
public import AlgebraicGroupsTest.Algebra.Coalgebra.CounitRange
public import AlgebraicGroupsTest.Algebra.Coalgebra.FiniteSubcoalgebra
public import AlgebraicGroupsTest.Algebra.Coalgebra.GroupLikeHom

/-!
# Counit-determined coalgebra morphisms

The existing coalgebras on the ideals generated by three and four in `ZMod 6`
have proper injective counits. Their canonical identity morphisms are nonzero,
and injectivity of the target counit makes each endomorphism space a singleton.
In contrast, neither ideal receives a morphism from the scalar coalgebra.
The orthogonal public scalar-support calculation also rules out a morphism from
the ideal generated by three to the ideal generated by four.

The structure-only API applies to an actual identity morphism over `ℕ` without
assuming coalgebra laws. A full-source compatibility client identifies a
scalar-target morphism with Mathlib's canonical counit morphism. Finally, the
existing lifted two-coordinate coalgebra over `ℕ` supplies distinct actual
morphisms with equal counit composites, showing that target-counit injectivity
cannot be omitted.

## References

The proper nonzero ideal coalgebras and their orthogonal scalar supports are
reused directly from `AlgebraicGroupsTest.Algebra.Coalgebra.CounitRange`.
The idempotent-ideal constructor and its counit readback are supplied by
`AlgebraicGroups.Algebra.Coalgebra.IdempotentIdeal`. The named public witness for
three is supplied by `AlgebraicGroupsTest.Algebra.Coalgebra.FiniteSubcoalgebra`.
The distinct coordinate morphisms are reused directly from
`AlgebraicGroupsTest.Algebra.Coalgebra.GroupLikeHom`. Mathlib supplies the
canonical identity and scalar-target counit morphisms.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u v

open Coalgebra
open scoped TensorProduct

namespace CoalgebraTest

section ProperIdeals

local notation "I₃" => Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))
local notation "I₄" => Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6))

attribute [local instance] spanThreeCoalgebra spanFourCoalgebra

-- Existence is supplied by the identity, not inferred from the at-most-one API.
example :
    Function.Injective (counit (R := ZMod 6) (A := I₃)) ∧
    (LinearMap.range (counit (R := ZMod 6) (A := I₃)) : Ideal (ZMod 6)) ≠ ⊥ ∧
    (LinearMap.range (counit (R := ZMod 6) (A := I₃)) : Ideal (ZMod 6)) ≠ ⊤ ∧
    ∃ f : I₃ →ₗc[ZMod 6] I₃,
      f = CoalgHom.id (ZMod 6) I₃ ∧ f.toLinearMap ≠ 0 ∧
      (∀ g : I₃ →ₗc[ZMod 6] I₃, g = f) ∧ Subsingleton (I₃ →ₗc[ZMod 6] I₃) := by
  have hε : Function.Injective (counit (R := ZMod 6) (A := I₃)) := by
    rw [CoalgebraExamples.zmod_six_three_idempotent.coalgebraSpan_counit]
    exact Subtype.val_injective
  have hs : Subsingleton (I₃ →ₗc[ZMod 6] I₃) :=
    CoalgHomClass.subsingleton_of_injective_counit (F := I₃ →ₗc[ZMod 6] I₃) hε
  refine ⟨hε, orthogonal_ideal_factors_nontrivial_support.2.2.1,
    orthogonal_ideal_factors_nontrivial_support.2.2.2.1,
    CoalgHom.id (ZMod 6) I₃, rfl, ?_, ?_, hs⟩
  · intro hzero
    have hsource := (CoalgHom.toLinearMap_eq_zero_iff (CoalgHom.id (ZMod 6) I₃)).mp hzero
    obtain ⟨x, y, hxy⟩ := orthogonal_ideal_factors_nontrivial_support.1.exists_pair_ne
    exact hxy (@Subsingleton.elim I₃ hsource x y)
  · intro g
    exact @Subsingleton.elim (I₃ →ₗc[ZMod 6] I₃) hs g (CoalgHom.id (ZMod 6) I₃)

example :
    Function.Injective (counit (R := ZMod 6) (A := I₄)) ∧
    (LinearMap.range (counit (R := ZMod 6) (A := I₄)) : Ideal (ZMod 6)) ≠ ⊥ ∧
    (LinearMap.range (counit (R := ZMod 6) (A := I₄)) : Ideal (ZMod 6)) ≠ ⊤ ∧
    ∃ f : I₄ →ₗc[ZMod 6] I₄,
      f = CoalgHom.id (ZMod 6) I₄ ∧ f.toLinearMap ≠ 0 ∧
      (∀ g : I₄ →ₗc[ZMod 6] I₄, g = f) ∧ Subsingleton (I₄ →ₗc[ZMod 6] I₄) := by
  have hε : Function.Injective (counit (R := ZMod 6) (A := I₄)) := by
    rw [IsIdempotentElem.coalgebraSpan_counit]
    exact Subtype.val_injective
  have hs : Subsingleton (I₄ →ₗc[ZMod 6] I₄) :=
    CoalgHomClass.subsingleton_of_injective_counit (F := I₄ →ₗc[ZMod 6] I₄) hε
  refine ⟨hε, orthogonal_ideal_factors_nontrivial_support.2.2.2.2.1,
    orthogonal_ideal_factors_nontrivial_support.2.2.2.2.2,
    CoalgHom.id (ZMod 6) I₄, rfl, ?_, ?_, hs⟩
  · intro hzero
    have hsource := (CoalgHom.toLinearMap_eq_zero_iff (CoalgHom.id (ZMod 6) I₄)).mp hzero
    obtain ⟨x, y, hxy⟩ := orthogonal_ideal_factors_nontrivial_support.2.1.exists_pair_ne
    exact hxy (@Subsingleton.elim I₄ hsource x y)
  · intro g
    exact @Subsingleton.elim (I₄ →ₗc[ZMod 6] I₄) hs g (CoalgHom.id (ZMod 6) I₄)

-- These spaces are empty, although injective target counits still give at most one map.
example : ¬ Nonempty (ZMod 6 →ₗc[ZMod 6] I₃) := by
  rintro ⟨f⟩
  have hsurj : Function.Surjective (counit (R := ZMod 6) (A := I₃)) := by
    intro r
    refine ⟨f r, ?_⟩
    simpa only [CommSemiring.counit_apply] using CoalgHomClass.counit_comp_apply f r
  exact orthogonal_ideal_factors_nontrivial_support.2.2.2.1
    (LinearMap.range_eq_top.mpr hsurj)

example : ¬ Nonempty (ZMod 6 →ₗc[ZMod 6] I₄) := by
  rintro ⟨f⟩
  have hsurj : Function.Surjective (counit (R := ZMod 6) (A := I₄)) := by
    intro r
    refine ⟨f r, ?_⟩
    simpa only [CommSemiring.counit_apply] using CoalgHomClass.counit_comp_apply f r
  exact orthogonal_ideal_factors_nontrivial_support.2.2.2.2.2
    (LinearMap.range_eq_top.mpr hsurj)

-- Reuse the whole public orthogonal-support calculation, without private arithmetic helpers.
example : ¬ Nonempty (I₃ →ₗc[ZMod 6] I₄) := by
  rintro ⟨f⟩
  have hrange :
      (LinearMap.range (counit (R := ZMod 6) (A := I₃)) : Ideal (ZMod 6)) ≤
        LinearMap.range (counit (R := ZMod 6) (A := I₄)) := by
    rw [← f.counit_comp]
    exact LinearMap.range_comp_le_range f.toLinearMap (counit (R := ZMod 6) (A := I₄))
  have hprod :
      (LinearMap.range (counit (R := ZMod 6) (A := I₃)) : Ideal (ZMod 6)) *
        LinearMap.range (counit (R := ZMod 6) (A := I₄)) = ⊥ :=
    (counit_range_tensorProduct (ZMod 6) I₃ I₄).symm.trans
      orthogonal_ideal_tensor_subsingleton.1
  have hbot :
      (LinearMap.range (counit (R := ZMod 6) (A := I₃)) : Ideal (ZMod 6)) ≤ ⊥ := by
    calc
      (LinearMap.range (counit (R := ZMod 6) (A := I₃)) : Ideal (ZMod 6)) =
          (LinearMap.range (counit (R := ZMod 6) (A := I₃)) : Ideal (ZMod 6)) *
            LinearMap.range (counit (R := ZMod 6) (A := I₃)) :=
        (counit_range_mul_self (ZMod 6) I₃).symm
      _ ≤ (LinearMap.range (counit (R := ZMod 6) (A := I₃)) : Ideal (ZMod 6)) *
          LinearMap.range (counit (R := ZMod 6) (A := I₄)) := Ideal.mul_mono_right hrange
      _ = ⊥ := hprod
  exact orthogonal_ideal_factors_nontrivial_support.2.2.1 (le_bot_iff.mp hbot)

end ProperIdeals

section StructureOnly

-- An actual identity makes this generic nonring, structure-only caller nonvacuous.
example (C : Type v) [AddCommMonoid C] [Module ℕ C] [CoalgebraStruct ℕ C]
    (hε : Function.Injective (counit (R := ℕ) (A := C))) :
    ∃ f : C →ₗc[ℕ] C, f = CoalgHom.id ℕ C ∧ ∀ g : C →ₗc[ℕ] C, g = f := by
  refine ⟨CoalgHom.id ℕ C, rfl, ?_⟩
  intro g
  exact CoalgHomClass.ext_of_injective_counit hε g (CoalgHom.id ℕ C)

end StructureOnly

/-- A morphism to the scalar coalgebra equals the canonical counit morphism. -/
theorem to_scalar_eq_counitCoalgHom {R : Type u} {A : Type v}
    [CommSemiring R] [AddCommMonoid A] [Module R A] [Coalgebra R A]
    (f : A →ₗc[R] R) : f = Coalgebra.counitCoalgHom R A := by
  have hε : Function.Injective (counit (R := R) (A := R)) := by
    intro r s hrs
    simpa only [CommSemiring.counit_apply] using hrs
  exact CoalgHomClass.ext_of_injective_counit hε f (Coalgebra.counitCoalgHom R A)

section Sharpness

-- Public lifted coordinate morphisms give both existence and inequality.
example :
    ∃ f g : ℕ →ₗc[ℕ] (ULift.{v} (Fin 2) →₀ ℕ),
      f ≠ g ∧
      (counit (R := ℕ) (A := ULift.{v} (Fin 2) →₀ ℕ)).comp f.toLinearMap =
        (counit (R := ℕ) (A := ULift.{v} (Fin 2) →₀ ℕ)).comp g.toLinearMap ∧
      ¬ Function.Injective (counit (R := ℕ) (A := ULift.{v} (Fin 2) →₀ ℕ)) := by
  obtain ⟨g₀, g₁, h⟩ := Finsupp.exists_distinct_coalgHomEquiv_nat_ulift_fin_two.{v}
  let f₀ := GroupLike.coalgHomEquiv g₀
  let f₁ := GroupLike.coalgHomEquiv g₁
  have hne : f₀ ≠ f₁ := h.2.2.1
  refine ⟨f₀, f₁, hne, f₀.counit_comp.trans f₁.counit_comp.symm, ?_⟩
  intro hε
  exact hne (CoalgHomClass.ext_of_injective_counit hε f₀ f₁)

end Sharpness

end CoalgebraTest
