/-!
# Counit ranges of idempotent principal ideal coalgebras

The coalgebras on the ideals generated by zero and one have counit ranges
zero and the whole scalar semiring. Over `ZMod 6`, the coalgebra on the ideal
generated by three has a proper nonzero counit range. The generic counit
range theorem identifies the squares of all three ranges. The counit range
acts on the whole coalgebra with image the whole coalgebra, for the scalar
coalgebra, the zero ideal coalgebra, and the proper ideal coalgebra over `ZMod 6`.

A coalgebra on `ℕ →₀ ℕ` illustrates counit surjectivity for an infinite free module
over a semiring. For vector spaces the conclusion agrees with Mathlib's criterion
that a linear functional is surjective exactly when it is nonzero. The free zero
module over `ℕ` shows why nontriviality is required, and the proper nonzero ideal
coalgebra over `ZMod 6` shows why freeness cannot be omitted.

The faithful-action criterion applies to the scalar coalgebra over a ring and
the empty diagonal coalgebra over the trivial ring. The infinite free coalgebra
`ℕ →₀ ℚ` has a finitely generated counit image but is not a finite module. The
ideal generated by three in `ZMod 6` has finitely generated proper counit image
and an idempotent acting identically, but its scalar action is not faithful.

Faithfully flat carriers give surjective counits for the scalar coalgebra,
including the trivial ring, and the infinite diagonal coalgebra `ℕ →₀ ℚ`.
The ideal generated by three in `ZMod 6` is not faithfully flat: its counit
has proper nonzero image. Zero structure maps on the faithfully flat scalar
carrier `ZMod 6` have nonsurjective counit and fail the left counit law.

Tensor products multiply the scalar supports. The ideals generated by three and
four over `ZMod 6` are nontrivial coalgebras with proper nonzero supports, but
their tensor product is subsingleton because those supports are orthogonal.
Tensoring the ideal generated by three with itself retains its proper nonzero
support. Scalar, zero and infinite diagonal coalgebras also illustrate the formula
and its counit-surjectivity criterion, including a trivial scalar semiring.

The natural-number ideals generated by two and three carry chosen structure maps:
zero comultiplication and the scalar inclusion as counit. Their tensor counit has
image the ideal generated by six and is not surjective. A nonzero generator tensor
and an explicit failure of the left counit identity show that the range and
surjectivity statements need no coalgebra laws, even over a semiring without
additive inverses.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u v w

open Coalgebra
open scoped TensorProduct

section Scalar

variable {R : Type u} [CommSemiring R]

example :
    (LinearMap.range (counit (R := R) (A := R)) : Ideal R) = ⊤ ∧
    (LinearMap.range (counit (R := R) (A := R)) : Ideal R) •
      (⊤ : Submodule R R) = ⊤ := by
  refine ⟨?_, counit_range_smul_top R R⟩
  apply top_unique
  intro r _
  exact ⟨r, CommSemiring.counit_apply R r⟩

end Scalar

section Free

/-- The counit on the infinite free coalgebra `ℕ →₀ ℕ` has full range and takes
value seven on some element. -/
theorem CoalgebraTest.natural_finsupp_counit_range :
    (LinearMap.range (counit (R := ℕ) (A := ℕ →₀ ℕ)) : Ideal ℕ) = ⊤ ∧
    ∃ c : ℕ →₀ ℕ, counit (R := ℕ) c = 7 := by
  refine ⟨by simp, ?_⟩
  exact counit_surjective_of_free ℕ (ℕ →₀ ℕ) 7

variable (K : Type u) (C : Type v)
variable [Field K] [AddCommGroup C] [Module K C] [Coalgebra K C] [Nontrivial C]

example : Function.Surjective (counit (R := K) (A := C)) ∧
    counit (R := K) (A := C) ≠ 0 := by
  have h := counit_surjective_of_free K C
  exact ⟨h, LinearMap.surjective_iff_ne_zero.mp h⟩

example :
    Module.Free ℕ (Fin 0 →₀ ℕ) ∧
    (LinearMap.range (counit (R := ℕ) (A := Fin 0 →₀ ℕ)) : Ideal ℕ) = ⊥ ∧
    (LinearMap.range (counit (R := ℕ) (A := Fin 0 →₀ ℕ)) : Ideal ℕ) ≠ ⊤ := by
  have hrange :
      (LinearMap.range (counit (R := ℕ) (A := Fin 0 →₀ ℕ)) : Ideal ℕ) = ⊥ := by
    apply LinearMap.range_eq_bot.mpr
    apply LinearMap.ext
    intro x
    have hx : x = 0 := Subsingleton.elim _ _
    simp [hx]
  exact ⟨inferInstance, hrange, by rw [hrange]; exact bot_ne_top⟩

end Free

section Faithful

variable (R : Type u) [CommRing R]

example : Function.Surjective (counit (R := R) (A := R)) :=
  counit_surjective_of_faithfulSMul_of_fg R R (Submodule.fg_range _)

example : Function.Surjective (counit (R := ZMod 6) (A := ZMod 6)) :=
  counit_surjective_of_faithfulSMul_of_fg (ZMod 6) (ZMod 6) (Submodule.fg_range _)

example :
    (LinearMap.range (counit (R := PUnit) (A := Fin 0 →₀ PUnit)) : Ideal PUnit) = ⊥ ∧
    Function.Surjective (counit (R := PUnit) (A := Fin 0 →₀ PUnit)) := by
  have hrange :
      (LinearMap.range (counit (R := PUnit) (A := Fin 0 →₀ PUnit)) : Ideal PUnit) = ⊥ :=
    LinearMap.range_eq_bot.mpr
      ((counit_eq_zero_iff PUnit (Fin 0 →₀ PUnit)).mpr inferInstance)
  refine ⟨hrange, counit_surjective_of_faithfulSMul_of_fg PUnit (Fin 0 →₀ PUnit) ?_⟩
  exact (fun I : Ideal PUnit => show I.FG from
    (Submodule.eq_bot_of_subsingleton (p := I)).symm ▸ Submodule.fg_bot) _

/-- The faithful-action criterion needs finite generation only of the image ideal:
the infinite diagonal coalgebra over the rationals has unit counit image and
an element with counit seven, but its underlying module is not finite. -/
theorem CoalgebraTest.rational_finsupp_faithful_fg_counit :
    (LinearMap.range (counit (R := ℚ) (A := ℕ →₀ ℚ)) : Ideal ℚ).FG ∧
    ¬ Module.Finite ℚ (ℕ →₀ ℚ) ∧
    (LinearMap.range (counit (R := ℚ) (A := ℕ →₀ ℚ)) : Ideal ℚ) = ⊤ ∧
    ∃ c : ℕ →₀ ℚ, counit (R := ℚ) c = 7 := by
  have hfg : (LinearMap.range (counit (R := ℚ) (A := ℕ →₀ ℚ)) : Ideal ℚ).FG := by
    rw [counit_range_eq_top_of_free]
    exact Ideal.fg_top ℚ
  refine ⟨hfg, Module.not_finite_of_infinite_basis
    (Finsupp.basisSingleOne : Module.Basis ℕ ℚ (ℕ →₀ ℚ)),
    counit_range_eq_top_of_faithfulSMul_of_fg ℚ (ℕ →₀ ℚ) hfg, ?_⟩
  exact counit_surjective_of_faithfulSMul_of_fg ℚ (ℕ →₀ ℚ) hfg 7

end Faithful

section FaithfullyFlat

variable (R : Type u) [CommRing R]

example :
    (LinearMap.range (counit (R := R) (A := R)) : Ideal R) = ⊤ ∧
    Function.Surjective (counit (R := R) (A := R)) := by
  let : Module.FaithfullyFlat R R := Module.FaithfullyFlat.self R
  exact ⟨counit_range_eq_top_of_faithfullyFlat R R,
    counit_surjective_of_faithfullyFlat R R⟩

example :
    (0 : PUnit.{1}) = 1 ∧
    (LinearMap.range (counit (R := PUnit.{1}) (A := PUnit.{1})) : Ideal PUnit.{1}) = ⊤ ∧
    Function.Surjective (counit (R := PUnit.{1}) (A := PUnit.{1})) := by
  let : Module.FaithfullyFlat PUnit.{1} PUnit.{1} := Module.FaithfullyFlat.self PUnit.{1}
  exact ⟨Subsingleton.elim _ _, counit_range_eq_top_of_faithfullyFlat PUnit.{1} PUnit.{1},
    counit_surjective_of_faithfullyFlat PUnit.{1} PUnit.{1}⟩

/-- The rational diagonal coalgebra is faithfully flat but not module-finite;
its counit has full range and is surjective. -/
theorem CoalgebraTest.rational_finsupp_faithfullyFlat_counit :
    ¬ Module.Finite ℚ (ℕ →₀ ℚ) ∧
    (LinearMap.range (counit (R := ℚ) (A := ℕ →₀ ℚ)) : Ideal ℚ) = ⊤ ∧
    Function.Surjective (counit (R := ℚ) (A := ℕ →₀ ℚ)) ∧
    ∃ c : ℕ →₀ ℚ, counit (R := ℚ) c = 7 := by
  let : Module.FaithfullyFlat ℚ (ℕ →₀ ℚ) := Module.FaithfullyFlat.finsupp ℚ ℕ
  refine ⟨CoalgebraTest.rational_finsupp_faithful_fg_counit.2.1,
    counit_range_eq_top_of_faithfullyFlat ℚ (ℕ →₀ ℚ),
    counit_surjective_of_faithfullyFlat ℚ (ℕ →₀ ℚ), ?_⟩
  exact counit_surjective_of_faithfullyFlat ℚ (ℕ →₀ ℚ) 7

/-- The rational diagonal coalgebra has faithfully flat and flat underlying module,
surjective counit and full counit range, but it is not module-finite. -/
theorem CoalgebraTest.rational_finsupp_flat_faithfullyFlat_counit :
    Module.FaithfullyFlat ℚ (ℕ →₀ ℚ) ∧
    Module.Flat ℚ (ℕ →₀ ℚ) ∧
    Function.Surjective (counit (R := ℚ) (A := ℕ →₀ ℚ)) ∧
    (LinearMap.range (counit (R := ℚ) (A := ℕ →₀ ℚ)) : Ideal ℚ) = ⊤ ∧
    ¬ Module.Finite ℚ (ℕ →₀ ℚ) ∧
    ∃ c : ℕ →₀ ℚ, counit (R := ℚ) c = 7 := by
  let : Module.Flat ℚ (ℕ →₀ ℚ) := Module.Flat.finsupp ℕ
  have h := CoalgebraTest.rational_finsupp_faithfullyFlat_counit
  have hFF : Module.FaithfullyFlat ℚ (ℕ →₀ ℚ) :=
    (faithfullyFlat_iff_flat_and_counit_surjective ℚ (ℕ →₀ ℚ)).mpr
      ⟨inferInstance, h.2.2.1⟩
  exact ⟨hFF, inferInstance, h.2.2.1, h.2.1, h.1, h.2.2.2⟩

/-- The empty rational diagonal coalgebra has flat underlying module and zero
counit, so its counit is not surjective and its module is not faithfully flat. -/
theorem CoalgebraTest.empty_rational_finsupp_flat_counit :
    Module.Flat ℚ (Fin 0 →₀ ℚ) ∧
    counit (R := ℚ) (A := Fin 0 →₀ ℚ) = 0 ∧
    ¬ Function.Surjective (counit (R := ℚ) (A := Fin 0 →₀ ℚ)) ∧
    ¬ Module.FaithfullyFlat ℚ (Fin 0 →₀ ℚ) := by
  have hzero : counit (R := ℚ) (A := Fin 0 →₀ ℚ) = 0 :=
    (counit_eq_zero_iff ℚ (Fin 0 →₀ ℚ)).mpr inferInstance
  have hnonsurj : ¬ Function.Surjective (counit (R := ℚ) (A := Fin 0 →₀ ℚ)) := by
    intro h
    obtain ⟨c, hc⟩ := h 1
    exact zero_ne_one (by simpa only [hzero, LinearMap.zero_apply] using hc)
  refine ⟨Module.Flat.finsupp (Fin 0), hzero, hnonsurj, ?_⟩
  intro hFF
  let := hFF
  exact hnonsurj (counit_surjective_of_faithfullyFlat ℚ (Fin 0 →₀ ℚ))

/-- Zero structure maps on the faithfully flat scalar module over `ZMod 6` have
nonsurjective counit and fail the left counit identity. -/
theorem CoalgebraTest.exists_faithfullyFlat_zero_counit_left_law_failure :
    ∃ s : CoalgebraStruct (ZMod 6) (ZMod 6),
      Module.FaithfullyFlat (ZMod 6) (ZMod 6) ∧
      ¬ Function.Surjective s.counit ∧
      s.counit.rTensor (ZMod 6) ∘ₗ s.comul ≠
        _root_.TensorProduct.mk (ZMod 6) (ZMod 6) (ZMod 6) 1 := by
  let s : CoalgebraStruct (ZMod 6) (ZMod 6) := { comul := 0, counit := 0 }
  refine ⟨s, Module.FaithfullyFlat.self (ZMod 6), ?_, ?_⟩
  · intro h
    obtain ⟨r, hr⟩ := h 1
    change (0 : ZMod 6) = 1 at hr
    exact (by decide : (0 : ZMod 6) ≠ 1) hr
  · intro h
    have hcounit : s.counit = 0 := rfl
    have hcomul : s.comul = 0 := rfl
    have h' := congrArg
      (fun f : ZMod 6 →ₗ[ZMod 6] (ZMod 6 ⊗[ZMod 6] ZMod 6) =>
        _root_.TensorProduct.lid (ZMod 6) (ZMod 6) (f 1)) h
    exact (by decide : (0 : ZMod 6) ≠ 1) (by
      simpa only [LinearMap.comp_apply, hcounit, hcomul, LinearMap.rTensor_zero,
        LinearMap.zero_apply, map_zero, _root_.TensorProduct.mk_apply,
        _root_.TensorProduct.lid_tmul, one_smul] using h')

end FaithfullyFlat

section Zero

variable {R : Type u} [CommSemiring R]

example :
    (LinearMap.range (IsIdempotentElem.zero : IsIdempotentElem (0 : R)).coalgebraSpan.counit :
      Ideal R) = ⊥ ∧
    (LinearMap.range (IsIdempotentElem.zero : IsIdempotentElem (0 : R)).coalgebraSpan.counit :
      Ideal R) *
      LinearMap.range (IsIdempotentElem.zero : IsIdempotentElem (0 : R)).coalgebraSpan.counit =
      ⊥ := by
  let he : IsIdempotentElem (0 : R) := IsIdempotentElem.zero
  let := he.coalgebraSpan
  have hrange : (LinearMap.range he.coalgebraSpan.counit : Ideal R) = ⊥ := by
    rw [he.coalgebraSpan_counit, Submodule.range_subtype]
    simp
  exact ⟨hrange, (counit_range_mul_self R (Ideal.span ({0} : Set R))).trans hrange⟩

example :
    (LinearMap.range (IsIdempotentElem.zero : IsIdempotentElem (0 : R)).coalgebraSpan.counit :
      Ideal R) • (⊤ : Submodule R (Ideal.span ({0} : Set R))) = ⊤ ∧
    (LinearMap.range (IsIdempotentElem.zero : IsIdempotentElem (0 : R)).coalgebraSpan.counit :
      Ideal R) = ⊥ := by
  let he : IsIdempotentElem (0 : R) := IsIdempotentElem.zero
  let := he.coalgebraSpan
  refine ⟨counit_range_smul_top R (Ideal.span ({0} : Set R)), ?_⟩
  rw [he.coalgebraSpan_counit, Submodule.range_subtype]
  simp

end Zero

section One

variable {R : Type u} [CommSemiring R]

example :
    (LinearMap.range (IsIdempotentElem.one : IsIdempotentElem (1 : R)).coalgebraSpan.counit :
      Ideal R) = ⊤ ∧
    (LinearMap.range (IsIdempotentElem.one : IsIdempotentElem (1 : R)).coalgebraSpan.counit :
      Ideal R) *
      LinearMap.range (IsIdempotentElem.one : IsIdempotentElem (1 : R)).coalgebraSpan.counit =
      ⊤ := by
  let he : IsIdempotentElem (1 : R) := IsIdempotentElem.one
  let := he.coalgebraSpan
  have hrange : (LinearMap.range he.coalgebraSpan.counit : Ideal R) = ⊤ := by
    rw [he.coalgebraSpan_counit, Submodule.range_subtype]
    simp
  exact ⟨hrange, (counit_range_mul_self R (Ideal.span ({1} : Set R))).trans hrange⟩

end One

section ZMod

private theorem three_idempotent : IsIdempotentElem (3 : ZMod 6) := by
  change (3 : ZMod 6) * 3 = 3
  decide

example :
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) =
      Ideal.span ({3} : Set (ZMod 6)) ∧
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) *
      LinearMap.range three_idempotent.coalgebraSpan.counit =
      Ideal.span ({3} : Set (ZMod 6)) := by
  let := three_idempotent.coalgebraSpan
  have hrange : (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) =
      Ideal.span ({3} : Set (ZMod 6)) := by
    rw [three_idempotent.coalgebraSpan_counit, Submodule.range_subtype]
  exact ⟨hrange,
    (counit_range_mul_self (ZMod 6) (Ideal.span ({3} : Set (ZMod 6)))).trans hrange⟩

example :
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) ≠ ⊥ ∧
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) ≠ ⊤ := by
  rw [three_idempotent.coalgebraSpan_counit, Submodule.range_subtype]
  constructor
  · rw [ne_eq, Ideal.span_singleton_eq_bot]
    decide
  · rw [ne_eq, Ideal.span_singleton_eq_top]
    exact (ZMod.isUnit_iff_coprime 3 6).not.mpr (by decide)

example : (3 : ZMod 6) * 3 = 3 ∧
    (3 : ZMod 6) ∈
      (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) *
        LinearMap.range three_idempotent.coalgebraSpan.counit := by
  have hthree : (3 : ZMod 6) ∈ LinearMap.range three_idempotent.coalgebraSpan.counit :=
    ⟨Ideal.spanSingletonGenerator 3, three_idempotent.coalgebraSpan_counit_apply _⟩
  have hmul : (3 : ZMod 6) * 3 = 3 := by decide
  refine ⟨hmul, ?_⟩
  simpa only [hmul] using Ideal.mul_mem_mul hthree hthree

example :
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) •
      (⊤ : Submodule (ZMod 6) (Ideal.span ({3} : Set (ZMod 6)))) = ⊤ ∧
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) =
      Ideal.span ({3} : Set (ZMod 6)) ∧
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) ≠ ⊤ := by
  let := three_idempotent.coalgebraSpan
  refine ⟨counit_range_smul_top (ZMod 6) (Ideal.span ({3} : Set (ZMod 6))), ?_, ?_⟩
  · rw [three_idempotent.coalgebraSpan_counit, Submodule.range_subtype]
  · rw [three_idempotent.coalgebraSpan_counit, Submodule.range_subtype,
      ne_eq, Ideal.span_singleton_eq_top]
    exact (ZMod.isUnit_iff_coprime 3 6).not.mpr (by decide)

example :
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) ≠ ⊤ ∧
    ¬ Module.Free (ZMod 6) (Ideal.span ({3} : Set (ZMod 6))) := by
  have hrange :
      (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) ≠ ⊤ := by
    rw [three_idempotent.coalgebraSpan_counit, Submodule.range_subtype,
      ne_eq, Ideal.span_singleton_eq_top]
    exact (ZMod.isUnit_iff_coprime 3 6).not.mpr (by decide)
  refine ⟨hrange, ?_⟩
  intro hfree
  let := hfree
  let := three_idempotent.coalgebraSpan
  have hthree : (Ideal.spanSingletonGenerator (3 : ZMod 6)) ≠ 0 := by
    intro h
    have h' : (3 : ZMod 6) = 0 := congrArg Subtype.val h
    exact (by decide : (3 : ZMod 6) ≠ 0) h'
  let := nontrivial_of_ne _ _ hthree
  exact hrange (counit_range_eq_top_of_free (ZMod 6) (Ideal.span ({3} : Set (ZMod 6))))

end ZMod

section Tensor

variable (R : Type u) [CommSemiring R]

/-- The tensor square of the scalar coalgebra has full counit range. -/
theorem CoalgebraTest.scalar_tensor_counit_range :
    (LinearMap.range (counit (R := R) (A := R ⊗[R] R)) : Ideal R) = ⊤ := by
  have hscalar : Function.Surjective (counit (R := R) (A := R)) :=
    fun r => ⟨r, CommSemiring.counit_apply R r⟩
  exact LinearMap.range_eq_top.mpr
    ((counit_surjective_tensorProduct_iff R R R).mpr ⟨hscalar, hscalar⟩)

/-- The tensor product of the empty diagonal coalgebra and the scalar coalgebra
has zero counit range and is subsingleton. -/
theorem CoalgebraTest.zero_left_tensor_counit_range :
    (LinearMap.range (counit (R := R) (A := (Fin 0 →₀ R) ⊗[R] R)) : Ideal R) = ⊥ ∧
    Subsingleton ((Fin 0 →₀ R) ⊗[R] R) := by
  have hzero : counit (R := R) (A := Fin 0 →₀ R) = 0 :=
    (counit_eq_zero_iff R (Fin 0 →₀ R)).mpr inferInstance
  have hrange :
      (LinearMap.range (counit (R := R) (A := (Fin 0 →₀ R) ⊗[R] R)) : Ideal R) = ⊥ := by
    rw [counit_range_tensorProduct, LinearMap.range_eq_bot.mpr hzero, Ideal.bot_mul]
  exact ⟨hrange, (counit_eq_zero_iff R _).mp (LinearMap.range_eq_bot.mp hrange)⟩

/-- Infinite diagonal coalgebras in independent universes have full tensor counit
range; a simple tensor at two distinct indices has counit six. -/
theorem CoalgebraTest.ulift_diagonal_tensor_counit_range :
    (LinearMap.range (counit (R := ℚ)
      (A := (ULift.{v} ℕ →₀ ℚ) ⊗[ℚ] (ULift.{w} ℕ →₀ ℚ))) : Ideal ℚ) = ⊤ ∧
    counit (R := ℚ)
      (Finsupp.single (ULift.up 0 : ULift.{v} ℕ) (2 : ℚ) ⊗ₜ[ℚ]
        Finsupp.single (ULift.up 1 : ULift.{w} ℕ) (3 : ℚ)) = 6 := by
  constructor
  · apply LinearMap.range_eq_top.mpr
    exact (counit_surjective_tensorProduct_iff ℚ
      (ULift.{v} ℕ →₀ ℚ) (ULift.{w} ℕ →₀ ℚ)).mpr
        ⟨counit_surjective_of_free ℚ _, counit_surjective_of_free ℚ _⟩
  · norm_num

section EmptyNaturalTensor

-- Use the same self-algebra and structural modules as the generic tensor API,
-- rather than alternate natural-number action dictionaries.
attribute [local instance 2000] Algebra.id Finsupp.module _root_.TensorProduct.leftModule

example : ¬ Function.Surjective
    (counit (R := ℕ) (A := (Fin 0 →₀ ℕ) ⊗[ℕ] ℕ)) := by
  rw [counit_surjective_tensorProduct_iff]
  rintro ⟨hzero, _⟩
  obtain ⟨x, hx⟩ := hzero 1
  have hε : counit (R := ℕ) (A := Fin 0 →₀ ℕ) = 0 :=
    (counit_eq_zero_iff ℕ (Fin 0 →₀ ℕ)).mpr inferInstance
  have hz : (0 : ℕ) = 1 := by
    simpa only [hε, LinearMap.zero_apply] using hx
  norm_num at hz

end EmptyNaturalTensor

example : Function.Surjective
    (counit (R := PUnit) (A := (Fin 0 →₀ PUnit) ⊗[PUnit] PUnit)) := by
  exact (counit_surjective_tensorProduct_iff PUnit (Fin 0 →₀ PUnit) PUnit).mpr
    ⟨fun r => ⟨0, Subsingleton.elim _ _⟩,
      fun r => ⟨r, CommSemiring.counit_apply PUnit r⟩⟩

end Tensor

namespace CoalgebraTest

private theorem four_idempotent : IsIdempotentElem (4 : ZMod 6) := by
  change (4 : ZMod 6) * 4 = 4
  decide

/-- The coalgebra on the ideal generated by three, with counit scalar inclusion. -/
noncomputable local instance spanThreeCoalgebra :
    Coalgebra (ZMod 6) (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))) :=
  (show IsIdempotentElem (3 : ZMod 6) from by
    change (3 : ZMod 6) * 3 = 3
    decide).coalgebraSpan

/-- The coalgebra on the ideal generated by four, with counit scalar inclusion. -/
noncomputable local instance spanFourCoalgebra :
    Coalgebra (ZMod 6) (Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6))) :=
  (show IsIdempotentElem (4 : ZMod 6) from by
    change (4 : ZMod 6) * 4 = 4
    decide).coalgebraSpan

private theorem span_three_counit_range :
    LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) =
        Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) := by
  rw [(three_idempotent).coalgebraSpan_counit, Submodule.range_subtype]

private theorem span_four_counit_range :
    LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6)))) =
        Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6)) := by
  rw [(four_idempotent).coalgebraSpan_counit, Submodule.range_subtype]

/-- The proper ideal coalgebra has finitely generated counit image, and three
acts identically on it. Its scalar action is not faithful, so identity action
of an idempotent alone cannot force the counit image to be the whole ring. -/
theorem span_three_identity_action_not_faithful :
    (∀ d : Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)), (3 : ZMod 6) • d = d) ∧
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)).FG ∧
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) ≠ ⊤ ∧
    ¬ FaithfulSMul (ZMod 6) (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))) := by
  have hfg : (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)).FG := by
    rw [span_three_counit_range]
    exact Submodule.fg_span_singleton _
  have hproper : (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) ≠ ⊤ := by
    rw [span_three_counit_range, ne_eq, Ideal.span_singleton_eq_top]
    exact (ZMod.isUnit_iff_coprime 3 6).not.mpr (by decide)
  refine ⟨three_idempotent.smul_span_singleton, hfg, hproper, ?_⟩
  intro hfaithful
  let := hfaithful
  exact hproper (counit_range_eq_top_of_faithfulSMul_of_fg (ZMod 6)
    (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))) hfg)

/-- The coalgebra on the ideal generated by three has proper nonzero counit image,
so its counit is not surjective and its underlying module is not faithfully flat. -/
theorem span_three_counit_not_surjective_not_faithfullyFlat :
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) ≠ ⊥ ∧
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) ≠ ⊤ ∧
    ¬ Function.Surjective (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) ∧
    ¬ Module.FaithfullyFlat (ZMod 6)
      (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))) := by
  have hproper :
      (LinearMap.range (counit (R := ZMod 6)
        (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) ≠ ⊤ := by
    rw [span_three_counit_range, ne_eq, Ideal.span_singleton_eq_top]
    exact (ZMod.isUnit_iff_coprime 3 6).not.mpr (by decide)
  have hnonsurj : ¬ Function.Surjective (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) :=
    fun h => hproper (LinearMap.range_eq_top.mpr h)
  refine ⟨?_, hproper, hnonsurj, ?_⟩
  · rw [span_three_counit_range, ne_eq, Ideal.span_singleton_eq_bot]
    decide
  · intro hFF
    let := hFF
    exact hnonsurj (counit_surjective_of_faithfullyFlat (ZMod 6)
      (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))))

/-- The coalgebra on the ideal generated by three in `ZMod 6` has flat underlying
module, but it is not faithfully flat and its counit has proper range and is not
surjective. -/
theorem span_three_flat_not_faithfullyFlat_counit :
    Module.Flat (ZMod 6) (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))) ∧
    ¬ Module.FaithfullyFlat (ZMod 6) (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))) ∧
    ¬ Function.Surjective CoalgebraExamples.zmod_six_three_idempotent.coalgebraSpan.counit ∧
    (LinearMap.range CoalgebraExamples.zmod_six_three_idempotent.coalgebraSpan.counit :
      Ideal (ZMod 6)) ≠ ⊤ := by
  let : Coalgebra (ZMod 6) (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))) :=
    CoalgebraExamples.zmod_six_three_idempotent.coalgebraSpan
  let : Module.Projective (ZMod 6) (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))) :=
    CoalgebraExamples.zmod_six_ideal_projective_not_free.1
  have h := span_three_counit_not_surjective_not_faithfullyFlat
  refine ⟨Module.Flat.of_projective, ?_, h.2.2.1, h.2.1⟩
  intro hFF
  exact h.2.1 ((faithfullyFlat_iff_flat_and_counit_range_eq_top (ZMod 6)
    (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))).mp hFF).2

/-- The two ideal coalgebras are nontrivial and have proper nonzero scalar support. -/
theorem orthogonal_ideal_factors_nontrivial_support :
    Nontrivial (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))) ∧
    Nontrivial (Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6))) ∧
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) ≠ ⊥ ∧
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) ≠ ⊤ ∧
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) ≠ ⊥ ∧
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) ≠ ⊤ := by
  rw [span_three_counit_range, span_four_counit_range]
  have h3 : Ideal.spanSingletonGenerator (3 : ZMod 6) ≠ 0 := by
    intro h
    exact (by decide : (3 : ZMod 6) ≠ 0) (congrArg Subtype.val h)
  have h4 : Ideal.spanSingletonGenerator (4 : ZMod 6) ≠ 0 := by
    intro h
    exact (by decide : (4 : ZMod 6) ≠ 0) (congrArg Subtype.val h)
  refine ⟨nontrivial_of_ne _ _ h3, nontrivial_of_ne _ _ h4, ?_, ?_, ?_, ?_⟩
  · rw [ne_eq, Ideal.span_singleton_eq_bot]
    decide
  · rw [ne_eq, Ideal.span_singleton_eq_top]
    exact (ZMod.isUnit_iff_coprime 3 6).not.mpr (by decide)
  · rw [ne_eq, Ideal.span_singleton_eq_bot]
    decide
  · rw [ne_eq, Ideal.span_singleton_eq_top]
    exact (ZMod.isUnit_iff_coprime 4 6).not.mpr (by decide)

/-- Orthogonal scalar supports give a subsingleton tensor coalgebra, although
both factors are nontrivial. -/
theorem orthogonal_ideal_tensor_subsingleton :
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) ⊗[ZMod 6]
        Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) = ⊥ ∧
    Subsingleton (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) ⊗[ZMod 6]
      Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6))) := by
  have hrange :
      (LinearMap.range (counit (R := ZMod 6)
        (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) ⊗[ZMod 6]
          Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) = ⊥ := by
    rw [counit_range_tensorProduct, span_three_counit_range, span_four_counit_range,
      Ideal.span_singleton_mul_span_singleton, show (3 : ZMod 6) * 4 = 0 by decide]
    simp
  exact ⟨hrange, (counit_eq_zero_iff (ZMod 6) _).mp (LinearMap.range_eq_bot.mp hrange)⟩

/-- The self-tensor of the ideal generated by three retains its proper nonzero
scalar support, and its generator tensor is nonzero. -/
theorem span_three_tensor_self_support :
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) ⊗[ZMod 6]
        Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) =
      Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) ∧
    Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) ≠ ⊥ ∧
    Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) ≠ ⊤ ∧
    Ideal.spanSingletonGenerator (3 : ZMod 6) ⊗ₜ[ZMod 6]
      Ideal.spanSingletonGenerator (3 : ZMod 6) ≠ 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [counit_range_tensorProduct, counit_range_mul_self,
      span_three_counit_range]
  · rw [ne_eq, Ideal.span_singleton_eq_bot]
    decide
  · rw [ne_eq, Ideal.span_singleton_eq_top]
    exact (ZMod.isUnit_iff_coprime 3 6).not.mpr (by decide)
  · intro h
    have hc := congrArg (counit (R := ZMod 6)) h
    have h33 : (3 : ZMod 6) * 3 = 3 := by decide
    have hz : (3 : ZMod 6) = 0 := by
      simpa [spanThreeCoalgebra, (three_idempotent).coalgebraSpan_counit_apply, h33] using hc
    exact (by decide : (3 : ZMod 6) ≠ 0) hz

section NaturalIdeals

-- Keep the ideal and tensor modules aligned with the generic stock tensor API.
attribute [local instance 2000] Algebra.id Submodule.module _root_.TensorProduct.leftModule

/-- Chosen structure maps on `(2)`: zero comultiplication and scalar inclusion.
No coalgebra identities are asserted. -/
noncomputable local instance spanTwoNatCoalgebraStruct :
    CoalgebraStruct ℕ (Ideal.span ({2} : Set ℕ)) where
  comul := 0
  counit := (Ideal.span ({2} : Set ℕ)).subtype

/-- Chosen structure maps on `(3)`: zero comultiplication and scalar inclusion.
No coalgebra identities are asserted. -/
noncomputable local instance spanThreeNatCoalgebraStruct :
    CoalgebraStruct ℕ (Ideal.span ({3} : Set ℕ)) where
  comul := 0
  counit := (Ideal.span ({3} : Set ℕ)).subtype

/-- With zero comultiplication and inclusion counits on the natural-number ideals
`(2)` and `(3)`, the tensor counit has image `(6)` and is not surjective. -/
theorem natural_ideal_tensor_counit_range :
    (LinearMap.range (counit (R := ℕ)
      (A := Ideal.span ({2} : Set ℕ) ⊗[ℕ] Ideal.span ({3} : Set ℕ))) : Ideal ℕ) =
        Ideal.span ({6} : Set ℕ) ∧
    ¬ Function.Surjective (counit (R := ℕ)
      (A := Ideal.span ({2} : Set ℕ) ⊗[ℕ] Ideal.span ({3} : Set ℕ))) := by
  have htwo : LinearMap.range (counit (R := ℕ)
      (A := Ideal.span ({2} : Set ℕ))) = Ideal.span ({2} : Set ℕ) :=
    Submodule.range_subtype _
  have hthree : LinearMap.range (counit (R := ℕ)
      (A := Ideal.span ({3} : Set ℕ))) = Ideal.span ({3} : Set ℕ) :=
    Submodule.range_subtype _
  constructor
  · rw [counit_range_tensorProduct, htwo, hthree,
      Ideal.span_singleton_mul_span_singleton]
    norm_num
  · rw [counit_surjective_tensorProduct_iff]
    rintro ⟨hsurj, _⟩
    have htop : Ideal.span ({2} : Set ℕ) = ⊤ :=
      htwo.symm.trans (LinearMap.range_eq_top.mpr hsurj)
    have hone : (1 : ℕ) ∈ Ideal.span ({2} : Set ℕ) := by
      rw [htop]
      exact Submodule.mem_top
    have hdiv : (2 : ℕ) ∣ 1 := Ideal.mem_span_singleton.mp hone
    norm_num at hdiv

/-- The chosen natural ideal structures have a nonzero generator tensor, but
zero comultiplication fails the left counit identity on the generator of `(2)`.
Thus these clients do not require a lawful coalgebra instance. -/
theorem natural_ideal_tensor_nonzero_and_law_failure :
    Ideal.spanSingletonGenerator (2 : ℕ) ⊗ₜ[ℕ]
      Ideal.spanSingletonGenerator (3 : ℕ) ≠ 0 ∧
    _root_.TensorProduct.lid ℕ (Ideal.span ({2} : Set ℕ))
      ((counit (R := ℕ) (A := Ideal.span ({2} : Set ℕ))).rTensor
        (Ideal.span ({2} : Set ℕ)) (comul (Ideal.spanSingletonGenerator (2 : ℕ)))) ≠
      Ideal.spanSingletonGenerator (2 : ℕ) := by
  constructor
  · intro h
    have hc := congrArg (counit (R := ℕ)
      (A := Ideal.span ({2} : Set ℕ) ⊗[ℕ] Ideal.span ({3} : Set ℕ))) h
    rw [_root_.TensorProduct.counit_tmul, map_zero] at hc
    change (3 : ℕ) * 2 = 0 at hc
    norm_num at hc
  · have hcomul : comul (R := ℕ) (Ideal.spanSingletonGenerator (2 : ℕ)) = 0 := rfl
    rw [hcomul, map_zero, map_zero]
    intro h
    have hz : (0 : ℕ) = 2 := congrArg Subtype.val h
    norm_num at hz

end NaturalIdeals

