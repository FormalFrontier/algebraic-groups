variable {R : Type u} [CommSemiring R]

example :
    (LinearMap.range (IsIdempotentElem.one : IsIdempotentElem (1 : R)).coalgebraSpan.counit :
      Ideal R) = ⊤ ∧
    (LinearMap.range (IsIdempotentElem.one : IsIdempotentElem (1 : R)).coalgebraSpan.counit :
      Ideal R) *
      LinearMap.range (IsIdempotentElem.one : IsIdempotentElem (1 : R)).coalgebraSpan.counit =
      ⊤ := by
