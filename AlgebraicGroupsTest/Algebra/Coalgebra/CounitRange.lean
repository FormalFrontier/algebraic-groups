module

public import AlgebraicGroups.Algebra.Coalgebra.CounitRange
public import AlgebraicGroups.Algebra.Coalgebra.IdempotentIdeal
public import Mathlib.Algebra.Module.LinearMap.DivisionRing
public import Mathlib.Algebra.Ring.PUnit
public import Mathlib.Data.ZMod.Basic
public import Mathlib.LinearAlgebra.Basis.VectorSpace
public import Mathlib.LinearAlgebra.Finsupp.VectorSpace
public import Mathlib.RingTheory.Finiteness.Cardinality
public import Mathlib.Tactic.NormNum

/-!
# Counit ranges of idempotent principal ideal coalgebras

The coalgebras on the ideals generated by zero and one have counit ranges
zero and the whole scalar semiring. Over `ZMod 6`, the coalgebra on the ideal
generated by three has a proper nonzero counit range. The generic counit
range theorem identifies the squares of all three ranges. The counit range
acts on the whole coalgebra with image the whole coalgebra, for the scalar
coalgebra, the zero ideal coalgebra, and the proper ideal coalgebra over `ZMod 6`.

A coalgebra on `ℕ →₀ ℕ` illustrates counit surjectivity for an infinite free module
over a semiring. For vector spaces the conclusion agrees with Mathlib's criterion
that a linear functional is surjective exactly when it is nonzero. The free zero
module over `ℕ` shows why nontriviality is required, and the proper nonzero ideal
coalgebra over `ZMod 6` shows why freeness cannot be omitted.

The faithful-action criterion applies to the scalar coalgebra over a ring and
the empty diagonal coalgebra over the trivial ring. The infinite free coalgebra
`ℕ →₀ ℚ` has a finitely generated counit image but is not a finite module. The
ideal generated by three in `ZMod 6` has finitely generated proper counit image
and an idempotent acting identically, but its scalar action is not faithful.

Tensor products multiply the scalar supports. The ideals generated by three and
four over `ZMod 6` are nontrivial coalgebras with proper nonzero supports, but
their tensor product is subsingleton because those supports are orthogonal.
Tensoring the ideal generated by three with itself retains its proper nonzero
support. Scalar, zero and infinite diagonal coalgebras also illustrate the formula.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe u v w

open Coalgebra
open scoped TensorProduct

section Scalar

variable {R : Type u} [CommSemiring R]

example :
    (LinearMap.range (counit (R := R) (A := R)) : Ideal R) = ⊤ ∧
    (LinearMap.range (counit (R := R) (A := R)) : Ideal R) •
      (⊤ : Submodule R R) = ⊤ := by
  refine ⟨?_, counit_range_smul_top R R⟩
  apply top_unique
  intro r _
  exact ⟨r, CommSemiring.counit_apply R r⟩

end Scalar

section Free

/-- The counit on the infinite free coalgebra `ℕ →₀ ℕ` has full range and takes
value seven on some element. -/
theorem CoalgebraTest.natural_finsupp_counit_range :
    (LinearMap.range (counit (R := ℕ) (A := ℕ →₀ ℕ)) : Ideal ℕ) = ⊤ ∧
    ∃ c : ℕ →₀ ℕ, counit (R := ℕ) c = 7 := by
  refine ⟨by simp, ?_⟩
  exact counit_surjective_of_free ℕ (ℕ →₀ ℕ) 7

variable (K : Type u) (C : Type v)
variable [Field K] [AddCommGroup C] [Module K C] [Coalgebra K C] [Nontrivial C]

example : Function.Surjective (counit (R := K) (A := C)) ∧
    counit (R := K) (A := C) ≠ 0 := by
  have h := counit_surjective_of_free K C
  exact ⟨h, LinearMap.surjective_iff_ne_zero.mp h⟩

example :
    Module.Free ℕ (Fin 0 →₀ ℕ) ∧
    (LinearMap.range (counit (R := ℕ) (A := Fin 0 →₀ ℕ)) : Ideal ℕ) = ⊥ ∧
    (LinearMap.range (counit (R := ℕ) (A := Fin 0 →₀ ℕ)) : Ideal ℕ) ≠ ⊤ := by
  have hrange :
      (LinearMap.range (counit (R := ℕ) (A := Fin 0 →₀ ℕ)) : Ideal ℕ) = ⊥ := by
    apply LinearMap.range_eq_bot.mpr
    apply LinearMap.ext
    intro x
    have hx : x = 0 := Subsingleton.elim _ _
    simp [hx]
  exact ⟨inferInstance, hrange, by rw [hrange]; exact bot_ne_top⟩

end Free

section Faithful

variable (R : Type u) [CommRing R]

example : Function.Surjective (counit (R := R) (A := R)) :=
  counit_surjective_of_faithfulSMul_of_fg R R (Submodule.fg_range _)

example : Function.Surjective (counit (R := ZMod 6) (A := ZMod 6)) :=
  counit_surjective_of_faithfulSMul_of_fg (ZMod 6) (ZMod 6) (Submodule.fg_range _)

example :
    (LinearMap.range (counit (R := PUnit) (A := Fin 0 →₀ PUnit)) : Ideal PUnit) = ⊥ ∧
    Function.Surjective (counit (R := PUnit) (A := Fin 0 →₀ PUnit)) := by
  have hrange :
      (LinearMap.range (counit (R := PUnit) (A := Fin 0 →₀ PUnit)) : Ideal PUnit) = ⊥ :=
    LinearMap.range_eq_bot.mpr
      ((counit_eq_zero_iff PUnit (Fin 0 →₀ PUnit)).mpr inferInstance)
  refine ⟨hrange, counit_surjective_of_faithfulSMul_of_fg PUnit (Fin 0 →₀ PUnit) ?_⟩
  exact (fun I : Ideal PUnit => show I.FG from
    (Submodule.eq_bot_of_subsingleton (p := I)).symm ▸ Submodule.fg_bot) _

/-- The faithful-action criterion needs finite generation only of the image ideal:
the infinite diagonal coalgebra over the rationals has unit counit image and
an element with counit seven, but its underlying module is not finite. -/
theorem CoalgebraTest.rational_finsupp_faithful_fg_counit :
    (LinearMap.range (counit (R := ℚ) (A := ℕ →₀ ℚ)) : Ideal ℚ).FG ∧
    ¬ Module.Finite ℚ (ℕ →₀ ℚ) ∧
    (LinearMap.range (counit (R := ℚ) (A := ℕ →₀ ℚ)) : Ideal ℚ) = ⊤ ∧
    ∃ c : ℕ →₀ ℚ, counit (R := ℚ) c = 7 := by
  have hfg : (LinearMap.range (counit (R := ℚ) (A := ℕ →₀ ℚ)) : Ideal ℚ).FG := by
    rw [counit_range_eq_top_of_free]
    exact Ideal.fg_top ℚ
  refine ⟨hfg, Module.not_finite_of_infinite_basis
    (Finsupp.basisSingleOne : Module.Basis ℕ ℚ (ℕ →₀ ℚ)),
    counit_range_eq_top_of_faithfulSMul_of_fg ℚ (ℕ →₀ ℚ) hfg, ?_⟩
  exact counit_surjective_of_faithfulSMul_of_fg ℚ (ℕ →₀ ℚ) hfg 7

end Faithful

section Zero

variable {R : Type u} [CommSemiring R]

example :
    (LinearMap.range (IsIdempotentElem.zero : IsIdempotentElem (0 : R)).coalgebraSpan.counit :
      Ideal R) = ⊥ ∧
    (LinearMap.range (IsIdempotentElem.zero : IsIdempotentElem (0 : R)).coalgebraSpan.counit :
      Ideal R) *
      LinearMap.range (IsIdempotentElem.zero : IsIdempotentElem (0 : R)).coalgebraSpan.counit =
      ⊥ := by
  let he : IsIdempotentElem (0 : R) := IsIdempotentElem.zero
  let := he.coalgebraSpan
  have hrange : (LinearMap.range he.coalgebraSpan.counit : Ideal R) = ⊥ := by
    rw [he.coalgebraSpan_counit, Submodule.range_subtype]
    simp
  exact ⟨hrange, (counit_range_mul_self R (Ideal.span ({0} : Set R))).trans hrange⟩

example :
    (LinearMap.range (IsIdempotentElem.zero : IsIdempotentElem (0 : R)).coalgebraSpan.counit :
      Ideal R) • (⊤ : Submodule R (Ideal.span ({0} : Set R))) = ⊤ ∧
    (LinearMap.range (IsIdempotentElem.zero : IsIdempotentElem (0 : R)).coalgebraSpan.counit :
      Ideal R) = ⊥ := by
  let he : IsIdempotentElem (0 : R) := IsIdempotentElem.zero
  let := he.coalgebraSpan
  refine ⟨counit_range_smul_top R (Ideal.span ({0} : Set R)), ?_⟩
  rw [he.coalgebraSpan_counit, Submodule.range_subtype]
  simp

end Zero

