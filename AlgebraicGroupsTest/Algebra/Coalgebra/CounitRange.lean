end One

section ZMod

private theorem three_idempotent : IsIdempotentElem (3 : ZMod 6) := by
  change (3 : ZMod 6) * 3 = 3
  decide

example :
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) =
      Ideal.span ({3} : Set (ZMod 6)) ∧
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) *
      LinearMap.range three_idempotent.coalgebraSpan.counit =
      Ideal.span ({3} : Set (ZMod 6)) := by
  let := three_idempotent.coalgebraSpan
  have hrange : (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) =
      Ideal.span ({3} : Set (ZMod 6)) := by
    rw [three_idempotent.coalgebraSpan_counit, Submodule.range_subtype]
  exact ⟨hrange,
    (counit_range_mul_self (ZMod 6) (Ideal.span ({3} : Set (ZMod 6)))).trans hrange⟩

example :
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) ≠ ⊥ ∧
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) ≠ ⊤ := by
  rw [three_idempotent.coalgebraSpan_counit, Submodule.range_subtype]
  constructor
  · rw [ne_eq, Ideal.span_singleton_eq_bot]
    decide
  · rw [ne_eq, Ideal.span_singleton_eq_top]
    exact (ZMod.isUnit_iff_coprime 3 6).not.mpr (by decide)

example : (3 : ZMod 6) * 3 = 3 ∧
    (3 : ZMod 6) ∈
      (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) *
        LinearMap.range three_idempotent.coalgebraSpan.counit := by
  have hthree : (3 : ZMod 6) ∈ LinearMap.range three_idempotent.coalgebraSpan.counit :=
    ⟨Ideal.spanSingletonGenerator 3, three_idempotent.coalgebraSpan_counit_apply _⟩
  have hmul : (3 : ZMod 6) * 3 = 3 := by decide
  refine ⟨hmul, ?_⟩
  simpa only [hmul] using Ideal.mul_mem_mul hthree hthree

example :
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) •
      (⊤ : Submodule (ZMod 6) (Ideal.span ({3} : Set (ZMod 6)))) = ⊤ ∧
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) =
      Ideal.span ({3} : Set (ZMod 6)) ∧
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) ≠ ⊤ := by
  let := three_idempotent.coalgebraSpan
  refine ⟨counit_range_smul_top (ZMod 6) (Ideal.span ({3} : Set (ZMod 6))), ?_, ?_⟩
  · rw [three_idempotent.coalgebraSpan_counit, Submodule.range_subtype]
  · rw [three_idempotent.coalgebraSpan_counit, Submodule.range_subtype,
      ne_eq, Ideal.span_singleton_eq_top]
    exact (ZMod.isUnit_iff_coprime 3 6).not.mpr (by decide)

example :
    (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) ≠ ⊤ ∧
    ¬ Module.Free (ZMod 6) (Ideal.span ({3} : Set (ZMod 6))) := by
  have hrange :
      (LinearMap.range three_idempotent.coalgebraSpan.counit : Ideal (ZMod 6)) ≠ ⊤ := by
    rw [three_idempotent.coalgebraSpan_counit, Submodule.range_subtype,
      ne_eq, Ideal.span_singleton_eq_top]
    exact (ZMod.isUnit_iff_coprime 3 6).not.mpr (by decide)
  refine ⟨hrange, ?_⟩
  intro hfree
  let := hfree
  let := three_idempotent.coalgebraSpan
  have hthree : (Ideal.spanSingletonGenerator (3 : ZMod 6)) ≠ 0 := by
    intro h
    have h' : (3 : ZMod 6) = 0 := congrArg Subtype.val h
    exact (by decide : (3 : ZMod 6) ≠ 0) h'
  let := nontrivial_of_ne _ _ hthree
  exact hrange (counit_range_eq_top_of_free (ZMod 6) (Ideal.span ({3} : Set (ZMod 6))))

end ZMod

section Tensor

variable (R : Type u) [CommSemiring R]

/-- The tensor square of the scalar coalgebra has full counit range. -/
theorem CoalgebraTest.scalar_tensor_counit_range :
    (LinearMap.range (counit (R := R) (A := R ⊗[R] R)) : Ideal R) = ⊤ := by
  have hscalar : LinearMap.range (counit (R := R) (A := R)) = ⊤ := by
    apply LinearMap.range_eq_top.mpr
    exact fun r => ⟨r, CommSemiring.counit_apply R r⟩
  rw [counit_range_tensorProduct, hscalar, Ideal.top_mul]

/-- The tensor product of the empty diagonal coalgebra and the scalar coalgebra
has zero counit range and is subsingleton. -/
theorem CoalgebraTest.zero_left_tensor_counit_range :
    (LinearMap.range (counit (R := R) (A := (Fin 0 →₀ R) ⊗[R] R)) : Ideal R) = ⊥ ∧
    Subsingleton ((Fin 0 →₀ R) ⊗[R] R) := by
  have hzero : counit (R := R) (A := Fin 0 →₀ R) = 0 :=
    (counit_eq_zero_iff R (Fin 0 →₀ R)).mpr inferInstance
  have hrange :
      (LinearMap.range (counit (R := R) (A := (Fin 0 →₀ R) ⊗[R] R)) : Ideal R) = ⊥ := by
    rw [counit_range_tensorProduct, LinearMap.range_eq_bot.mpr hzero, Ideal.bot_mul]
  exact ⟨hrange, (counit_eq_zero_iff R _).mp (LinearMap.range_eq_bot.mp hrange)⟩

/-- Infinite diagonal coalgebras in independent universes have full tensor counit
range; a simple tensor at two distinct indices has counit six. -/
theorem CoalgebraTest.ulift_diagonal_tensor_counit_range :
    (LinearMap.range (counit (R := ℚ)
      (A := (ULift.{v} ℕ →₀ ℚ) ⊗[ℚ] (ULift.{w} ℕ →₀ ℚ))) : Ideal ℚ) = ⊤ ∧
    counit (R := ℚ)
      (Finsupp.single (ULift.up 0 : ULift.{v} ℕ) (2 : ℚ) ⊗ₜ[ℚ]
        Finsupp.single (ULift.up 1 : ULift.{w} ℕ) (3 : ℚ)) = 6 := by
  constructor
  · rw [counit_range_tensorProduct]
    simp
  · norm_num

end Tensor

namespace CoalgebraTest

private theorem four_idempotent : IsIdempotentElem (4 : ZMod 6) := by
  change (4 : ZMod 6) * 4 = 4
  decide

/-- The coalgebra on the ideal generated by three, with counit scalar inclusion. -/
noncomputable local instance spanThreeCoalgebra :
    Coalgebra (ZMod 6) (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))) :=
  (show IsIdempotentElem (3 : ZMod 6) from by
    change (3 : ZMod 6) * 3 = 3
    decide).coalgebraSpan

/-- The coalgebra on the ideal generated by four, with counit scalar inclusion. -/
noncomputable local instance spanFourCoalgebra :
    Coalgebra (ZMod 6) (Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6))) :=
  (show IsIdempotentElem (4 : ZMod 6) from by
    change (4 : ZMod 6) * 4 = 4
    decide).coalgebraSpan

private theorem span_three_counit_range :
    LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) =
        Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) := by
  rw [(three_idempotent).coalgebraSpan_counit, Submodule.range_subtype]

private theorem span_four_counit_range :
    LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6)))) =
        Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6)) := by
  rw [(four_idempotent).coalgebraSpan_counit, Submodule.range_subtype]

/-- The proper ideal coalgebra has finitely generated counit image, and three
acts identically on it. Its scalar action is not faithful, so identity action
of an idempotent alone cannot force the counit image to be the whole ring. -/
theorem span_three_identity_action_not_faithful :
    (∀ d : Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)), (3 : ZMod 6) • d = d) ∧
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)).FG ∧
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) ≠ ⊤ ∧
    ¬ FaithfulSMul (ZMod 6) (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))) := by
  have hfg : (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)).FG := by
    rw [span_three_counit_range]
    exact Submodule.fg_span_singleton _
  have hproper : (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) ≠ ⊤ := by
    rw [span_three_counit_range, ne_eq, Ideal.span_singleton_eq_top]
    exact (ZMod.isUnit_iff_coprime 3 6).not.mpr (by decide)
  refine ⟨three_idempotent.smul_span_singleton, hfg, hproper, ?_⟩
  intro hfaithful
  let := hfaithful
  exact hproper (counit_range_eq_top_of_faithfulSMul_of_fg (ZMod 6)
    (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))) hfg)

/-- The two ideal coalgebras are nontrivial and have proper nonzero scalar support. -/
theorem orthogonal_ideal_factors_nontrivial_support :
    Nontrivial (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6))) ∧
    Nontrivial (Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6))) ∧
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) ≠ ⊥ ∧
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) ≠ ⊤ ∧
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) ≠ ⊥ ∧
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) ≠ ⊤ := by
  rw [span_three_counit_range, span_four_counit_range]
  have h3 : Ideal.spanSingletonGenerator (3 : ZMod 6) ≠ 0 := by
    intro h
    exact (by decide : (3 : ZMod 6) ≠ 0) (congrArg Subtype.val h)
  have h4 : Ideal.spanSingletonGenerator (4 : ZMod 6) ≠ 0 := by
    intro h
    exact (by decide : (4 : ZMod 6) ≠ 0) (congrArg Subtype.val h)
  refine ⟨nontrivial_of_ne _ _ h3, nontrivial_of_ne _ _ h4, ?_, ?_, ?_, ?_⟩
  · rw [ne_eq, Ideal.span_singleton_eq_bot]
    decide
  · rw [ne_eq, Ideal.span_singleton_eq_top]
    exact (ZMod.isUnit_iff_coprime 3 6).not.mpr (by decide)
  · rw [ne_eq, Ideal.span_singleton_eq_bot]
    decide
  · rw [ne_eq, Ideal.span_singleton_eq_top]
    exact (ZMod.isUnit_iff_coprime 4 6).not.mpr (by decide)

/-- Orthogonal scalar supports give a subsingleton tensor coalgebra, although
both factors are nontrivial. -/
theorem orthogonal_ideal_tensor_subsingleton :
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) ⊗[ZMod 6]
        Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) = ⊥ ∧
    Subsingleton (Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) ⊗[ZMod 6]
      Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6))) := by
  have hrange :
      (LinearMap.range (counit (R := ZMod 6)
        (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) ⊗[ZMod 6]
          Ideal.span ({(4 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) = ⊥ := by
    rw [counit_range_tensorProduct, span_three_counit_range, span_four_counit_range,
      Ideal.span_singleton_mul_span_singleton, show (3 : ZMod 6) * 4 = 0 by decide]
    simp
  exact ⟨hrange, (counit_eq_zero_iff (ZMod 6) _).mp (LinearMap.range_eq_bot.mp hrange)⟩

/-- The self-tensor of the ideal generated by three retains its proper nonzero
scalar support, and its generator tensor is nonzero. -/
theorem span_three_tensor_self_support :
    (LinearMap.range (counit (R := ZMod 6)
      (A := Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) ⊗[ZMod 6]
        Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)))) : Ideal (ZMod 6)) =
      Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) ∧
    Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) ≠ ⊥ ∧
    Ideal.span ({(3 : ZMod 6)} : Set (ZMod 6)) ≠ ⊤ ∧
    Ideal.spanSingletonGenerator (3 : ZMod 6) ⊗ₜ[ZMod 6]
      Ideal.spanSingletonGenerator (3 : ZMod 6) ≠ 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [counit_range_tensorProduct, counit_range_mul_self,
      span_three_counit_range]
  · rw [ne_eq, Ideal.span_singleton_eq_bot]
    decide
  · rw [ne_eq, Ideal.span_singleton_eq_top]
    exact (ZMod.isUnit_iff_coprime 3 6).not.mpr (by decide)
  · intro h
    have hc := congrArg (counit (R := ZMod 6)) h
    have h33 : (3 : ZMod 6) * 3 = 3 := by decide
    have hz : (3 : ZMod 6) = 0 := by
      simpa [spanThreeCoalgebra, (three_idempotent).coalgebraSpan_counit_apply, h33] using hc
    exact (by decide : (3 : ZMod 6) ≠ 0) hz

end CoalgebraTest
