module

import AlgebraicGroups.Algebra.Frobenius.HopfSubalgebra
import AlgebraicGroups.Algebra.HopfAlgebra.Subalgebra.Construction

/-!
# The Hopf subalgebra generated by powers

Over a field, the closure theorem supplies the existing Hopf-algebra factory.
Its inherited algebra and module are those of the subalgebra, its antipode
restricts the ambient antipode, and its bialgebra inclusion retains the original
subalgebra inclusion as an algebra homomorphism.
-/

universe u v

example {K : Type u} {A : Type v}
    [Field K] [CommRing A] [HopfAlgebra K A]
    (p n : Nat) [Fact p.Prime] [CharP K p] :
    let S := Algebra.adjoin K (Set.range (fun a : A => a ^ (p ^ n)))
    let hS : S.IsHopfSubalgebra :=
      HopfAlgebra.isHopfSubalgebra_adjoin_pow (R := K) (A := A) p n
    (S.hopfAlgebra hS).toHopfAlgebraStruct.toBialgebra.toAlgebra =
      @Subalgebra.algebra K A _ _ _ S ∧
    @Algebra.toModule K S _ _
        (S.hopfAlgebra hS).toHopfAlgebraStruct.toBialgebra.toAlgebra =
      @Algebra.toModule K S _ _ (@Subalgebra.algebra K A _ _ _ S) ∧
    (∀ s : S,
      ((@HopfAlgebraStruct.antipode K S _ _
        (S.hopfAlgebra hS).toHopfAlgebraStruct) s : A) =
        HopfAlgebraStruct.antipode K (s : A)) ∧
    @BialgHom.toAlgHom K S A _ _ _ _ _
        (S.hopfAlgebra hS).toHopfAlgebraStruct.toBialgebra.toCoalgebra.toCoalgebraStruct
        _ (S.inclusionBialgHom hS) = S.val := by
  let S : Subalgebra K A := Algebra.adjoin K (Set.range (fun a : A => a ^ (p ^ n)))
  let hS : S.IsHopfSubalgebra :=
    HopfAlgebra.isHopfSubalgebra_adjoin_pow (R := K) (A := A) p n
  exact ⟨S.hopfAlgebra_toAlgebra hS, S.hopfAlgebra_toModule hS,
    (fun s => S.hopfAlgebra_antipode hS s), S.inclusionBialgHom_toAlgHom hS⟩
